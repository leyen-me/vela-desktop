//@version=6
indicator("Special K", "Special K", overlay = false, format = format.price, precision = 1, max_labels_count = 500, max_lines_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR   = #089981
BEAR_COLOR   = #f23645
SIGNAL_COLOR = #ff9800 // the one accent: Pring's 100/100 smoothing
FAST_COLOR   = #5b9cf6 // 10-bar average for short-term pro-trend timing
ZERO_COLOR   = #787b86

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_HEADER = #808080
DASH_TEXT   = #DBDBDB

FULL_HISTORY = 725 // bars before the twelfth term (ROC 530 smoothed over 195) is formed

SK_GROUP     = "Special K"
PRIMARY_GROUP = "Primary Trend"
STYLE_GROUP  = "Style"
DASH_GROUP   = "Dashboard"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput = input.source(close, "Source", group = SK_GROUP
  , tooltip = "Series the twelve rates of change are measured on. The Special K is the published daily formulation: SMA(ROC(10),10)x1 + SMA(ROC(15),10)x2 + SMA(ROC(20),10)x3 + SMA(ROC(30),15)x4 + SMA(ROC(40),50)x1 + SMA(ROC(65),65)x2 + SMA(ROC(75),75)x3 + SMA(ROC(100),100)x4 + SMA(ROC(195),130)x1 + SMA(ROC(265),130)x2 + SMA(ROC(390),130)x3 + SMA(ROC(530),195)x4. It needs 725 bars of history before it is fully formed.")

signal1Input = input.int(100, "Signal Smoothing", minval = 1, inline = "signal", group = SK_GROUP)
signal2Input = input.int(100, "", minval = 1, inline = "signal", group = SK_GROUP
  , tooltip = "Pring's signal line: a 100-bar simple moving average of the Special K, smoothed again by a 100-bar simple moving average (the 100/100 smoothing). The Special K above it reads as a bullish primary trend, below it as bearish.")

fastLenInput = input.int(10, "Short-Term Average", minval = 1, group = SK_GROUP
  , tooltip = "Simple moving average of the Special K used for pro-trend short-term timing: a cross above it while the primary trend is bullish is a short-term buy, a cross below it while the primary trend is bearish a short-term sell.")

pivotLenInput = input.int(15, "Peak & Trough Length", minval = 2, maxval = 100, group = PRIMARY_GROUP
  , tooltip = "Bars on each side that confirm a Special K peak or trough. Peaks and troughs feed the rising/falling series read and anchor the trendlines drawn on the indicator; each is confirmed this many bars after it forms, so nothing repaints.")

confirmWindowInput = input.int(40, "Confirmation Window (bars)", minval = 1, maxval = 500, group = PRIMARY_GROUP
  , tooltip = "Pring notes that crossovers of the smoothing whipsaw and are more reliable combined with a trendline break. A primary reversal is tagged when a signal-line crossover and a trendline break or a peak/trough series reversal in the same direction both occur within this many bars, and the Special K stands on the new side of its signal line.")

majorSpanInput = input.int(190, "Major Trendline Span (bars)", minval = 10, group = PRIMARY_GROUP
  , tooltip = "Trendlines on the Special K whose anchors span at least this many bars are reported as major. Pring treats the violation of a trendline of nine months or more (about 190 daily bars) as usual evidence that the primary trend has reversed.")

showFastInput = input.bool(true, "Short-Term Average", inline = "fast", group = STYLE_GROUP)
fastColorInput = input.color(FAST_COLOR, "", inline = "fast", group = STYLE_GROUP)

showTrendlinesInput = input.bool(true, "Trendlines", group = STYLE_GROUP
  , tooltip = "Draw the support line through the last two rising troughs and the resistance line through the last two falling peaks of the Special K, and mark where each is broken.")

showShortTermInput = input.bool(true, "Short-Term Pro-Trend Signals", group = STYLE_GROUP
  , tooltip = "Dots on the Special K where it crosses its short-term average in the direction of the primary trend.")

showPrimaryInput = input.bool(true, "Primary Reversal Tags on Price", group = STYLE_GROUP
  , tooltip = "Tag confirmed primary trend reversals on the price chart.")

bullColorInput   = input.color(BULL_COLOR, "Bullish", inline = "colors", group = STYLE_GROUP)
bearColorInput   = input.color(BEAR_COLOR, "Bearish", inline = "colors", group = STYLE_GROUP)
signalColorInput = input.color(SIGNAL_COLOR, "Signal", inline = "colors", group = STYLE_GROUP)

showDashInput = input.bool(true, "Show Dashboard", group = DASH_GROUP)
dashPosInput  = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], inline = "dash", group = DASH_GROUP)
dashSizeInput = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], inline = "dash", group = DASH_GROUP)

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
getSize(string s) =>
    switch s
        "Tiny"  => size.tiny
        "Small" => size.small
        => size.normal

getPosition(string p) =>
    switch p
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

//One smoothed, weighted rate-of-change term
rcma(float src, int rocLen, int smaLen, int weight) =>
    weight * ta.sma(ta.roc(src, rocLen), smaLen)

//---------------------------------------------------------------------------------------------------------------------}
// Special K
//---------------------------------------------------------------------------------------------------------------------{
//Pring's published daily Special K: weighted SMA(ROC) terms, short-term, intermediate and long-term KST horizons
shortTerm = rcma(srcInput, 10, 10, 1) + rcma(srcInput, 15, 10, 2) + rcma(srcInput, 20, 10, 3) + rcma(srcInput, 30, 15, 4)
interTerm = rcma(srcInput, 40, 50, 1) + rcma(srcInput, 65, 65, 2) + rcma(srcInput, 75, 75, 3) + rcma(srcInput, 100, 100, 4)
longTerm  = rcma(srcInput, 195, 130, 1) + rcma(srcInput, 265, 130, 2) + rcma(srcInput, 390, 130, 3) + rcma(srcInput, 530, 195, 4)

specialK = shortTerm + interTerm + longTerm
signal   = ta.sma(ta.sma(specialK, signal1Input), signal2Input)
fastMa   = ta.sma(specialK, fastLenInput)

//---------------------------------------------------------------------------------------------------------------------}
// Primary Trend Evidence
//---------------------------------------------------------------------------------------------------------------------{
//1. Crossovers of the 100/100 smoothing
bullCross = ta.crossover(specialK, signal)
bearCross = ta.crossunder(specialK, signal)
primaryUp = not na(signal) and specialK > signal

//2. Peaks and troughs of the Special K, and the series they form
skPeak   = ta.pivothigh(specialK, pivotLenInput, pivotLenInput)
skTrough = ta.pivotlow(specialK, pivotLenInput, pivotLenInput)

var float lastPeak    = na
var float prevPeak    = na
var int   lastPeakX   = na
var int   prevPeakX   = na
var float lastTrough  = na
var float prevTrough  = na
var int   lastTroughX = na
var int   prevTroughX = na

if barstate.isconfirmed and not na(skPeak)
    prevPeak  := lastPeak
    prevPeakX := lastPeakX
    lastPeak  := skPeak
    lastPeakX := bar_index - pivotLenInput
if barstate.isconfirmed and not na(skTrough)
    prevTrough  := lastTrough
    prevTroughX := lastTroughX
    lastTrough  := skTrough
    lastTroughX := bar_index - pivotLenInput

risingSeries  = lastPeak > prevPeak and lastTrough > prevTrough
fallingSeries = lastPeak < prevPeak and lastTrough < prevTrough

//A rising series reverses when the Special K undercuts its last trough; a falling one when it clears its last peak
var bool seriesDownArmed = false
var bool seriesUpArmed   = false
if barstate.isconfirmed and (not na(skPeak) or not na(skTrough))
    seriesDownArmed := risingSeries
    seriesUpArmed   := fallingSeries

//Crossings computed on every bar, then gated (boolean operators evaluate lazily)
underTrough     = ta.crossunder(specialK, lastTrough)
overPeak        = ta.crossover(specialK, lastPeak)
seriesBreakDown = barstate.isconfirmed and seriesDownArmed and underTrough
seriesBreakUp   = barstate.isconfirmed and seriesUpArmed and overPeak
if seriesBreakDown
    seriesDownArmed := false
if seriesBreakUp
    seriesUpArmed := false

//3. Trendlines on the Special K: support through rising troughs, resistance through falling peaks
var line  supportLine  = na
var float supportSlope = na
var int   supportX     = na
var float supportY     = na
var int   supportSpan  = 0
var line  resistLine   = na
var float resistSlope  = na
var int   resistX      = na
var float resistY      = na
var int   resistSpan   = 0

if barstate.isconfirmed and not na(skTrough) and not na(prevTrough) and lastTrough > prevTrough
    supportSlope := (lastTrough - prevTrough) / (lastTroughX - prevTroughX)
    supportX     := prevTroughX
    supportY     := prevTrough
    supportSpan  := lastTroughX - prevTroughX
    if showTrendlinesInput
        supportLine := line.new(prevTroughX, prevTrough, bar_index, prevTrough + supportSlope * (bar_index - prevTroughX), color = color.new(bullColorInput, 20), width = 1)

if barstate.isconfirmed and not na(skPeak) and not na(prevPeak) and lastPeak < prevPeak
    resistSlope := (lastPeak - prevPeak) / (lastPeakX - prevPeakX)
    resistX     := prevPeakX
    resistY     := prevPeak
    resistSpan  := lastPeakX - prevPeakX
    if showTrendlinesInput
        resistLine := line.new(prevPeakX, prevPeak, bar_index, prevPeak + resistSlope * (bar_index - prevPeakX), color = color.new(bearColorInput, 20), width = 1)

supportLevel = na(supportSlope) ? na : supportY + supportSlope * (bar_index - supportX)
resistLevel  = na(resistSlope) ? na : resistY + resistSlope * (bar_index - resistX)

tlBreakDown = barstate.isconfirmed and not na(supportLevel) and specialK < supportLevel and specialK[1] >= supportLevel - supportSlope
tlBreakUp   = barstate.isconfirmed and not na(resistLevel) and specialK > resistLevel and specialK[1] <= resistLevel - resistSlope

if tlBreakDown
    if not na(supportLine)
        line.set_x2(supportLine, bar_index)
        line.set_y2(supportLine, supportLevel)
        line.set_style(supportLine, line.style_dashed)
        label.new(bar_index, supportLevel, "TL"
          , style = label.style_label_down, color = color.new(bearColorInput, 80), textcolor = bearColorInput, size = size.tiny
          , tooltip = "Special K broke its rising trendline (anchors " + str.tostring(supportSpan) + " bars apart" + (supportSpan >= majorSpanInput ? ", a major line" : "") + ")")
    supportLine  := line(na)
    supportSlope := na
else if not na(supportLine)
    line.set_x2(supportLine, bar_index)
    line.set_y2(supportLine, supportLevel)

if tlBreakUp
    if not na(resistLine)
        line.set_x2(resistLine, bar_index)
        line.set_y2(resistLine, resistLevel)
        line.set_style(resistLine, line.style_dashed)
        label.new(bar_index, resistLevel, "TL"
          , style = label.style_label_up, color = color.new(bullColorInput, 80), textcolor = bullColorInput, size = size.tiny
          , tooltip = "Special K broke its falling trendline (anchors " + str.tostring(resistSpan) + " bars apart" + (resistSpan >= majorSpanInput ? ", a major line" : "") + ")")
    resistLine  := line(na)
    resistSlope := na
else if not na(resistLine)
    line.set_x2(resistLine, bar_index)
    line.set_y2(resistLine, resistLevel)

//---------------------------------------------------------------------------------------------------------------------}
// Confirmed Primary Reversals & Short-Term Timing
//---------------------------------------------------------------------------------------------------------------------{
structureUp   = tlBreakUp or seriesBreakUp
structureDown = tlBreakDown or seriesBreakDown

sinceBullCross = ta.barssince(bullCross)
sinceBearCross = ta.barssince(bearCross)
sinceStructUp  = ta.barssince(structureUp)
sinceStructDn  = ta.barssince(structureDown)
sinceTlUp      = ta.barssince(tlBreakUp)
sinceTlDown    = ta.barssince(tlBreakDown)

var int confirmed = 0
bool primaryBull = false
bool primaryBear = false

//Both kinds of evidence inside the window, the Special K on the new side of its smoothing
if barstate.isconfirmed and primaryUp and confirmed != 1 and nz(sinceBullCross, 9999) <= confirmWindowInput and nz(sinceStructUp, 9999) <= confirmWindowInput and (bullCross or structureUp)
    confirmed   := 1
    primaryBull := true
if barstate.isconfirmed and not primaryUp and not na(signal) and confirmed != -1 and nz(sinceBearCross, 9999) <= confirmWindowInput and nz(sinceStructDn, 9999) <= confirmWindowInput and (bearCross or structureDown)
    confirmed   := -1
    primaryBear := true

//Short-term pro-trend timing, as in Pring's scan: the 10-bar average crossed in the direction of the primary trend
crossUpFast = ta.crossover(specialK, fastMa)
crossDnFast = ta.crossunder(specialK, fastMa)
shortBuy    = primaryUp and crossUpFast
shortSell   = not primaryUp and not na(signal) and crossDnFast

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
stateColor = primaryUp ? bullColorInput : bearColorInput

skPlot  = plot(specialK, "Special K", stateColor, 2)
sigPlot = plot(signal, "Signal (100/100)", signalColorInput, 2)
plot(showFastInput ? fastMa : na, "Short-Term Average", color.new(fastColorInput, 30), 1)
hline(0, "Zero", color.new(ZERO_COLOR, 40), hline.style_dashed)

//Gradient between the Special K and its smoothing: the primary trend at a glance
fill(skPlot, sigPlot, math.max(specialK, signal), math.min(specialK, signal)
  , primaryUp ? color.new(stateColor, 50) : color.new(stateColor, 95)
  , primaryUp ? color.new(stateColor, 95) : color.new(stateColor, 50)
  , title = "Primary Trend Fill")

plot(showShortTermInput and shortBuy ? specialK : na, "Short-Term Buy", bullColorInput, 4, plot.style_circles)
plot(showShortTermInput and shortSell ? specialK : na, "Short-Term Sell", bearColorInput, 4, plot.style_circles)

if showPrimaryInput and (primaryBull or primaryBear)
    bool   viaLine = primaryBull ? nz(sinceTlUp, 9999) <= confirmWindowInput : nz(sinceTlDown, 9999) <= confirmWindowInput
    string why = "Special K crossed " + (primaryBull ? "above" : "below") + " its 100/100 smoothing and "
      + (viaLine ? "broke its " + (primaryBull ? "falling" : "rising") + " trendline" : "reversed its " + (primaryBull ? "falling" : "rising") + " series of peaks and troughs")
    label.new(bar_index, primaryBull ? low : high, primaryBull ? "Primary Bull" : "Primary Bear"
      , style         = primaryBull ? label.style_label_up : label.style_label_down
      , color         = primaryBull ? bullColorInput : bearColorInput
      , textcolor     = color.white
      , size          = size.small
      , tooltip       = why + " within " + str.tostring(confirmWindowInput) + " bars: crossover and structure agree, Pring's combined confirmation of a primary trend reversal"
      , force_overlay = true)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
var table dash = na

if barstate.islast and showDashInput
    if na(dash)
        dash := table.new(getPosition(dashPosInput), 2, 5, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)
    ts = getSize(dashSizeInput)
    bool   formed      = bar_index >= FULL_HISTORY
    string primaryText = na(signal) ? "Forming" : (primaryUp ? "Bullish" : "Bearish") + ", " + str.tostring(primaryUp ? nz(sinceBullCross) : nz(sinceBearCross)) + " bars"
    string confText    = confirmed == 1 ? "Bull confirmed" : confirmed == -1 ? "Bear confirmed" : "None yet"
    string seriesText  = risingSeries ? "Rising" : fallingSeries ? "Falling" : "Mixed"
    string stText      = na(fastMa) ? "-" : specialK > fastMa ? "Above 10-bar avg" : "Below 10-bar avg"
    table.cell(dash, 0, 0, "Primary Trend", text_color = DASH_HEADER, text_size = ts, text_halign = text.align_left)
    table.cell(dash, 1, 0, primaryText, text_color = na(signal) ? DASH_TEXT : stateColor, text_size = ts, text_halign = text.align_right)
    table.cell(dash, 0, 1, "Last Confirmed", text_color = DASH_HEADER, text_size = ts, text_halign = text.align_left)
    table.cell(dash, 1, 1, confText, text_color = confirmed == 1 ? bullColorInput : confirmed == -1 ? bearColorInput : DASH_TEXT, text_size = ts, text_halign = text.align_right)
    table.cell(dash, 0, 2, "Peaks & Troughs", text_color = DASH_HEADER, text_size = ts, text_halign = text.align_left)
    table.cell(dash, 1, 2, seriesText, text_color = risingSeries ? bullColorInput : fallingSeries ? bearColorInput : DASH_TEXT, text_size = ts, text_halign = text.align_right)
    table.cell(dash, 0, 3, "Short Term", text_color = DASH_HEADER, text_size = ts, text_halign = text.align_left)
    table.cell(dash, 1, 3, stText, text_color = DASH_TEXT, text_size = ts, text_halign = text.align_right)
    table.cell(dash, 0, 4, "History", text_color = DASH_HEADER, text_size = ts, text_halign = text.align_left)
    table.cell(dash, 1, 4, formed ? "Fully formed" : str.tostring(bar_index + 1) + " of " + str.tostring(FULL_HISTORY) + " bars", text_color = formed ? DASH_TEXT : bearColorInput, text_size = ts, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(primaryBull, "Confirmed Primary Bull", "Special K: crossover of the 100/100 smoothing confirmed by a trendline or series break, primary trend turned bullish on {{ticker}} ({{interval}})")
alertcondition(primaryBear, "Confirmed Primary Bear", "Special K: crossunder of the 100/100 smoothing confirmed by a trendline or series break, primary trend turned bearish on {{ticker}} ({{interval}})")
alertcondition(bullCross, "Signal Crossover", "Special K crossed above its 100/100 smoothing on {{ticker}} ({{interval}})")
alertcondition(bearCross, "Signal Crossunder", "Special K crossed below its 100/100 smoothing on {{ticker}} ({{interval}})")
alertcondition(tlBreakUp or tlBreakDown, "Trendline Break", "Special K broke its trendline on {{ticker}} ({{interval}})")
alertcondition(shortBuy, "Short-Term Pro-Trend Buy", "Special K crossed above its 10-bar average in a bullish primary trend on {{ticker}} ({{interval}})")
alertcondition(shortSell, "Short-Term Pro-Trend Sell", "Special K crossed below its 10-bar average in a bearish primary trend on {{ticker}} ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
