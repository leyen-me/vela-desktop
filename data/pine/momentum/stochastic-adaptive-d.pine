//@version=6
indicator("Stochastic Adaptive %D", "Stochastic Adaptive %D", false)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // %D above its adaptive line, oversold zone
BEAR_COLOR    = #f23645 // %D below its adaptive line, overbought zone
NEUTRAL_COLOR = #787b86 // levels and midline - structure
STOCH_COLOR   = #ffd700 // standard %D - identity hue
AMA_COLOR     = #ff9800 // adaptive %D - identity hue
ZONE_TRANSP   = 92      // transparency of the overbought / oversold zone shading
FILL_TRANSP   = 60      // transparency of the difference oscillator fill at the line end

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{
stochGroup          = 'Stochastic Settings'
kLengthInput        = input.int(20, 'Stochastic Length', minval = 1, group = stochGroup)
dSmoothingInput     = input.int(9, '%K Smoothing', minval = 1, group = stochGroup, tooltip = 'Determines the smoothing applied to the raw %K values to produce the standard %D line.')
preSmoothInput      = input.int(20, 'Price Pre-Smoothing', minval = 1, group = stochGroup, tooltip = 'Smooths the High, Low, and Close sources before calculation.')

amaGroup            = 'Adaptive Smoothing Settings'
attenuationInput    = input.float(2.0, 'Attenuation Factor', minval = 0.1, step = 0.1, group = amaGroup, tooltip = 'Controls the intensity of the stochastic input and the smoothing speed of the Adaptive %D.')

colorGroup          = 'Colors'
stochColorInput     = input.color(STOCH_COLOR, 'Standard %D Color', group = colorGroup)
amaColorInput       = input.color(AMA_COLOR, 'Adaptive %D Color', group = colorGroup)
bullColorInput      = input.color(BULL_COLOR, 'Bullish Color',     group = colorGroup)
bearColorInput      = input.color(BEAR_COLOR, 'Bearish Color',     group = colorGroup)

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Price Pre-Smoothing
sHigh  = ta.sma(high, preSmoothInput)
sLow   = ta.sma(low, preSmoothInput)
sClose = ta.sma(close, preSmoothInput)

// Standard Stochastic calculation
// Raw stochastic is %K, smoothed is %D, both dampened by 2
stochRaw = ta.stoch(sClose, sHigh, sLow, kLengthInput)
stoch    = 50 + (stochRaw - 50) / 2
stochD   = 50 + (ta.sma(stochRaw, dSmoothingInput) - 50) / 2

// Adaptive Moving Average (AMA) logic applied to %D
float alpha  = (math.abs(stochD - 50) / 100) / attenuationInput
float srcAma = (stochD - 50) / attenuationInput + 50

var float amaValue = 50.0
amaValue := nz(amaValue[1]) + alpha * (srcAma - nz(amaValue[1]))

// Difference calculation (Centered at 50)
float diffPlotValue = 50 + (stochD - amaValue) * 2

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
// Levels
hline(80, 'Overbought', NEUTRAL_COLOR, linestyle = hline.style_dashed)
hline(50, 'Midline',    color.new(NEUTRAL_COLOR, 50), linestyle = hline.style_dotted)
hline(20, 'Oversold',   NEUTRAL_COLOR, linestyle = hline.style_dashed)

// Zone shading anchored on hidden plots - overbought above, oversold below
obZoneId       = plot(80, 'Overbought Zone Anchor', color(na), editable = false, display = display.none)
osZoneId       = plot(20, 'Oversold Zone Anchor', color(na), editable = false, display = display.none)
topAnchorId    = plot(100, 'Top Anchor', color(na), editable = false, display = display.none)
bottomAnchorId = plot(0, 'Bottom Anchor', color(na), editable = false, display = display.none)

fill(obZoneId, topAnchorId, color.new(bearColorInput, ZONE_TRANSP), title = 'Overbought Zone')
fill(osZoneId, bottomAnchorId, color.new(bullColorInput, ZONE_TRANSP), title = 'Oversold Zone')

// Midline plot for fills
midPlotId = plot(50, 'Midline Plot', display = display.none)

// Difference Oscillator Line & Fill - colored by its side of the midline
diffColor  = diffPlotValue > 50 ? bullColorInput : bearColorInput
diffPlotId = plot(diffPlotValue, 'Difference Oscillator Line', diffColor, 1)

fill(diffPlotId, midPlotId, 
     top_value    = math.max(diffPlotValue, 50), 
     bottom_value = math.min(diffPlotValue, 50),
     top_color    = diffPlotValue > 50 ? color.new(bullColorInput, FILL_TRANSP) : color.new(bearColorInput, 100),
     bottom_color = diffPlotValue > 50 ? color.new(bullColorInput, 100) : color.new(bearColorInput, FILL_TRANSP),
     title        = 'Difference Oscillator Fill')

// Standard Stochastic Plot (%D)
plot(stochD, 'Standard %D', stochColorInput, 1, plot.style_line, linestyle = plot.linestyle_dotted)

// Adaptive Stochastic Plot (Adaptive %D)
plot(amaValue, 'Adaptive %D', amaColorInput, 1, linestyle = plot.linestyle_dashed)

//---------------------------------------------------------------------------------------------------------------------}
