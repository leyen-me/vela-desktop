//@version=6
indicator("Bill Williams Profitunity", "Profitunity", overlay = true, format = format.price, max_labels_count = 500, max_lines_count = 500, max_polylines_count = 10)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // green zone, long side
BEAR_COLOR    = #f23645 // red zone, short side
GRAY_COLOR    = #787b86 // gray zone, AO and AC disagree
JAW_COLOR     = #ab47bc // the Alligator palette of the LuxAlgo Williams Alligator build
TEETH_COLOR   = #ff9800
LIPS_COLOR    = #ffd700

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_HEADER = #808080
DASH_TEXT   = #DBDBDB

SIDE_BOTH = "Long & Short"
SIDE_LONG = "Long Only"
SIDE_OFF  = "Off"

EXIT_TEETH   = "Close Beyond Teeth"
EXIT_FRACTAL = "Opposite Fractal"

SRC_NONE = 0
SRC_WM1  = 1
SRC_WM3  = 3

GRP_ALLI  = "Alligator"
GRP_SIG   = "Wise Man Entries"
GRP_TRADE = "Trade Management"
GRP_STYLE = "Style"
GRP_DASH  = "Dashboard"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
jawLenInput   = input.int(13, "Jaw", minval = 1, inline = "jaw", group = GRP_ALLI)
jawOffInput   = input.int(8, "Offset", minval = 0, inline = "jaw", group = GRP_ALLI
  , tooltip = "Jaw (blue line in the books): 13-bar smoothed moving average of the median price, displaced 8 bars forward.")
teethLenInput = input.int(8, "Teeth", minval = 1, inline = "teeth", group = GRP_ALLI)
teethOffInput = input.int(5, "Offset", minval = 0, inline = "teeth", group = GRP_ALLI
  , tooltip = "Teeth (red line, the Balance Line): 8-bar smoothed moving average of the median price, displaced 5 bars forward. It is the line fractals are filtered against and the default trailing exit.")
lipsLenInput  = input.int(5, "Lips", minval = 1, inline = "lips", group = GRP_ALLI)
lipsOffInput  = input.int(3, "Offset", minval = 0, inline = "lips", group = GRP_ALLI
  , tooltip = "Lips (green line): 5-bar smoothed moving average of the median price, displaced 3 bars forward.")

sideInput = input.string(SIDE_BOTH, "Direction", options = [SIDE_BOTH, SIDE_LONG, SIDE_OFF], group = GRP_SIG
  , tooltip = "Sides the system trades. Only one position is held at a time; signals in the direction of an open position are marked as add-ons.")

useWm1Input = input.bool(true, "First Wise Man (Divergent Bar)", group = GRP_SIG
  , tooltip = "A bullish divergent bar makes a lower low than the five bars before it, closes in its upper half and prints entirely below the three Alligator lines while they point down and the Awesome Oscillator is still falling, stretched away from the lines by the angulation distance. A buy stop sits one tick above its high and is cancelled if price trades below its low first. Mirrored for bearish divergent bars above the Alligator. A divergent bar that is also a squat bar (Market Facilitation Index down, volume up) is flagged in its tooltip.")

angulationInput = input.float(1.0, "Divergent Bar Angulation (ATR)", minval = 0, step = 0.25, group = GRP_SIG
  , tooltip = "How far the divergent bar must stand from the Alligator: the gap between the bar and the nearest line, in 14-bar ATRs. Williams stresses angulation, a market stretched away from the Alligator, because a divergent bar right next to the lines is usually just a pause.")

useWm2Input = input.bool(true, "Second Wise Man (Super AO)", group = GRP_SIG
  , tooltip = "Inside an open long, the third consecutive rising Awesome Oscillator bar sets an add-on buy stop one tick above the high of the price bar that printed it; it is cancelled if the AO turns down first. Mirrored for shorts. Add-ons are marked + and do not change the tracked entry.")

useWm3Input = input.bool(true, "Third Wise Man (Fractal Breakout)", group = GRP_SIG
  , tooltip = "A five-bar up fractal is a valid buy signal only when its high is above the Alligator's teeth; a buy stop then sits one tick above it and moves to each newer valid fractal until triggered. Down fractals below the teeth set sell stops. Fractals on the wrong side of the teeth are drawn faded and ignored.")

zoneFilterInput = input.bool(true, "Zone Filter", group = GRP_SIG
  , tooltip = "Williams' zone rule: never buy on a red-zone bar (AO and AC both falling) and never sell on a green-zone bar (both rising). Triggers that fire on such a bar are skipped.")

exitModeInput = input.string(EXIT_TEETH, "Trailing Exit", options = [EXIT_TEETH, EXIT_FRACTAL], group = GRP_TRADE
  , tooltip = "Close Beyond Teeth exits a long on the first close below the teeth (above it for shorts), once price has closed on the right side of the teeth at least once. Opposite Fractal exits when price breaks the most recent fractal on the other side.")

showAlligatorInput = input.bool(true, "Alligator Lines", group = GRP_STYLE
  , tooltip = "Draws the three displaced balance lines, including their forward projection past the last bar.")
showFractalsInput  = input.bool(true, "Fractals", group = GRP_STYLE
  , tooltip = "Marks confirmed fractals: solid when they pass the Alligator filter, faded when they sit on the wrong side of the teeth.")
showStopsInput     = input.bool(true, "Pending Stop Levels", group = GRP_STYLE
  , tooltip = "Draws the live buy stop and sell stop from the most recent valid fractals, and the divergent bar stops, until they are triggered, replaced or cancelled.")
zoneBarsInput      = input.bool(true, "Zone Bar Colors", group = GRP_STYLE
  , tooltip = "Colors the price bars with Williams' zones: green when the AO and AC both rise, red when both fall, gray when they disagree.")
showTradesInput    = input.bool(true, "Trades", group = GRP_STYLE
  , tooltip = "Draws entries, the open position line, add-on marks and exits with the change from entry.")

bullColorInput = input.color(BULL_COLOR, "Green Zone", inline = "z", group = GRP_STYLE)
bearColorInput = input.color(BEAR_COLOR, "Red Zone", inline = "z", group = GRP_STYLE)
grayColorInput = input.color(GRAY_COLOR, "Gray Zone", inline = "z", group = GRP_STYLE)
jawColorInput   = input.color(JAW_COLOR, "Jaw", inline = "a", group = GRP_STYLE)
teethColorInput = input.color(TEETH_COLOR, "Teeth", inline = "a", group = GRP_STYLE)
lipsColorInput  = input.color(LIPS_COLOR, "Lips", inline = "a", group = GRP_STYLE)

showDashInput = input.bool(true, "Show Dashboard", group = GRP_DASH
  , tooltip = "The system on one panel: Alligator state, zone and its streak, AO and AC, the live stop levels and the open position.")
dashPosInput  = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], inline = "dash", group = GRP_DASH)
dashSizeInput = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], inline = "dash", group = GRP_DASH)

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
getSize(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Normal" => size.normal
        =>          size.small

getPosition(string p) =>
    switch p
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        =>                position.top_right

fmtPct(float x) =>
    na(x) ? "-" : (x >= 0 ? "+" : "") + str.tostring(x, "0.00") + "%"

fmtPrice(float x) =>
    na(x) ? "-" : str.tostring(x, format.mintick)

//---------------------------------------------------------------------------------------------------------------------}
// Alligator, AO, AC and Zones
//---------------------------------------------------------------------------------------------------------------------{
// Williams' smoothed moving average (SMMA) is Wilder's smoothing, seeded with a simple average
jaw   = ta.rma(hl2, jawLenInput)
teeth = ta.rma(hl2, teethLenInput)
lips  = ta.rma(hl2, lipsLenInput)

// Lines as they stand above each bar on the chart: each average was computed `offset` bars earlier
jawD   = jaw[jawOffInput]
teethD = teeth[teethOffInput]
lipsD  = lips[lipsOffInput]

ao = ta.sma(hl2, 5) - ta.sma(hl2, 34)
ac = ao - ta.sma(ao, 5)

bool greenZone = ao > ao[1] and ac > ac[1]
bool redZone   = ao < ao[1] and ac < ac[1]
int  zone      = greenZone ? 1 : redZone ? -1 : 0

var int zoneStreak = 0
zoneStreak := zone != 0 and zone == nz(zone[1]) ? zoneStreak + 1 : zone != 0 ? 1 : 0

// Alligator state from the order of the displaced lines
int gatorDir = lipsD > teethD and teethD > jawD ? 1 : lipsD < teethD and teethD < jawD ? -1 : 0

float tick = syminfo.mintick

//---------------------------------------------------------------------------------------------------------------------}
// Fractals (Third Wise Man) & Divergent Bars (First Wise Man)
//---------------------------------------------------------------------------------------------------------------------{
bool upFractal   = bar_index >= 4 and high[2] > high[3] and high[2] > high[4] and high[2] > high[1] and high[2] > high
bool downFractal = bar_index >= 4 and low[2] < low[3] and low[2] < low[4] and low[2] < low[1] and low[2] < low
bool upValid     = upFractal and high[2] > teethD[2]
bool downValid   = downFractal and low[2] < teethD[2]

var float lastUpFractal   = na
var float lastDownFractal = na
if upFractal
    lastUpFractal := high[2]
if downFractal
    lastDownFractal := low[2]

// Divergent bars with angulation: the bar sits entirely outside the Alligator's mouth and the lines point the other way
atr = ta.atr(14)
// label anchors clear of the neighbouring candles
float topAnchor = ta.highest(high, 5)
float botAnchor = ta.lowest(low, 5)
bool bullDivBar = low < ta.lowest(low, 5)[1] and close > hl2 and ao < ao[1] and gatorDir == -1 and math.min(jawD, teethD, lipsD) - high >= angulationInput * atr
bool bearDivBar = high > ta.highest(high, 5)[1] and close < hl2 and ao > ao[1] and gatorDir == 1 and low - math.max(jawD, teethD, lipsD) >= angulationInput * atr

// Market Facilitation Index squat: range per unit of volume falls while volume rises
float mfi   = nz(volume) > 0 ? (high - low) / volume : na
bool  squat = not na(mfi) and not na(mfi[1]) and mfi < mfi[1] and volume > volume[1]

// Second Wise Man, the third consecutive Awesome Oscillator bar in one direction
bool aoUp3    = ao > ao[1] and ao[1] > ao[2] and ao[2] > ao[3]
bool aoDn3    = ao < ao[1] and ao[1] < ao[2] and ao[2] < ao[3]
bool aoUp3New = aoUp3 and not aoUp3[1]
bool aoDn3New = aoDn3 and not aoDn3[1]

if showFractalsInput
    if upFractal
        label.new(bar_index - 2, high[2], "▲", style = label.style_label_down, color = color.new(color.white, 100)
          , textcolor = upValid ? bullColorInput : color.new(grayColorInput, 65), size = size.tiny
          , tooltip = upValid ? "Up fractal above the teeth: a valid buy stop level." : "Up fractal inside or below the Alligator: ignored for buys.")
    if downFractal
        label.new(bar_index - 2, low[2], "▼", style = label.style_label_up, color = color.new(color.white, 100)
          , textcolor = downValid ? bearColorInput : color.new(grayColorInput, 65), size = size.tiny
          , tooltip = downValid ? "Down fractal below the teeth: a valid sell stop level." : "Down fractal inside or above the Alligator: ignored for sells.")

//---------------------------------------------------------------------------------------------------------------------}
// Pending Stops
//---------------------------------------------------------------------------------------------------------------------{
var float buyStop     = na
var int   buyStopBar  = na
var float sellStop    = na
var int   sellStopBar = na
var line  buyLine     = na
var line  sellLine    = na

var float wm1Buy      = na
var float wm1BuyInv   = na
var float wm1Sell     = na
var float wm1SellInv  = na
var line  wm1BuyLine  = na
var line  wm1SellLine = na

// triggers are read against the stops standing at the open of this bar
bool buyHit      = not na(buyStop) and high > buyStop
bool sellHit     = not na(sellStop) and low < sellStop
bool wm1BuyHit   = not na(wm1Buy) and high > wm1Buy
bool wm1SellHit  = not na(wm1Sell) and low < wm1Sell
float buyLevel   = buyStop
float sellLevel  = sellStop
float wm1BLevel  = wm1Buy
float wm1SLevel  = wm1Sell

// divergent bar stops are cancelled when price trades through the bar's other extreme first
if not na(wm1Buy) and not wm1BuyHit and low < wm1BuyInv
    wm1Buy := na
    line.delete(wm1BuyLine)
if not na(wm1Sell) and not wm1SellHit and high > wm1SellInv
    wm1Sell := na
    line.delete(wm1SellLine)

if buyHit
    buyStop := na
    if showStopsInput
        line.set_x2(buyLine, bar_index)
        line.set_style(buyLine, line.style_solid)
if sellHit
    sellStop := na
    if showStopsInput
        line.set_x2(sellLine, bar_index)
        line.set_style(sellLine, line.style_solid)
if wm1BuyHit
    wm1Buy := na
    if showStopsInput
        line.set_x2(wm1BuyLine, bar_index)
        line.set_style(wm1BuyLine, line.style_solid)
if wm1SellHit
    wm1Sell := na
    if showStopsInput
        line.set_x2(wm1SellLine, bar_index)
        line.set_style(wm1SellLine, line.style_solid)

// new levels from this bar's confirmations, effective from the next bar
if useWm3Input and upValid
    if not na(buyStop)
        line.delete(buyLine)
    buyStop    := high[2] + tick
    buyStopBar := bar_index - 2
    if showStopsInput
        buyLine := line.new(buyStopBar, buyStop, bar_index, buyStop, color = bullColorInput, style = line.style_dashed)
if useWm3Input and downValid
    if not na(sellStop)
        line.delete(sellLine)
    sellStop    := low[2] - tick
    sellStopBar := bar_index - 2
    if showStopsInput
        sellLine := line.new(sellStopBar, sellStop, bar_index, sellStop, color = bearColorInput, style = line.style_dashed)
if useWm1Input and bullDivBar
    if not na(wm1Buy)
        line.delete(wm1BuyLine)
    wm1Buy    := high + tick
    wm1BuyInv := low
    if showStopsInput
        wm1BuyLine := line.new(bar_index, wm1Buy, bar_index + 1, wm1Buy, color = bullColorInput, style = line.style_dotted)
        label.new(bar_index, low, "1", style = label.style_label_up, color = color.new(color.white, 100), textcolor = bullColorInput, size = size.small
          , tooltip = "First Wise Man: bullish divergent bar below the Alligator" + (squat ? ", also a squat bar" : "") + ". Buy stop above its high, cancelled below its low.")
if useWm1Input and bearDivBar
    if not na(wm1Sell)
        line.delete(wm1SellLine)
    wm1Sell    := low - tick
    wm1SellInv := high
    if showStopsInput
        wm1SellLine := line.new(bar_index, wm1Sell, bar_index + 1, wm1Sell, color = bearColorInput, style = line.style_dotted)
        label.new(bar_index, high, "1", style = label.style_label_down, color = color.new(color.white, 100), textcolor = bearColorInput, size = size.small
          , tooltip = "First Wise Man: bearish divergent bar above the Alligator" + (squat ? ", also a squat bar" : "") + ". Sell stop below its low, cancelled above its high.")

// keep live stop lines running to the current bar
if showStopsInput
    if not na(buyStop)
        line.set_x2(buyLine, bar_index)
    if not na(sellStop)
        line.set_x2(sellLine, bar_index)
    if not na(wm1Buy)
        line.set_x2(wm1BuyLine, bar_index)
    if not na(wm1Sell)
        line.set_x2(wm1SellLine, bar_index)

//---------------------------------------------------------------------------------------------------------------------}
// Trade Management
//---------------------------------------------------------------------------------------------------------------------{
var int   position    = 0
var float entryPrice  = na
var float initStop    = na
var bool  trailActive = false
var int   entrySource = SRC_NONE
var line  tradeLine   = na

bool  longEntry  = false
bool  shortEntry = false
bool  anyExit    = false
bool  addOn      = false
bool  addWm2     = false
var float wm2Stop = na
float exitPrice  = na
float exitChange = na
string exitWhy   = ""

bool allowLong  = sideInput != SIDE_OFF
bool allowShort = sideInput == SIDE_BOTH

if sideInput != SIDE_OFF and barstate.isconfirmed
    // triggers, filtered by the zone of the trigger bar
    bool longOk    = not zoneFilterInput or zone != -1
    bool shortOk   = not zoneFilterInput or zone != 1
    bool longTrig  = allowLong and longOk and ((useWm1Input and wm1BuyHit) or (useWm3Input and buyHit))
    bool shortTrig = allowShort and shortOk and ((useWm1Input and wm1SellHit) or (useWm3Input and sellHit))
    bool reversal  = false
    int  wasPos    = position

    // exits: protective stop first, then an opposite Wise Man trigger (stop and reverse), then the trailing rule
    if position == 1
        trailActive := trailActive or close > teethD
        if not na(initStop) and low <= initStop
            exitPrice := math.min(open, initStop)
            exitWhy   := "initial stop"
        else if shortTrig
            exitPrice := math.min(open, wm1SellHit ? wm1SLevel : sellLevel)
            exitWhy   := "opposite Wise Man signal"
            reversal  := true
        else if exitModeInput == EXIT_TEETH and trailActive and close < teethD
            exitPrice := close
            exitWhy   := "close below the teeth"
        else if exitModeInput == EXIT_FRACTAL and not na(lastDownFractal[1]) and low < lastDownFractal[1]
            exitPrice := math.min(open, lastDownFractal[1])
            exitWhy   := "break of the last down fractal"
    else if position == -1
        trailActive := trailActive or close < teethD
        if not na(initStop) and high >= initStop
            exitPrice := math.max(open, initStop)
            exitWhy   := "initial stop"
        else if longTrig
            exitPrice := math.max(open, wm1BuyHit ? wm1BLevel : buyLevel)
            exitWhy   := "opposite Wise Man signal"
            reversal  := true
        else if exitModeInput == EXIT_TEETH and trailActive and close > teethD
            exitPrice := close
            exitWhy   := "close above the teeth"
        else if exitModeInput == EXIT_FRACTAL and not na(lastUpFractal[1]) and high > lastUpFractal[1]
            exitPrice := math.max(open, lastUpFractal[1])
            exitWhy   := "break of the last up fractal"

    if not na(exitPrice)
        anyExit    := true
        exitChange := position * (exitPrice - entryPrice) / entryPrice * 100
        if showTradesInput
            line.set_x2(tradeLine, bar_index)
            line.set_y2(tradeLine, exitPrice)
            if not reversal
                label.new(bar_index, position == 1 ? topAnchor : botAnchor, "Exit " + fmtPct(exitChange)
                  , style = position == 1 ? label.style_label_down : label.style_label_up, color = color.new(grayColorInput, 20)
                  , textcolor = DASH_TEXT, size = size.small
                  , tooltip = "Position closed on the " + exitWhy + " at " + fmtPrice(exitPrice) + ". Change from entry: " + fmtPct(exitChange))
        position := 0

    // Second Wise Man add-on stops: armed by the third consecutive AO bar in the position's direction
    bool wm2Hit = false
    if position == 1 and not na(wm2Stop)
        if high > wm2Stop
            wm2Hit  := true
            wm2Stop := na
        else if ao < ao[1]
            wm2Stop := na
    else if position == -1 and not na(wm2Stop)
        if low < wm2Stop
            wm2Hit  := true
            wm2Stop := na
        else if ao > ao[1]
            wm2Stop := na
    if position == 0
        wm2Stop := na
    if useWm2Input and position == 1 and aoUp3New and na(wm2Stop) and not wm2Hit
        wm2Stop := high + tick
    if useWm2Input and position == -1 and aoDn3New and na(wm2Stop) and not wm2Hit
        wm2Stop := low - tick
    addWm2 := wm2Hit
    if position == 1 and ((useWm3Input and buyHit) or wm2Hit)
        addOn := true
    if position == -1 and ((useWm3Input and sellHit) or wm2Hit)
        addOn := true

    if position == 0 and longTrig and (not anyExit or (reversal and wasPos == -1))
        longEntry   := true
        entrySource := useWm1Input and wm1BuyHit ? SRC_WM1 : SRC_WM3
        float lvl   = entrySource == SRC_WM1 ? wm1BLevel : buyLevel
        entryPrice  := math.max(open, lvl)
        initStop    := entrySource == SRC_WM1 ? wm1BuyInv : lastDownFractal
        initStop    := not na(initStop) and initStop < entryPrice ? initStop : na
        trailActive := close > teethD
        position    := 1
    else if position == 0 and shortTrig and (not anyExit or (reversal and wasPos == 1))
        shortEntry  := true
        entrySource := useWm1Input and wm1SellHit ? SRC_WM1 : SRC_WM3
        float lvl   = entrySource == SRC_WM1 ? wm1SLevel : sellLevel
        entryPrice  := math.min(open, lvl)
        initStop    := entrySource == SRC_WM1 ? wm1SellInv : lastUpFractal
        initStop    := not na(initStop) and initStop > entryPrice ? initStop : na
        trailActive := close < teethD
        position    := -1

    if (longEntry or shortEntry) and showTradesInput
        color c = longEntry ? bullColorInput : bearColorInput
        string src = entrySource == SRC_WM1 ? "Divergent Bar" : "Fractal"
        tradeLine := line.new(bar_index, entryPrice, bar_index, close, color = c, width = 2, style = line.style_dashed)
        string closedText = anyExit ? (longEntry ? "\nshort " : "long ") + fmtPct(exitChange) + (longEntry ? "" : "\n") : ""
        string entryText  = (longEntry ? "Long" : "Short") + " · " + src
        label.new(bar_index, longEntry ? botAnchor : topAnchor, longEntry ? entryText + closedText : closedText + entryText
          , style = longEntry ? label.style_label_up : label.style_label_down, color = c, textcolor = color.white, size = size.small
          , tooltip = (entrySource == SRC_WM1 ? "First Wise Man: the divergent bar's stop was taken out at " : "Third Wise Man: price broke the valid fractal at ") + fmtPrice(entryPrice) + (na(initStop) ? "." : ". Initial stop " + fmtPrice(initStop) + "."))

    if addOn and showTradesInput
        label.new(bar_index, position == 1 ? low : high, "+", style = position == 1 ? label.style_label_up : label.style_label_down
          , color = color.new(color.white, 100), textcolor = position == 1 ? bullColorInput : bearColorInput, size = size.small
          , tooltip = (addWm2 ? "Second Wise Man (third consecutive AO bar, stop taken out)" : "Third Wise Man (fractal breakout)") + " in the direction of the open position: an add-on signal.")

if position != 0 and showTradesInput and not na(tradeLine) and not anyExit
    line.set_x2(tradeLine, bar_index)
    line.set_y2(tradeLine, close)

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
plot(showAlligatorInput ? jawD : na, "Jaw", jawColorInput, 1)
plot(showAlligatorInput ? teethD : na, "Teeth", teethColorInput, 1)
plot(showAlligatorInput ? lipsD : na, "Lips", lipsColorInput, 1)

barcolor(zoneBarsInput ? (zone == 1 ? bullColorInput : zone == -1 ? bearColorInput : grayColorInput) : na, title = "Zone Bars")

// forward projection of the displaced lines past the last bar
var polyline jawFwd   = na
var polyline teethFwd = na
var polyline lipsFwd  = na
if barstate.islast and showAlligatorInput
    polyline.delete(jawFwd)
    polyline.delete(teethFwd)
    polyline.delete(lipsFwd)
    jp = array.new<chart.point>()
    tp = array.new<chart.point>()
    lp = array.new<chart.point>()
    for k = 0 to jawOffInput
        jp.push(chart.point.from_index(bar_index + k, jaw[jawOffInput - k]))
    for k = 0 to teethOffInput
        tp.push(chart.point.from_index(bar_index + k, teeth[teethOffInput - k]))
    for k = 0 to lipsOffInput
        lp.push(chart.point.from_index(bar_index + k, lips[lipsOffInput - k]))
    jawFwd   := polyline.new(jp, line_color = jawColorInput)
    teethFwd := polyline.new(tp, line_color = teethColorInput)
    lipsFwd  := polyline.new(lp, line_color = lipsColorInput)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
var table dash = table.new(getPosition(dashPosInput), 2, 6, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

if barstate.islast and showDashInput
    ts = getSize(dashSizeInput)
    color zoneColor = zone == 1 ? bullColorInput : zone == -1 ? bearColorInput : grayColorInput
    string gatorText = gatorDir == 1 ? "Eating ▲" : gatorDir == -1 ? "Eating ▼" : "Sleeping"
    table.cell(dash, 0, 0, "Alligator", text_color = DASH_HEADER, text_halign = text.align_left, text_size = ts
      , tooltip = "Eating when the displaced lines fan out in order (lips, teeth, jaw), sleeping while they are intertwined.")
    table.cell(dash, 1, 0, gatorText, text_color = gatorDir == 1 ? bullColorInput : gatorDir == -1 ? bearColorInput : grayColorInput, text_halign = text.align_right, text_size = ts)
    table.cell(dash, 0, 1, "Zone", text_color = DASH_HEADER, text_halign = text.align_left, text_size = ts
      , tooltip = "Green: AO and AC both rising. Red: both falling. Gray: they disagree. The streak counts consecutive bars of the same zone; Williams treats five in a row as a stretched move.")
    table.cell(dash, 1, 1, (zone == 1 ? "Green" : zone == -1 ? "Red" : "Gray") + (zone != 0 ? " ×" + str.tostring(zoneStreak) : ""), text_color = zoneColor, text_halign = text.align_right, text_size = ts)
    table.cell(dash, 0, 2, "AO / AC", text_color = DASH_HEADER, text_halign = text.align_left, text_size = ts
      , tooltip = "Awesome Oscillator (5/34 SMA of the median price) and Accelerator Oscillator (AO minus its 5-bar SMA), with their direction.")
    table.cell(dash, 1, 2, (ao > ao[1] ? "▲" : "▼") + " / " + (ac > ac[1] ? "▲" : "▼"), text_color = DASH_TEXT, text_halign = text.align_right, text_size = ts)
    table.cell(dash, 0, 3, "Buy Stop", text_color = DASH_HEADER, text_halign = text.align_left, text_size = ts)
    float bs = na(wm1Buy) ? buyStop : na(buyStop) ? wm1Buy : math.min(buyStop, wm1Buy)
    float ss = na(wm1Sell) ? sellStop : na(sellStop) ? wm1Sell : math.max(sellStop, wm1Sell)
    table.cell(dash, 1, 3, fmtPrice(bs), text_color = na(bs) ? DASH_HEADER : bullColorInput, text_halign = text.align_right, text_size = ts)
    table.cell(dash, 0, 4, "Sell Stop", text_color = DASH_HEADER, text_halign = text.align_left, text_size = ts)
    table.cell(dash, 1, 4, fmtPrice(ss), text_color = na(ss) ? DASH_HEADER : bearColorInput, text_halign = text.align_right, text_size = ts)
    table.cell(dash, 0, 5, "Position", text_color = DASH_HEADER, text_halign = text.align_left, text_size = ts)
    string posText = position == 1 ? "Long " + fmtPct((close - entryPrice) / entryPrice * 100) : position == -1 ? "Short " + fmtPct((entryPrice - close) / entryPrice * 100) : "Flat"
    table.cell(dash, 1, 5, posText, text_color = position == 1 ? bullColorInput : position == -1 ? bearColorInput : DASH_HEADER, text_halign = text.align_right, text_size = ts)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(longEntry, "Profitunity Long", "Profitunity long on {{ticker}} ({{interval}}): a Wise Man buy stop was triggered")
alertcondition(shortEntry, "Profitunity Short", "Profitunity short on {{ticker}} ({{interval}}): a Wise Man sell stop was triggered")
alertcondition(anyExit, "Profitunity Exit", "Profitunity exit on {{ticker}} ({{interval}})")
alertcondition(bullDivBar, "Bullish Divergent Bar", "First Wise Man: bullish divergent bar below the Alligator on {{ticker}} ({{interval}})")
alertcondition(bearDivBar, "Bearish Divergent Bar", "First Wise Man: bearish divergent bar above the Alligator on {{ticker}} ({{interval}})")
alertcondition(addOn, "Wise Man Add-on", "Profitunity add-on signal in the direction of the open position on {{ticker}} ({{interval}})")
alertcondition(upValid, "Valid Up Fractal", "Third Wise Man: up fractal above the teeth on {{ticker}} ({{interval}}), buy stop set")
alertcondition(downValid, "Valid Down Fractal", "Third Wise Man: down fractal below the teeth on {{ticker}} ({{interval}}), sell stop set")
alertcondition(buyHit, "Fractal Buy Stop Hit", "Price broke the valid up fractal on {{ticker}} ({{interval}})")
alertcondition(sellHit, "Fractal Sell Stop Hit", "Price broke the valid down fractal on {{ticker}} ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
