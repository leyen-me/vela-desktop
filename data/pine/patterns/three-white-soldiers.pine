//@version=6
indicator("Three White Soldiers"
  , shorttitle       = "Three White Soldiers"
  , overlay          = true
  , format           = format.price
  , max_lines_count  = 500
  , max_labels_count = 500
  , max_boxes_count  = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
color BULL_COLOR    = #089981
color BEAR_COLOR    = #f23645
color WARN_COLOR    = #ff9800
color NEUTRAL_COLOR = #787b86
color LABEL_BG      = #00000000

color DASH_BG     = #161616
color DASH_FRAME  = #2E2E2E
color DASH_HEADER = #808080
color DASH_TEXT   = #DBDBDB

int BOX_BG_TRANSP     = 86
int BOX_BORDER_TRANSP = 55
int ZONE_BG_TRANSP    = 90
int FADED_TRANSP      = 70

string CTX_AVG = "Below Average"
string CTX_NET = "Net Decline"
string CTX_ANY = "Either"

string ENTRY_MID   = "Pattern Midpoint"
string ENTRY_FIRST = "First Soldier Close"
string ENTRY_THIRD = "Third Close"

string GROUP_RULES   = "Soldier Rules"
string GROUP_CONTEXT = "Location & Quality"
string GROUP_TRADE   = "Trade Plan"
string GROUP_WARN    = "Deteriorated Variants"
string GROUP_DASH    = "Dashboard"
string GROUP_STYLE   = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
bodyLengthInput = input.int(14, "Body Average Length", minval = 2, maxval = 200, group = GROUP_RULES
  , tooltip = "Bars, ending right before the pattern, used to average the real body of preceding candles. Each soldier must print a long body relative to this average.")

bodyMultInput = input.float(0.8, "Long Body Multiplier", minval = 0.1, maxval = 5, step = 0.1, group = GROUP_RULES
  , tooltip = "Minimum real body of each soldier as a multiple of the pre-pattern average body. Three modest white candles are drift, not soldiers: raise it to demand more substantial sessions.")

shadowPctInput = input.float(35, "Upper Shadow Tolerance %", minval = 0, maxval = 200, step = 5, group = GROUP_RULES
  , tooltip = "Largest upper shadow allowed on each soldier, as a percentage of its real body. Each candle should close at or near its high: prominent upper wicks show supply and shade the sequence toward an advance block.")

openTolInput = input.float(25, "Open Gap Tolerance %", minval = 0, maxval = 100, step = 5, group = GROUP_RULES
  , tooltip = "Each soldier should open within the prior soldier's real body, a small dip that was bought. This allows an open above the prior close by up to this percentage of the prior body, since instruments with session closes rarely open exactly inside it. Set to 0 for the strict classical rule.")

similarInput = input.float(50, "Body Similarity %", minval = 0, maxval = 100, step = 5, group = GROUP_RULES
  , tooltip = "Smallest soldier body as a percentage of the largest. Bodies of similar substantial size separate steady accumulation from one emotional bar followed by drift. Set to 0 to disable.")

contextInput = input.bool(true, "Require Prior Decline", group = GROUP_CONTEXT
  , tooltip = "The soldiers are a reversal pattern: they need a preceding decline or base. Three white candles inside an established uptrend are just the trend continuing. The test is read at the bar before the first soldier.")

contextModeInput = input.string(CTX_ANY, "Decline Test", options = [CTX_AVG, CTX_NET, CTX_ANY], group = GROUP_CONTEXT
  , tooltip = "'Below Average' requires the close before the pattern to sit below its moving average. 'Net Decline' requires that close to be lower than it was 'Context Length' bars earlier. 'Either' accepts one of the two. The deteriorated variants use the mirror test, a prior advance.")

contextLengthInput = input.int(20, "Context Length", minval = 2, maxval = 200, group = GROUP_CONTEXT
  , tooltip = "Moving average length and net-change lookback used by the decline test.")

swingLengthInput = input.int(5, "Swing Length", minval = 1, maxval = 50, group = GROUP_CONTEXT
  , tooltip = "Bars required on each side of a high for it to count as a confirmed swing high. A third soldier closing above the latest swing high adds structural confirmation to the candle evidence and is drawn on the chart.")

extensionInput = input.float(3, "Extension Threshold (ATR)", minval = 0.5, maxval = 20, step = 0.5, group = GROUP_CONTEXT
  , tooltip = "Pattern height, first open to third close, measured in 14-bar ATR. Above this value the signal is tagged Extended: the third close is short-term stretched and the logical stop is far away, the most common way this pattern is misused.")

entryModeInput = input.string(ENTRY_MID, "Entry Level", options = [ENTRY_MID, ENTRY_FIRST, ENTRY_THIRD], group = GROUP_TRADE
  , tooltip = "Where the long is planned. 'Pattern Midpoint' and 'First Soldier Close' wait for the pullback many traders prefer over buying the third close, trading missed runaway moves for a closer stop. 'Third Close' enters on the completion bar.")

entryWindowInput = input.int(10, "Pullback Window", minval = 1, maxval = 100, group = GROUP_TRADE
  , tooltip = "Bars after the signal during which a pullback to the entry level is accepted. A setup that never pulls back inside the window is recorded as No Pullback, the runaway case.")

targetRInput = input.float(2, "Target (R)", minval = 0.5, maxval = 10, step = 0.25, group = GROUP_TRADE
  , tooltip = "Target as a multiple of the planned risk, the distance from the entry level down to the pattern low.")

maxHoldInput = input.int(40, "Maximum Hold (Bars)", minval = 1, maxval = 500, group = GROUP_TRADE
  , tooltip = "A filled setup that reaches neither its target nor its stop within this many bars is closed at the bar's close and recorded as Timed Out.")

advanceBlockInput = input.bool(true, "Advance Block", group = GROUP_WARN
  , tooltip = "Three rising white candles after an advance whose bodies shrink while upper shadows lengthen: the advance is tiring rather than starting. Labeled as a warning, never as a buy signal.")

stalledInput = input.bool(true, "Stalled (Deliberation)", group = GROUP_WARN
  , tooltip = "Two long white soldiers, then a small white body opening at or near the second close: buyers hesitating after the run. Labeled as a warning, never as a buy signal.")

stalledPctInput = input.float(50, "Stalled Body %", minval = 5, maxval = 90, step = 5, group = GROUP_WARN
  , tooltip = "The third candle counts as small when its body is at most this percentage of the second soldier's body.")

showDashInput = input.bool(true, "Show Dashboard", group = GROUP_DASH
  , tooltip = "Follow-through record of every soldiers setup on the chart: how many pulled back to the entry, and how the filled ones resolved.")

dashPosInput = input.string("Bottom Right", "Position", options = ["Top Right", "Bottom Right", "Bottom Left", "Top Left"], group = GROUP_DASH)

dashSizeInput = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], group = GROUP_DASH)

showLabelsInput = input.bool(true, "Pattern Labels", group = GROUP_STYLE
  , tooltip = "Label each pattern: 3WS for the soldiers (Ext. when extended), AB for an advance block, ST for a stalled pattern. Hover a label for the full read.")

showBoxInput = input.bool(true, "Highlight Pattern Candles", group = GROUP_STYLE)

showTradeInput = input.bool(true, "Trade Levels", group = GROUP_STYLE
  , tooltip = "Draw the entry, stop and target of each soldiers setup and the result where it resolves.")

bullColorInput = input.color(BULL_COLOR, "Soldiers", inline = "colors", group = GROUP_STYLE)
stopColorInput = input.color(BEAR_COLOR, "Stop", inline = "colors", group = GROUP_STYLE)
warnColorInput = input.color(WARN_COLOR, "Warnings", inline = "colors", group = GROUP_STYLE)
neutralColorInput = input.color(NEUTRAL_COLOR, "Neutral", inline = "colors", group = GROUP_STYLE)

//---------------------------------------------------------------------------------------------------------------------}
// Types
//---------------------------------------------------------------------------------------------------------------------{
// One soldiers setup: planned levels, its state (0 waiting for the pullback, 1 filled) and its drawings
type Setup
    int   signalBar
    int   fillBar
    int   state
    float entry
    float stop
    float target
    line  entryLine
    line  stopLine
    line  targetLine
    label entryTag
    label stopTag
    label targetTag
    box   rewardBox
    box   riskBox

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// A white candle whose body is long against the pre-pattern average and whose close sits near its high
isSoldier(float o, float h, float c, float refBody) =>
    float body = c - o
    c > o and refBody > 0 and body >= bodyMultInput * refBody and h - c <= body * shadowPctInput / 100

// Open within the prior white body, with the gap allowance above the prior close
opensInPrior(float o, float po, float pc) =>
    o >= po and o <= pc + (pc - po) * openTolInput / 100

// Move a level line and its tag to the given bar
moveLevel(line ln, label tag, int x) =>
    line.set_x2(ln, x)
    if not na(tag)
        label.set_x(tag, x)

// Extend a setup's drawings to the given bar
extendSetup(Setup s, int x) =>
    moveLevel(s.entryLine, s.entryTag, x)
    moveLevel(s.stopLine, s.stopTag, x)
    moveLevel(s.targetLine, s.targetTag, x)
    if not na(s.rewardBox)
        box.set_right(s.rewardBox, x)
        box.set_right(s.riskBox, x)

// Fill a setup at the entry: the level tags give way to a reward and a risk box labeled inside
openPosition(Setup s) =>
    label.delete(s.entryTag)
    label.delete(s.stopTag)
    label.delete(s.targetTag)
    s.entryTag  := label(na)
    s.stopTag   := label(na)
    s.targetTag := label(na)
    s.rewardBox := box.new(bar_index, s.target, bar_index, s.entry, border_color = LABEL_BG, bgcolor = color.new(bullColorInput, ZONE_BG_TRANSP)
      , text = "Target " + str.tostring(targetRInput, "#.##") + "R", text_color = bullColorInput, text_size = size.small, text_halign = text.align_left, text_valign = text.align_top)
    s.riskBox   := box.new(bar_index, s.entry, bar_index, s.stop, border_color = LABEL_BG, bgcolor = color.new(stopColorInput, ZONE_BG_TRANSP)
      , text = "Stop", text_color = stopColorInput, text_size = size.small, text_halign = text.align_left, text_valign = text.align_bottom)

// Retire a setup that never pulled back: fade its levels and keep a single note
fadeSetup(Setup s, int x) =>
    extendSetup(s, x)
    line.set_color(s.entryLine, color.new(neutralColorInput, FADED_TRANSP))
    line.set_color(s.stopLine, color.new(neutralColorInput, FADED_TRANSP))
    line.set_color(s.targetLine, color.new(neutralColorInput, FADED_TRANSP))
    label.delete(s.stopTag)
    label.delete(s.targetTag)
    if not na(s.entryTag)
        label.set_textcolor(s.entryTag, neutralColorInput)
        label.set_text(s.entryTag, "No Pullback")

//---------------------------------------------------------------------------------------------------------------------}
// Detection
//---------------------------------------------------------------------------------------------------------------------{
float bodySize  = math.abs(close - open)
float bodyAvg   = ta.sma(bodySize, bodyLengthInput)
float ctxAvg    = ta.sma(close, contextLengthInput)
float atrValue  = ta.atr(14)
float pivotHigh = ta.pivothigh(high, swingLengthInput, swingLengthInput)

// Yardstick for "long": the average body of the bars before the first candle
float refBody = bodyAvg[3]

// Bodies and upper shadows of the three candles, oldest first
float body1 = close[2] - open[2]
float body2 = close[1] - open[1]
float body3 = close - open
float upper1 = high[2] - math.max(open[2], close[2])
float upper2 = high[1] - math.max(open[1], close[1])
float upper3 = high - math.max(open, close)

// Location tests read at the bar before the first candle
bool belowAvg   = not na(ctxAvg[3]) and close[3] < ctxAvg[3]
bool aboveAvg   = not na(ctxAvg[3]) and close[3] > ctxAvg[3]
bool netDecline = not na(close[3 + contextLengthInput]) and close[3] < close[3 + contextLengthInput]
bool netAdvance = not na(close[3 + contextLengthInput]) and close[3] > close[3 + contextLengthInput]

bool declineOk = not contextInput or (contextModeInput == CTX_AVG ? belowAvg : contextModeInput == CTX_NET ? netDecline : belowAvg or netDecline)
bool advanceOk = not contextInput or (contextModeInput == CTX_AVG ? aboveAvg : contextModeInput == CTX_NET ? netAdvance : aboveAvg or netAdvance)

// Shared skeleton: three white candles, progressively higher closes, each opening in the prior body
bool allWhite  = close > open and close[1] > open[1] and close[2] > open[2]
bool climbing  = close > close[1] and close[1] > close[2]
bool opensOk   = opensInPrior(open[1], open[2], close[2]) and opensInPrior(open, open[1], close[1])
bool skeleton  = not na(refBody) and refBody > 0 and allWhite and climbing and opensOk

// Three white soldiers: three long white bodies of similar size closing near their highs
bool soldier1 = isSoldier(open[2], high[2], close[2], refBody)
bool soldier2 = isSoldier(open[1], high[1], close[1], refBody)
bool soldier3 = isSoldier(open, high, close, refBody)
float maxBody = math.max(body1, body2, body3)
float minBody = math.min(body1, body2, body3)
bool similarOk = maxBody > 0 and minBody >= maxBody * similarInput / 100

bool soldiersRaw = skeleton and soldier1 and soldier2 and soldier3 and similarOk and declineOk

// Advance block: shrinking bodies with lengthening upper shadows, the last one prominent
bool advanceBlockRaw = advanceBlockInput and skeleton and advanceOk and not soldiersRaw and body1 >= bodyMultInput * refBody
  and body3 < body2 and body2 < body1 and upper2 > upper1 and upper3 > upper1 and upper3 > body3 * shadowPctInput / 100

// Stalled: two long soldiers, then a small white body opening at or near the second close
bool stalledRaw = stalledInput and not na(refBody) and refBody > 0 and advanceOk and not soldiersRaw and not advanceBlockRaw
  and soldier1 and soldier2 and opensInPrior(open[1], open[2], close[2]) and close[1] > close[2]
  and close > open and close > close[1] and body3 <= body2 * stalledPctInput / 100 and open >= close[1] - body2 * 0.1

// Keep only patterns that do not share candles with the previous one
var int lastPatternBar = na
bool spaced = na(lastPatternBar) or bar_index - lastPatternBar >= 3

bool soldiersSignal = barstate.isconfirmed and soldiersRaw and spaced
bool advanceSignal  = barstate.isconfirmed and advanceBlockRaw and spaced
bool stalledSignal  = barstate.isconfirmed and stalledRaw and spaced

if soldiersSignal or advanceSignal or stalledSignal
    lastPatternBar := bar_index

// Latest confirmed swing high before the pattern
var float lastSwingHigh    = na
var int   lastSwingHighBar = na

bool swingCleared = soldiersSignal and not na(lastSwingHigh) and lastSwingHighBar < bar_index - 2 and close > lastSwingHigh and close[3] < lastSwingHigh

// Pattern geometry
float patternHigh = math.max(high, high[1], high[2])
float patternLow  = math.min(low, low[1], low[2])
float patternMid  = (open[2] + close) / 2
float heightAtr   = atrValue > 0 ? (close - open[2]) / atrValue : na
bool  extended    = soldiersSignal and not na(heightAtr) and heightAtr > extensionInput

//---------------------------------------------------------------------------------------------------------------------}
// Trade Tracking
//---------------------------------------------------------------------------------------------------------------------{
var array<Setup> setups = array.new<Setup>()

var int countSignals  = 0
var int countFilled   = 0
var int countTarget   = 0
var int countStop     = 0
var int countTimed    = 0
var int countNoFill   = 0
var int countAdvance  = 0
var int countStalled  = 0
var float sumR        = 0.0

bool fillEvent   = false
bool targetEvent = false
bool stopEvent   = false
bool noFillEvent = false

if barstate.isconfirmed and array.size(setups) > 0
    for i = array.size(setups) - 1 to 0
        Setup s = array.get(setups, i)
        bool remove = false
        if s.state == 0
            if low <= s.entry
                s.state   := 1
                s.fillBar := bar_index
                countFilled += 1
                fillEvent := true
                if showTradeInput
                    openPosition(s)
            else if bar_index - s.signalBar >= entryWindowInput
                countNoFill += 1
                noFillEvent := true
                if showTradeInput
                    fadeSetup(s, bar_index)
                remove := true
        if s.state == 1 and not remove
            float risk = s.entry - s.stop
            bool hitStop   = low <= s.stop
            bool hitTarget = not hitStop and bar_index > s.fillBar and high >= s.target
            bool timedOut  = not hitStop and not hitTarget and bar_index - s.fillBar >= maxHoldInput
            if hitStop or hitTarget or timedOut
                float r = hitStop ? -1.0 : hitTarget ? targetRInput : (close - s.entry) / risk
                sumR += r
                string rText = (r >= 0 ? "+" : "") + str.tostring(r, "#.#") + "R"
                if hitStop
                    countStop += 1
                    stopEvent := true
                else if hitTarget
                    countTarget += 1
                    targetEvent := true
                else
                    countTimed += 1
                if showTradeInput
                    extendSetup(s, bar_index)
                    color resultColor = hitStop ? stopColorInput : hitTarget ? bullColorInput : neutralColorInput
                    string resultTip  = hitStop ? "Stopped below the pattern low" : hitTarget ? "Target reached" : "Closed at the maximum hold"
                    label.new(bar_index, na, rText
                      , yloc      = r >= 0 ? yloc.abovebar : yloc.belowbar
                      , style     = r >= 0 ? label.style_label_down : label.style_label_up
                      , color     = resultColor
                      , textcolor = color.white
                      , size      = size.small
                      , tooltip   = resultTip)
                remove := true
        if showTradeInput and not remove
            extendSetup(s, bar_index)
        if remove
            array.remove(setups, i)

if not na(pivotHigh)
    lastSwingHigh    := pivotHigh
    lastSwingHighBar := bar_index - swingLengthInput

if soldiersSignal
    countSignals += 1
    float entryLevel  = entryModeInput == ENTRY_MID ? patternMid : entryModeInput == ENTRY_FIRST ? close[2] : close
    float stopLevel   = patternLow
    float riskSize    = entryLevel - stopLevel
    float targetLevel = entryLevel + riskSize * targetRInput
    bool  filledNow   = entryModeInput == ENTRY_THIRD

    line entryLn  = na
    line stopLn   = na
    line targetLn = na
    label entryLb  = na
    label stopLb   = na
    label targetLb = na

    if showTradeInput and riskSize > 0
        entryLn  := line.new(bar_index, entryLevel, bar_index + 1, entryLevel, color = bullColorInput, width = 2)
        stopLn   := line.new(bar_index, stopLevel, bar_index + 1, stopLevel, color = stopColorInput, style = line.style_dashed)
        targetLn := line.new(bar_index, targetLevel, bar_index + 1, targetLevel, color = bullColorInput, style = line.style_dashed)
        entryLb  := label.new(bar_index + 1, entryLevel, "Entry", style = label.style_label_left, color = LABEL_BG, textcolor = bullColorInput, size = size.small)
        stopLb   := label.new(bar_index + 1, stopLevel, "Stop", style = label.style_label_left, color = LABEL_BG, textcolor = stopColorInput, size = size.small)
        targetLb := label.new(bar_index + 1, targetLevel, "Target " + str.tostring(targetRInput, "#.##") + "R", style = label.style_label_left, color = LABEL_BG, textcolor = bullColorInput, size = size.small)

    if riskSize > 0
        Setup s = Setup.new(bar_index, filledNow ? bar_index : na, filledNow ? 1 : 0, entryLevel, stopLevel, targetLevel, entryLn, stopLn, targetLn, entryLb, stopLb, targetLb, box(na), box(na))
        if filledNow
            countFilled += 1
            if showTradeInput
                openPosition(s)
        array.push(setups, s)

    if showBoxInput
        box.new(bar_index - 2, patternHigh, bar_index, patternLow
          , border_color = color.new(bullColorInput, BOX_BORDER_TRANSP)
          , bgcolor      = color.new(bullColorInput, BOX_BG_TRANSP))

    if swingCleared
        line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color = color.new(bullColorInput, 30), style = line.style_dotted)
        label.new(lastSwingHighBar, lastSwingHigh, "Swing High", style = label.style_label_down, color = LABEL_BG, textcolor = color.new(bullColorInput, 20), size = size.tiny)

    if showLabelsInput
        string tip = "Three white soldiers: after a decline, three long white candles each opened within the prior body and closed near its high at a progressively higher level."
          + "\nHeight: " + str.tostring(heightAtr, "#.#") + " ATR" + (extended ? " (extended, the third close is stretched)" : "")
          + (swingCleared ? "\nThe third soldier closed above the prior swing high at " + str.tostring(lastSwingHigh, format.mintick) : "")
          + "\nEntry " + str.tostring(entryLevel, format.mintick) + ", stop " + str.tostring(stopLevel, format.mintick) + ", target " + str.tostring(targetLevel, format.mintick)
        label.new(bar_index - 1, patternHigh, extended ? "3WS Ext." : "3WS"
          , style     = label.style_label_down
          , color     = bullColorInput
          , textcolor = color.white
          , size      = size.small
          , tooltip   = tip)

if advanceSignal or stalledSignal
    if advanceSignal
        countAdvance += 1
    else
        countStalled += 1
    if showBoxInput
        box.new(bar_index - 2, patternHigh, bar_index, patternLow
          , border_color = color.new(warnColorInput, BOX_BORDER_TRANSP)
          , bgcolor      = color.new(warnColorInput, ZONE_BG_TRANSP))
    if showLabelsInput
        string warnTip = advanceSignal ? "Advance block: three rising white candles with shrinking bodies and lengthening upper shadows. The advance is tiring; a warning for longs, not a buy signal." : "Stalled pattern: two long white candles, then a small body opening near the second close. Buyers are hesitating after the run; a warning for longs, not a buy signal."
        label.new(bar_index - 1, patternHigh, advanceSignal ? "AB" : "ST"
          , style     = label.style_label_down
          , color     = LABEL_BG
          , textcolor = warnColorInput
          , size      = size.small
          , tooltip   = warnTip)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
var string dashPos = switch dashPosInput
    "Top Right"    => position.top_right
    "Bottom Left"  => position.bottom_left
    "Top Left"     => position.top_left
    => position.bottom_right

var string dashSize = switch dashSizeInput
    "Tiny"   => size.tiny
    "Normal" => size.normal
    => size.small

var table dash = table.new(dashPos, 2, 9, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

dashRow(int row, string name, string value, color nameColor) =>
    table.cell(dash, 0, row, name, text_color = nameColor, text_size = dashSize, text_halign = text.align_left)
    table.cell(dash, 1, row, value, text_color = DASH_TEXT, text_size = dashSize, text_halign = text.align_right)

shareText(int part, int whole) =>
    whole > 0 ? str.tostring(part) + "  (" + str.tostring(math.round(part * 100.0 / whole)) + "%)" : str.tostring(part)

if showDashInput and barstate.islast
    int resolved = countTarget + countStop + countTimed
    table.cell(dash, 0, 0, "Three White Soldiers", text_color = DASH_HEADER, text_size = dashSize, text_halign = text.align_left)
    table.cell(dash, 1, 0, "Count", text_color = DASH_HEADER, text_size = dashSize, text_halign = text.align_right)
    dashRow(1, "Patterns", str.tostring(countSignals), bullColorInput)
    dashRow(2, "Pullback Filled", shareText(countFilled, countSignals), DASH_TEXT)
    dashRow(3, "No Pullback", shareText(countNoFill, countSignals), DASH_TEXT)
    dashRow(4, "Target Reached", shareText(countTarget, resolved), bullColorInput)
    dashRow(5, "Stopped", shareText(countStop, resolved), stopColorInput)
    dashRow(6, "Timed Out", str.tostring(countTimed), DASH_TEXT)
    dashRow(7, "Avg Result", resolved > 0 ? str.tostring(sumR / resolved, "#.##") + "R" : "-", DASH_TEXT)
    dashRow(8, "Warnings AB / ST", str.tostring(countAdvance) + " / " + str.tostring(countStalled), warnColorInput)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(soldiersSignal, "Three White Soldiers", "Three white soldiers on {{ticker}} ({{interval}}): three long white candles after a decline, each opening in the prior body and closing near its high")
alertcondition(swingCleared, "Soldiers Clear Swing High", "Three white soldiers on {{ticker}} ({{interval}}) closed above the prior swing high: candle evidence confirmed by structure")
alertcondition(fillEvent, "Pullback Entry Filled", "Price on {{ticker}} ({{interval}}) pulled back into a three white soldiers entry level")
alertcondition(targetEvent, "Target Reached", "A three white soldiers setup on {{ticker}} ({{interval}}) reached its target")
alertcondition(stopEvent, "Stopped Below Pattern", "A three white soldiers setup on {{ticker}} ({{interval}}) traded below the pattern low: the reversal failed")
alertcondition(advanceSignal, "Advance Block", "Advance block on {{ticker}} ({{interval}}): rising white candles with shrinking bodies and longer upper shadows, the advance is tiring")
alertcondition(stalledSignal, "Stalled Pattern", "Stalled pattern on {{ticker}} ({{interval}}): a small white body after two long soldiers, buyers hesitating")

//---------------------------------------------------------------------------------------------------------------------}
