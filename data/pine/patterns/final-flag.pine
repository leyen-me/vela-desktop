//@version=6
indicator("Final Flag"
  , shorttitle       = "Final Flag"
  , overlay          = true
  , format           = format.price
  , max_lines_count  = 500
  , max_labels_count = 500
  , max_boxes_count  = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
color BULL_COLOR    = #089981
color BEAR_COLOR    = #f23645
color NEUTRAL_COLOR = #787b86
color LABEL_BG      = #00000000

color DASH_BG     = #161616
color DASH_FRAME  = #2E2E2E
color DASH_HEADER = #808080
color DASH_TEXT   = #DBDBDB

int FLAG_FILL_TRANSP   = 85
int FLAG_BORDER_TRANSP = 40
int POSITION_BG_TRANSP = 88

string FAIL_INSIDE  = "Back Inside the Flag"
string FAIL_THROUGH = "Through the Flag"

string TARGET_LEG  = "Final Leg Start"
string TARGET_FLAG = "Flag Far Side"

string GROUP_TREND = "Late Trend"
string GROUP_FLAG  = "Flag"
string GROUP_FAIL  = "Breakout & Failure"
string GROUP_TRADE = "Trade Plan"
string GROUP_DASH  = "Dashboard"
string GROUP_STYLE = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
trendLengthInput = input.int(40, "Trend Lookback", minval = 10, maxval = 300, group = GROUP_TREND
  , tooltip = "Bars before the flag searched for the trend: its origin is the opposite extreme of this window, and the flag must sit at the trend's extreme with nothing beyond it in the window.")

minTravelInput = input.float(5, "Minimum Trend Travel (ATR)", minval = 1, maxval = 50, step = 0.5, group = GROUP_TREND
  , tooltip = "The trend into the flag must have travelled at least this many 14-bar ATRs from its origin. The final flag is a late pattern: it needs a protracted trend behind it.")

minPushesInput = input.int(2, "Minimum Prior Pushes", minval = 0, maxval = 10, group = GROUP_TREND
  , tooltip = "Pushes to a new trend extreme, each after a pullback, that the trend made before the flag. Several earlier pushes mark the flag as late; 0 accepts the first pause of a trend.")

minFlagBarsInput = input.int(3, "Flag Length", minval = 2, maxval = 50, inline = "flen", group = GROUP_FLAG)
maxFlagBarsInput = input.int(15, "to", minval = 3, maxval = 100, inline = "flen", group = GROUP_FLAG
  , tooltip = "Bars of sideways trading the flag may span. Three bars covers two consecutive inside bars, the smallest final flag; longer flags are tight trading ranges or small triangles.")

maxFlagRangeInput = input.float(2.5, "Maximum Flag Height (ATR)", minval = 0.3, maxval = 10, step = 0.1, group = GROUP_FLAG
  , tooltip = "Height of the flag from its highest high to its lowest low, in ATR. A final flag is a tight pause.")

maxDriftInput = input.float(40, "Maximum Drift (% of Height)", minval = 0, maxval = 100, step = 5, group = GROUP_FLAG
  , tooltip = "The flag is mostly horizontal: the fitted drift of its closes over its length may be at most this share of its height, in either direction.")

requireBreakInput = input.bool(true, "Require Trendline Break", group = GROUP_FLAG
  , tooltip = "The sideways flag must close beyond the trend's trendline, the line from the trend origin under every pullback up to the flag: the two-sided trading that marks a flag as late.")

failModeInput = input.string(FAIL_INSIDE, "Failure", options = [FAIL_INSIDE, FAIL_THROUGH], group = GROUP_FAIL
  , tooltip = "What counts as the reversal after the breakout. Back Inside the Flag is a close back inside it; Through the Flag waits for a close beyond its far side, later but more decisive.")

maxExtensionInput = input.float(1.5, "Maximum Breakout Extension (ATR)", minval = 0.1, maxval = 10, step = 0.1, group = GROUP_FAIL
  , tooltip = "Weak follow-through: the breakout may run at most this many ATRs beyond the flag before failing. A breakout that travels further and then reverses is a different setup.")

failBarsInput = input.int(5, "Failure Window (Bars)", minval = 1, maxval = 20, group = GROUP_FAIL
  , tooltip = "The breakout must fail within this many bars, the breakout bar included. A breakout that holds longer is an ordinary flag that worked.")

targetModeInput = input.string(TARGET_LEG, "Target", options = [TARGET_LEG, TARGET_FLAG], group = GROUP_TRADE
  , tooltip = "Final Leg Start plans for the two-legged correction: back to where the last push into the flag began. Flag Far Side aims only for the opposite edge of the flag.")

stopBufferInput = input.float(0.1, "Stop Buffer (ATR)", minval = 0, maxval = 2, step = 0.05, group = GROUP_TRADE
  , tooltip = "Distance beyond the breakout extreme, the invalidation, for the protective stop.")

failedFailureInput = input.int(2, "Failed Failure Window (Bars)", minval = 1, maxval = 10, group = GROUP_TRADE
  , tooltip = "If the reversal fails within this many bars and price trades back through the breakout extreme, the setup is a failed final flag: the trend is resuming, a with-trend signal.")

maxHoldInput = input.int(40, "Maximum Hold (Bars)", minval = 2, maxval = 300, group = GROUP_TRADE
  , tooltip = "A trade that reaches neither its target nor its stop within this many bars is closed and recorded as Timed Out.")

showDashInput = input.bool(true, "Show Dashboard", group = GROUP_DASH
  , tooltip = "The active or last final flag: the trend behind it, the flag, the breakout, the reversal and the trade.")

dashPosInput  = input.string("Top Right", "Position", options = ["Top Right", "Bottom Right", "Bottom Left", "Top Left"], group = GROUP_DASH)
dashSizeInput = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], group = GROUP_DASH)

showHeldInput = input.bool(false, "Keep Flags That Held", group = GROUP_STYLE
  , tooltip = "Keep the drawings of late flags whose breakout held, dimmed. Off, only flags whose breakout failed stay on the chart.")

bullColorInput    = input.color(BULL_COLOR, "Bull", inline = "colors", group = GROUP_STYLE)
bearColorInput    = input.color(BEAR_COLOR, "Bear", inline = "colors", group = GROUP_STYLE)
neutralColorInput = input.color(NEUTRAL_COLOR, "Flag", inline = "colors", group = GROUP_STYLE)

//---------------------------------------------------------------------------------------------------------------------}
// Types
//---------------------------------------------------------------------------------------------------------------------{
// dir 1 watches final bull flags (late in a bull trend, failing into a reversal down); dir -1 final bear flags
type FlagState
    int    dir
    // breakout being watched
    bool   watching    = false
    int    breakBar    = na
    float  breakExt    = na
    float  flagTop     = na
    float  flagBottom  = na
    int    flagStart   = na
    int    flagBars    = na
    float  legStart    = na
    float  origin      = na
    float  travelAtr   = na
    int    pushes      = 0
    box    flagBox
    label  flagLabel
    line   trendLine
    // trade
    bool   inTrade     = false
    int    tradeBar    = na
    float  entry       = na
    float  stop        = na
    float  target      = na
    bool   farSideHit  = false
    box    rewardBox
    box    riskBox
    string status      = "Scanning"

var FlagState bullState = FlagState.new(dir = 1)
var FlagState bearState = FlagState.new(dir = -1)
var FlagState lastState = na

//---------------------------------------------------------------------------------------------------------------------}
// Series
//---------------------------------------------------------------------------------------------------------------------{
int   LEG_LENGTH = math.max(int(trendLengthInput / 2), 5)

float atrValue  = ta.atr(14)
float trendHigh = ta.highest(high, trendLengthInput)
float trendLow  = ta.lowest(low, trendLengthInput)
float legLow    = ta.lowest(low, LEG_LENGTH)
float legHigh   = ta.highest(high, LEG_LENGTH)
int   trendLowAgo  = -ta.lowestbars(low, trendLengthInput)
int   trendHighAgo = -ta.highestbars(high, trendLengthInput)

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
getTablePosition(string positionText) =>
    switch positionText
        "Top Right"   => position.top_right
        "Top Left"    => position.top_left
        "Bottom Left" => position.bottom_left
        =>               position.bottom_right

getTableSize(string sizeText) =>
    switch sizeText
        "Tiny"   => size.tiny
        "Normal" => size.normal
        =>          size.small

// Least-squares drift of the closes over bars [1, n]: slope times length
closeDrift(int n) =>
    float sumX  = 0.
    float sumY  = 0.
    float sumXY = 0.
    float sumXX = 0.
    for k = 1 to n
        float x = n - k
        float y = close[k]
        sumX  += x
        sumY  += y
        sumXY += x * y
        sumXX += x * x
    float denom = n * sumXX - sumX * sumX
    float slope = denom != 0 ? (n * sumXY - sumX * sumY) / denom : 0.
    slope * (n - 1)

// Pushes to a new extreme after a pullback bar, counted over bars [from, to] bars ago (from > to)
countPushes(int d, int fromAgo, int toAgo) =>
    int   pushes  = 0
    bool  armed   = false
    float runExt  = d == 1 ? high[fromAgo] : low[fromAgo]
    for k = fromAgo - 1 to toAgo
        float ext = d == 1 ? high[k] : low[k]
        if d * (ext - runExt) > 0
            if armed
                pushes += 1
                armed  := false
            runExt := ext
        else if d * (ext - (d == 1 ? high[k + 1] : low[k + 1])) < 0
            armed := true
    pushes

// Does the flag close beyond the trend's trendline? The line is anchored at the trend origin and is the steepest line
// that stays under every low (over every high for a bear trend) up to the flag
flagBreaksTrendline(int d, int originAgo, int flagFromAgo, int flagToAgo) =>
    float anchor = d == 1 ? low[originAgo] : high[originAgo]
    float slope  = na
    if originAgo - 1 >= flagFromAgo + 1
        for k = originAgo - 1 to flagFromAgo + 1
            float m = ((d == 1 ? low[k] : high[k]) - anchor) / (originAgo - k)
            slope := na(slope) ? m : d == 1 ? math.min(slope, m) : math.max(slope, m)
    bool broke = false
    if not na(slope) and d * slope > 0
        for k = flagFromAgo to flagToAgo
            float tl = anchor + slope * (originAgo - k)
            if d * (close[k] - tl) < 0
                broke := true
    [broke, nz(slope), anchor]

// Advances one direction on a confirmed bar; returns [breakout, final flag, far side, target, stop, failed failure, held]
update(FlagState s, float atrValue, color dirColor, color oppColor) =>
    int  d           = s.dir
    bool breakEvent  = false
    bool finalEvent  = false
    bool farEvent    = false
    bool targetEvent = false
    bool stopEvent   = false
    bool ffEvent     = false
    bool heldEvent   = false
    float barExt  = d == 1 ? high : low
    float barBack = d == 1 ? low : high

    // -- open reversal trade ------------------------------------------------------------------------------------
    if s.inTrade and bar_index > s.tradeBar
        box.set_right(s.rewardBox, bar_index)
        box.set_right(s.riskBox, bar_index)
        bool stopped = d == 1 ? high >= s.stop : low <= s.stop
        if stopped
            stopEvent := true
            s.inTrade := false
            bool ff = bar_index - s.tradeBar <= failedFailureInput
            ffEvent  := ff
            s.status := ff ? "Failed final flag" : "Stopped"
            label.new(bar_index, barExt, ff ? "Failed Failure" : "Stopped", style = d == 1 ? label.style_label_down : label.style_label_up, color = ff ? dirColor : LABEL_BG, textcolor = ff ? color.white : dirColor, size = size.small
              , tooltip = ff ? "The reversal failed within " + str.tostring(failedFailureInput) + " bars and price traded back through the breakout extreme: a failed failure, the trend is resuming" : "Stop beyond the breakout extreme hit")
        else
            bool farNow = d == 1 ? low <= s.flagBottom : high >= s.flagTop
            if farNow and not s.farSideHit
                s.farSideHit := true
                farEvent     := true
            bool reached = d == 1 ? low <= s.target : high >= s.target
            if reached
                targetEvent := true
                s.inTrade   := false
                s.status    := "Target reached"
                label.new(bar_index, barBack, "Target", style = d == 1 ? label.style_label_up : label.style_label_down, color = LABEL_BG, textcolor = oppColor, size = size.small
                  , tooltip = "Target " + str.tostring(s.target, format.mintick) + " reached " + str.tostring(bar_index - s.tradeBar) + " bars after the reversal")
            else if bar_index - s.tradeBar >= maxHoldInput
                s.inTrade := false
                s.status  := "Timed out"

    // -- breakout watch: does it fail within the window? -------------------------------------------------------------
    if s.watching
        if d * (barExt - s.breakExt) > 0
            s.breakExt := barExt
        int   elapsed = bar_index - s.breakBar + 1
        float level   = failModeInput == FAIL_INSIDE ? (d == 1 ? s.flagTop : s.flagBottom) : (d == 1 ? s.flagBottom : s.flagTop)
        bool  failed  = d * (close - level) < 0
        bool  weak    = d * (s.breakExt - (d == 1 ? s.flagTop : s.flagBottom)) <= maxExtensionInput * atrValue
        if failed and elapsed <= failBarsInput and weak
            finalEvent := true
            s.watching := false
            s.status   := "Final flag"
            box.set_right(s.flagBox, bar_index)
            box.set_border_color(s.flagBox, color.new(oppColor, FLAG_BORDER_TRANSP))
            box.set_bgcolor(s.flagBox, color.new(oppColor, FLAG_FILL_TRANSP))
            label.set_text(s.flagLabel, "Final Flag")
            label.set_textcolor(s.flagLabel, oppColor)
            label.set_tooltip(s.flagLabel, "Late " + (d == 1 ? "bull" : "bear") + " flag: " + str.tostring(s.flagBars) + " bars after a trend of " + str.tostring(s.travelAtr, "#.#") + " ATR with " + str.tostring(s.pushes) + " earlier pushes. The breakout to a new extreme failed after " + str.tostring(elapsed) + (elapsed == 1 ? " bar" : " bars") + ".")
            if not s.inTrade
                float entryPrice = close
                float stopPrice  = s.breakExt + d * stopBufferInput * atrValue
                float targetPx   = targetModeInput == TARGET_LEG ? s.legStart : (d == 1 ? s.flagBottom : s.flagTop)
                if d * (entryPrice - targetPx) > 0
                    s.inTrade    := true
                    s.tradeBar   := bar_index
                    s.entry      := entryPrice
                    s.stop       := stopPrice
                    s.target     := targetPx
                    s.farSideHit := false
                    float risk = math.abs(stopPrice - entryPrice)
                    label.new(bar_index, barExt, "Reversal", style = d == 1 ? label.style_label_down : label.style_label_up, color = oppColor, textcolor = color.white, size = size.small
                      , tooltip = "Breakout failed back " + (failModeInput == FAIL_INSIDE ? "inside" : "through") + " the flag: entry " + str.tostring(entryPrice, format.mintick) + ", stop beyond the breakout extreme " + str.tostring(stopPrice, format.mintick) + ", target " + str.tostring(targetPx, format.mintick) + (risk > 0 ? " (" + str.tostring(math.abs(targetPx - entryPrice) / risk, "#.#") + "R)" : ""))
                    s.rewardBox := box.new(bar_index, math.max(entryPrice, targetPx), bar_index, math.min(entryPrice, targetPx), border_color = color.new(bullColorInput, 70), bgcolor = color.new(bullColorInput, POSITION_BG_TRANSP))
                    s.riskBox   := box.new(bar_index, math.max(entryPrice, stopPrice), bar_index, math.min(entryPrice, stopPrice), border_color = color.new(bearColorInput, 70), bgcolor = color.new(bearColorInput, POSITION_BG_TRANSP))
        else if elapsed >= failBarsInput or not weak
            heldEvent  := true
            s.watching := false
            s.status   := "Breakout held"
            if showHeldInput
                box.set_border_color(s.flagBox, color.new(neutralColorInput, 70))
                box.set_bgcolor(s.flagBox, color.new(neutralColorInput, 94))
                label.set_text(s.flagLabel, "Flag held")
                label.set_textcolor(s.flagLabel, color.new(neutralColorInput, 40))
            else
                box.delete(s.flagBox)
                label.delete(s.flagLabel)
                line.delete(s.trendLine)

    // -- a breakout to a new trend extreme out of a late, horizontal flag ----------------------------------------------
    float priorExt = d == 1 ? trendHigh[1] : trendLow[1]
    bool  newExt   = d * (barExt - priorExt) > 0
    if newExt and not s.watching and not s.inTrade and bar_index > trendLengthInput + maxFlagBarsInput + 2
        // The longest qualifying flag ending on the previous bar
        int   bestLen    = 0
        float bestTop    = na
        float bestBottom = na
        float top        = high[1]
        float bottom     = low[1]
        for len = 1 to maxFlagBarsInput
            top    := math.max(top, high[len])
            bottom := math.min(bottom, low[len])
            if len >= minFlagBarsInput
                float height  = top - bottom
                float flagExt = d == 1 ? top : bottom
                // Nothing beyond the flag in the trend window before it: the flag sits at the trend's extreme
                float before  = d == 1 ? trendHigh[len + 1] : trendLow[len + 1]
                bool  atExt   = d * (flagExt - before) >= -0.25 * atrValue
                bool  tight   = height <= maxFlagRangeInput * atrValue and height > 0
                if tight and atExt
                    bool flat = math.abs(closeDrift(len)) <= maxDriftInput / 100 * height
                    if flat
                        bestLen    := len
                        bestTop    := top
                        bestBottom := bottom
        if bestLen > 0
            float origin    = d == 1 ? trendLow[bestLen + 1] : trendHigh[bestLen + 1]
            int   originAgo = (d == 1 ? trendLowAgo[bestLen + 1] : trendHighAgo[bestLen + 1]) + bestLen + 1
            float flagExt   = d == 1 ? bestTop : bestBottom
            float travelAtr = math.abs(flagExt - origin) / atrValue
            int   pushes    = countPushes(d, bestLen + trendLengthInput, bestLen + 1)
            [tlBreak, tlSlope, tlAnchor] = flagBreaksTrendline(d, originAgo, bestLen, 1)
            bool  tlBroken  = not requireBreakInput or tlBreak
            if travelAtr >= minTravelInput and pushes >= minPushesInput and tlBroken
                // Start of the final leg: the last pullback extreme before the flag
                float legStart = d == 1 ? legLow[bestLen + 1] : legHigh[bestLen + 1]
                breakEvent   := true
                s.watching   := true
                s.breakBar   := bar_index
                s.breakExt   := barExt
                s.flagTop    := bestTop
                s.flagBottom := bestBottom
                s.flagStart  := bar_index - bestLen
                s.flagBars   := bestLen
                s.origin     := origin
                s.legStart   := legStart
                s.travelAtr  := travelAtr
                s.pushes     := pushes
                s.status     := "Breakout, watching"
                s.flagBox    := box.new(s.flagStart, bestTop, bar_index, bestBottom, border_color = color.new(neutralColorInput, FLAG_BORDER_TRANSP), bgcolor = color.new(neutralColorInput, FLAG_FILL_TRANSP))
                // The trend's trendline, from its origin under every pullback to the end of the flag that broke it
                s.trendLine  := tlSlope != 0 ? line.new(bar_index - originAgo, tlAnchor, bar_index - 1, tlAnchor + tlSlope * (originAgo - 1), color = dirColor, style = line.style_dashed) : line(na)
                s.flagLabel  := label.new(s.flagStart, d == 1 ? bestTop : bestBottom, "Late flag", style = d == 1 ? label.style_label_down : label.style_label_up, color = LABEL_BG, textcolor = neutralColorInput, size = size.small
                  , tooltip = "Late flag at the trend extreme: breakout under watch for a failure within " + str.tostring(failBarsInput) + " bars")
                // The breakout bar itself can close straight back inside: that is the fastest failure
                float level  = failModeInput == FAIL_INSIDE ? (d == 1 ? bestTop : bestBottom) : (d == 1 ? bestBottom : bestTop)
                if d * (close - level) < 0
                    s.watching := false
                    finalEvent := true
                    s.status   := "Final flag"
                    box.set_border_color(s.flagBox, color.new(oppColor, FLAG_BORDER_TRANSP))
                    box.set_bgcolor(s.flagBox, color.new(oppColor, FLAG_FILL_TRANSP))
                    label.set_text(s.flagLabel, "Final Flag")
                    label.set_textcolor(s.flagLabel, oppColor)
                    label.set_tooltip(s.flagLabel, "Late " + (d == 1 ? "bull" : "bear") + " flag: " + str.tostring(bestLen) + " bars after a trend of " + str.tostring(travelAtr, "#.#") + " ATR with " + str.tostring(pushes) + " earlier pushes. The breakout bar itself closed back inside the flag.")
                    float entryPrice = close
                    float stopPrice  = barExt + d * stopBufferInput * atrValue
                    float targetPx   = targetModeInput == TARGET_LEG ? legStart : (d == 1 ? bestBottom : bestTop)
                    if d * (entryPrice - targetPx) > 0
                        s.inTrade    := true
                        s.tradeBar   := bar_index
                        s.entry      := entryPrice
                        s.stop       := stopPrice
                        s.target     := targetPx
                        s.farSideHit := false
                        label.new(bar_index, barExt, "Reversal", style = d == 1 ? label.style_label_down : label.style_label_up, color = oppColor, textcolor = color.white, size = size.small
                          , tooltip = "The breakout bar closed back inside the flag: entry " + str.tostring(entryPrice, format.mintick) + ", stop " + str.tostring(stopPrice, format.mintick) + ", target " + str.tostring(targetPx, format.mintick))
                        s.rewardBox := box.new(bar_index, math.max(entryPrice, targetPx), bar_index, math.min(entryPrice, targetPx), border_color = color.new(bullColorInput, 70), bgcolor = color.new(bullColorInput, POSITION_BG_TRANSP))
                        s.riskBox   := box.new(bar_index, math.max(entryPrice, stopPrice), bar_index, math.min(entryPrice, stopPrice), border_color = color.new(bearColorInput, 70), bgcolor = color.new(bearColorInput, POSITION_BG_TRANSP))
    [breakEvent, finalEvent, farEvent, targetEvent, stopEvent, ffEvent, heldEvent]

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{

bool bullBreak  = false
bool bullFinal  = false
bool bullTarget = false
bool bullFF     = false
bool bearBreak  = false
bool bearFinal  = false
bool bearTarget = false
bool bearFF     = false

if barstate.isconfirmed and not na(atrValue)
    [b1, f1, x1, t1, s1, ff1, h1] = update(bullState, atrValue, bullColorInput, bearColorInput)
    bullBreak  := b1
    bullFinal  := f1
    bullTarget := t1
    bullFF     := ff1
    [b2, f2, x2, t2, s2, ff2, h2] = update(bearState, atrValue, bearColorInput, bullColorInput)
    bearBreak  := b2
    bearFinal  := f2
    bearTarget := t2
    bearFF     := ff2
    if b1 or f1 or bullState.inTrade
        lastState := bullState
    if b2 or f2 or bearState.inTrade
        lastState := bearState

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
var table dashTable = table.new(getTablePosition(dashPosInput), 2, 5, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

dashRow(int row, string labelText, string valueText, color valueColor, string textSize) =>
    table.cell(dashTable, 0, row, labelText, text_color = DASH_HEADER, text_halign = text.align_left, text_size = textSize)
    table.cell(dashTable, 1, row, valueText, text_color = valueColor, text_halign = text.align_right, text_size = textSize)

if showDashInput and barstate.islast
    string dashSize = getTableSize(dashSizeInput)
    table.cell(dashTable, 0, 0, "Final Flag", text_color = DASH_TEXT, text_halign = text.align_left, text_size = dashSize)
    if na(lastState)
        table.cell(dashTable, 1, 0, "Scanning", text_color = DASH_HEADER, text_halign = text.align_right, text_size = dashSize)
    else
        color dirColor = lastState.dir == 1 ? bullColorInput : bearColorInput
        color oppColor = lastState.dir == 1 ? bearColorInput : bullColorInput
        table.cell(dashTable, 1, 0, (lastState.dir == 1 ? "Bull trend: " : "Bear trend: ") + lastState.status, text_color = lastState.status == "Final flag" or lastState.status == "Target reached" ? oppColor : dirColor, text_halign = text.align_right, text_size = dashSize)
        dashRow(1, "Trend behind it", str.tostring(lastState.travelAtr, "#.#") + " ATR, " + str.tostring(lastState.pushes) + " pushes", DASH_TEXT, dashSize)
        dashRow(2, "Flag", str.tostring(lastState.flagBars) + " bars, " + str.tostring((lastState.flagTop - lastState.flagBottom) / atrValue, "#.#") + " ATR tall", DASH_TEXT, dashSize)
        string tradeText = "-"
        if not na(lastState.entry)
            float risk = math.abs(lastState.stop - lastState.entry)
            tradeText := str.tostring(lastState.entry, format.mintick) + (risk > 0 ? ", " + str.tostring(math.abs(lastState.target - lastState.entry) / risk, "#.#") + "R" : "")
        dashRow(3, "Reversal entry", tradeText, DASH_TEXT, dashSize)
        dashRow(4, "Invalidation", na(lastState.stop) ? "-" : str.tostring(lastState.stop, format.mintick), DASH_TEXT, dashSize)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullBreak or bearBreak, "Late Flag Breakout", "Final flag watch on {{ticker}} ({{interval}}): a late, horizontal flag broke out to a new trend extreme. Watch for a failure within the window.")
alertcondition(bullFinal, "Final Bull Flag", "Final bull flag on {{ticker}} ({{interval}}): the breakout to a new high failed back into the flag. Reversal short planned, stop above the breakout high.")
alertcondition(bearFinal, "Final Bear Flag", "Final bear flag on {{ticker}} ({{interval}}): the breakout to a new low failed back into the flag. Reversal long planned, stop below the breakout low.")
alertcondition(bullFF or bearFF, "Failed Final Flag", "Failed final flag on {{ticker}} ({{interval}}): the reversal failed and price traded back through the breakout extreme. The trend is resuming.")
alertcondition(bullTarget or bearTarget, "Target Reached", "Final flag reversal on {{ticker}} ({{interval}}): target reached.")

//---------------------------------------------------------------------------------------------------------------------}
