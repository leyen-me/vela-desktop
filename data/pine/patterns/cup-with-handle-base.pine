//@version=6
indicator("Cup-with-handle Base", shorttitle = "Cup-with-handle Base", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_polylines_count = 100)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

color BULL_COLOR        = #089981
color BEAR_COLOR        = #f23645
color NEUTRAL_COLOR     = #787b86
color TRANSPARENT_COLOR = #00000000

int MAX_SWINGS = 80

// Points per quarter arc of the drawn cup outline
int ARC_POINTS = 16

// The left-side high must be within this distance of the highest high of the uptrend window, so the cup starts at
// the top of the advance rather than partway down an earlier decline
float LEFT_HIGH_TOL_PCT = 5.0

int ZONE_FILL_TRANSP     = 88
int ZONE_BORDER_TRANSP   = 40
int HANDLE_FILL_TRANSP   = 90
int HANDLE_BORDER_TRANSP = 45
int PROFIT_FILL_TRANSP   = 92
int DIM_TRANSP           = 65

string CUP_GROUP    = 'Cup'
string HANDLE_GROUP = 'Handle'
string TREND_GROUP  = 'Prior Uptrend'
string BREAK_GROUP  = 'Breakout'
string TRADE_GROUP  = 'Trade Levels'
string DASH_GROUP   = 'Dashboard'
string STYLE_GROUP  = 'Style'

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

swingLengthInput = input.int(5, 'Swing Length', minval = 2, maxval = 30, group = CUP_GROUP, tooltip = 'Bars on each side a high must dominate to confirm a swing high. The left-side high and the right-side high of the cup are read from these swings, so the cup is recognized this many bars after its right side tops out. Drawings are anchored to the actual highs and do not move afterwards.')

minCupBarsInput  = input.int(30, 'Cup Length (bars)', minval = 10, maxval = 500, inline = 'cuplen', group = CUP_GROUP, tooltip = 'Minimum bars from the left-side high to the right-side high. The specification expects the cup itself to take about six weeks or more: roughly 30 daily bars, or 6 bars on a weekly chart.')
maxBaseBarsInput = input.int(325, '', minval = 20, maxval = 1000, inline = 'cuplen', group = CUP_GROUP, tooltip = 'Maximum span of the cup, from the left-side high to the right-side high. Bases far longer than about 65 weeks usually describe a damaged stock rather than a correction being absorbed.')

minDepthInput = input.float(12.0, 'Cup Depth (%)', minval = 1, maxval = 80, step = 0.5, inline = 'depth', group = CUP_GROUP, tooltip = 'Minimum correction from the left-side high to the cup low. Shallower pauses are flat bases rather than cups.')
maxDepthInput = input.float(35.0, '', minval = 1, maxval = 90, step = 0.5, inline = 'depth', group = CUP_GROUP, tooltip = 'Maximum correction from the left-side high to the cup low. Normal markets produce cups of about 12 to 33 percent; raise the cap in bear markets, where deeper cups are accepted.')

rimRecoveryInput = input.float(80.0, 'Right-side Recovery (%)', minval = 50, maxval = 100, step = 1, group = CUP_GROUP, tooltip = 'Share of the cup depth the right side must recover before a handle can start: 100% means back at the left-side high. A right side that stalls lower leaves the handle too deep in the base.')

rimOvershootInput = input.float(3.0, 'Right-side Overshoot (%)', minval = 0, maxval = 15, step = 0.5, group = CUP_GROUP, tooltip = 'How far the right-side high may exceed the left-side high and still count as the rim of the same cup.')

dwellInput = input.float(25.0, 'Minimum Bottom Dwell (%)', minval = 0, maxval = 90, step = 1, group = CUP_GROUP, tooltip = 'U-shape test: share of the cup bars that close in the lower third of the cup. A straight-legged V spends about a third of its time there and real V-bottoms less, while rounded cups linger. Set to 0 to accept any shape.')

minHandleBarsInput = input.int(5, 'Handle Length (bars)', minval = 1, maxval = 100, inline = 'hlen', group = HANDLE_GROUP, tooltip = 'Minimum bars between the right-side high and a valid breakout. The handle should take a week or more: 5 daily bars, 1 weekly bar.')
maxHandleBarsInput = input.int(30, '', minval = 2, maxval = 200, inline = 'hlen', group = HANDLE_GROUP, tooltip = 'Maximum bars the handle may run before the setup is dropped as stale.')

minHandleDepthInput = input.float(2.0, 'Handle Depth (%)', minval = 0, maxval = 30, step = 0.5, inline = 'hdepth', group = HANDLE_GROUP, tooltip = 'Minimum pullback from the right-side high for the handle to count as a real shakeout rather than a pause.')
maxHandleDepthInput = input.float(12.0, '', minval = 1, maxval = 40, step = 0.5, inline = 'hdepth', group = HANDLE_GROUP, tooltip = 'Maximum pullback from the right-side high. Handles deeper than roughly the low teens in percent are loose and invalidate the base.')

upperHalfInput = input.bool(true, 'Handle In Upper Half', group = HANDLE_GROUP, tooltip = 'Invalidate the base when the handle low falls into the lower half of the cup. A handle forming deep in the base is one of the classical defects.')

rejectWedgeInput = input.bool(true, 'Reject Up-wedging Handles', group = HANDLE_GROUP, tooltip = 'Refuse the breakout when the handle printed its low in its first third and then climbed into the pivot on rising lows, instead of drifting down. A handle that wedges upward fails to shake out weak holders.')

handleDryInput = input.bool(false, 'Require Handle Volume Dry-up', group = HANDLE_GROUP, tooltip = 'Only accept the breakout when average volume through the handle stayed below the volume average. Always graded in the dashboard; off by default because volume quality varies across markets. Ignored on symbols without volume data.')

uptrendFilterInput = input.bool(true, 'Prior Uptrend Filter', group = TREND_GROUP, tooltip = 'Require an advance worth basing after into the left-side high, as the base is defined for leading stocks correcting within an uptrend.')
uptrendLengthInput = input.int(130, 'Uptrend Window (bars)', minval = 10, maxval = 1000, group = TREND_GROUP, tooltip = 'Bars before the left-side high inspected for the prior advance; 130 daily bars is about six months.')
uptrendGainInput   = input.float(30.0, 'Minimum Prior Advance (%)', minval = 0, maxval = 1000, step = 1, group = TREND_GROUP, tooltip = 'Minimum rise from the lowest low of the uptrend window to the left-side high. The convention is a gain of about 30 percent or more before the base begins.')

pivotMarginInput = input.float(0.1, 'Pivot Margin (%)', minval = 0, maxval = 5, step = 0.05, group = BREAK_GROUP, tooltip = 'Margin added above the handle high to form the buy point, so the entry triggers on a decisive push through the pivot rather than a touch.')

minBaseBarsInput = input.int(35, 'Minimum Base Length (bars)', minval = 5, maxval = 500, group = BREAK_GROUP, tooltip = 'Minimum bars from the left-side high to the breakout, handle included. The base is generally expected to run at least about seven weeks: 35 daily bars, 7 weekly bars.')

volConfirmInput = input.bool(true, 'Breakout Volume Confirmation', group = BREAK_GROUP, tooltip = 'Require the close through the buy point to come on volume well above average. A close through the pivot without it is marked as a low-volume pivot and the base stays pending. Ignored on symbols without volume data.')
volLengthInput  = input.int(50, 'Volume Average Length', minval = 1, maxval = 200, group = BREAK_GROUP, tooltip = 'Length of the simple moving average of volume used for the breakout test and the handle dry-up grade.')
volMultInput    = input.float(1.4, 'Breakout Volume Multiplier', minval = 1, maxval = 10, step = 0.1, group = BREAK_GROUP, tooltip = 'The breakout bar volume must exceed the volume average multiplied by this factor; 1.4 matches the guideline of volume about 40 to 50 percent above average.')

buyZoneInput = input.float(5.0, 'Buy Zone (%)', minval = 0.5, maxval = 25, step = 0.5, group = TRADE_GROUP, tooltip = 'Extent of the buy zone above the buy point. A pending base that runs past this zone without a qualifying breakout is dropped as extended.')

stopEnableInput  = input.bool(true, 'Fixed Stop', inline = 'stop', group = TRADE_GROUP, tooltip = 'Track a fixed percentage stop below the buy point once the breakout confirms. The methodology caps the loss at 7 to 8 percent below the purchase price regardless of chart structure.')
stopPercentInput = input.float(7.0, '', minval = 0.5, maxval = 30, step = 0.5, inline = 'stop', group = TRADE_GROUP)

profitEnableInput = input.bool(true, 'Profit Zone (%)', inline = 'profit', group = TRADE_GROUP, tooltip = 'Shade the conventional profit-taking zone above the buy point, 20 to 25 percent by default. A planning reference, not a forecast: many breakouts never get there.')
profitLowInput    = input.float(20.0, '', minval = 1, maxval = 200, step = 1, inline = 'profit', group = TRADE_GROUP)
profitHighInput   = input.float(25.0, '', minval = 1, maxval = 200, step = 1, inline = 'profit', group = TRADE_GROUP)

monitorLengthInput = input.int(60, 'Post-Breakout Watch (bars)', minval = 5, maxval = 500, group = TRADE_GROUP, tooltip = 'Bars the buy zone, stop and profit zone are tracked after a confirmed breakout. The watch ends early when the stop or the profit zone is reached.')

showDashInput     = input.bool(true, 'Show Dashboard', group = DASH_GROUP, tooltip = 'Grade the active or last confirmed base: status, buy point, cup depth and shape, handle depth, position and volume, and base length.')
dashLocationInput = input.string('Bottom Right', 'Location', options = ['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left', 'Middle Right'], group = DASH_GROUP, tooltip = 'Position of the dashboard. Bottom right stays clear of the candles after an upside breakout.')
dashSizeInput     = input.string('Small', 'Size', options = ['Tiny', 'Small', 'Normal'], group = DASH_GROUP, tooltip = 'Text size of the dashboard.')

bullColorInput    = input.color(BULL_COLOR, 'Confirmed', inline = 'colors', group = STYLE_GROUP)
bearColorInput    = input.color(BEAR_COLOR, 'Stop', inline = 'colors', group = STYLE_GROUP)
neutralColorInput = input.color(NEUTRAL_COLOR, 'Pending', inline = 'colors', group = STYLE_GROUP)

showCupInput         = input.bool(true, 'Show Cup Outline', group = STYLE_GROUP, tooltip = 'Draw the cup as a rounded outline through the left-side high, the cup low and the right-side high.')
showHandleInput      = input.bool(true, 'Show Handle', group = STYLE_GROUP, tooltip = 'Shade the handle range from the right-side high to its lowest low.')
showLevelsInput      = input.bool(true, 'Show Buy Point & Zones', group = STYLE_GROUP, tooltip = 'Draw the buy point, the buy zone, the stop and the profit zone.')
showInvalidatedInput = input.bool(false, 'Keep Invalidated Bases', group = STYLE_GROUP, tooltip = 'Keep the drawings of invalidated bases on the chart, dimmed, instead of removing them.')

float effMaxDepth      = math.max(minDepthInput, maxDepthInput)
float effMaxHandle     = math.max(minHandleDepthInput, maxHandleDepthInput)
int   effMaxHandleBars = math.max(minHandleBarsInput, maxHandleBarsInput)
float effProfitHigh    = math.max(profitLowInput, profitHighInput)
color DIM_COLOR        = color.new(neutralColorInput, DIM_TRANSP)

//---------------------------------------------------------------------------------------------------------------------}
// Variables
//---------------------------------------------------------------------------------------------------------------------{

// Per-bar history indexed by bar_index, so any span of the base is an exact lookup
var array<float> highArray  = array.new_float()
var array<float> lowArray   = array.new_float()
var array<float> closeArray = array.new_float()
var array<float> volArray   = array.new_float()

var array<int>   swingBarArray   = array.new_int()
var array<float> swingPriceArray = array.new_float()

// Active base
var bool  patternActive = false
var int   lhBar         = na
var float lhPrice       = na
var int   cupLowBar     = na
var float cupLowPrice   = na
var int   rimBar        = na
var float rimPrice      = na
var float handleLow     = na
var int   handleLowBar  = na
var float buyPoint      = na
var float dwellPct      = na
var bool  weakMarked    = false
var int   pivotTestBar  = na
var bool  handleSet     = false

// Last graded base (kept for the dashboard after a breakout)
var float gradeDepth      = na
var int   gradeLength     = na
var float gradeDwell      = na
var float gradeHandle     = na
var float gradeHandlePos  = na
var float gradeHandleVol  = na
var float gradeBreakVol   = na
var float gradeBuy        = na
var string statusText     = 'Scanning'

// Post-breakout watch
var bool  riskActive    = false
var float riskBuy       = na
var float riskStop      = na
var float riskProfitLow = na
var int   riskStartBar  = na

// Drawings of the active base
var polyline cupLineId     = na
var label    titleLabelId  = na
var label    depthLabelId  = na
var box      handleBoxId   = na
var label    handleLabelId = na
var line     buyLineId     = na
var label    buyLabelId    = na
var label    weakLabelId   = na

// Drawings of the post-breakout watch
var box   zoneBoxId     = na
var line  stopLineId    = na
var label stopLabelId   = na
var box   profitBoxId   = na
var label profitLabelId = na

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{

// Rounded cup outline: a quarter ellipse down the left side (steep at the lip, flat at the bottom) and its mirror up
// the right side, passing exactly through the left-side high, the cup low and the right-side high
cupPoints(int x0, float y0, int xm, float ym, int x1, float y1) =>
    array<chart.point> points = array.new<chart.point>()
    for i = 0 to ARC_POINTS
        float phi = math.pi / 2 * i / ARC_POINTS
        array.push(points, chart.point.from_index(int(math.round(x0 + (xm - x0) * (1 - math.cos(phi)))), y0 - (y0 - ym) * math.sin(phi)))
    for i = 1 to ARC_POINTS
        float phi = math.pi / 2 * i / ARC_POINTS
        array.push(points, chart.point.from_index(int(math.round(xm + (x1 - xm) * math.sin(phi))), ym + (y1 - ym) * (1 - math.cos(phi))))
    points

drawCup(color lineColor) =>
    polyline result = na
    if showCupInput
        result := polyline.new(cupPoints(lhBar, lhPrice, cupLowBar, cupLowPrice, rimBar, rimPrice), line_color = lineColor, line_width = 2)
    result

// Average volume of a bar span relative to the current volume average
spanVolumeRatio(int fromBar, int toBar, float volAvg) =>
    float total = 0.0
    int   count = 0
    if fromBar <= toBar
        for b = fromBar to toBar
            total += array.get(volArray, b)
            count += 1
    count > 0 and volAvg > 0 ? total / count / volAvg : na

getTablePosition(string positionText) =>
    switch positionText
        'Top Left'     => position.top_left
        'Top Right'    => position.top_right
        'Bottom Left'  => position.bottom_left
        'Middle Right' => position.middle_right
        =>                position.bottom_right

getTableSize(string sizeText) =>
    switch sizeText
        'Tiny'   => size.tiny
        'Normal' => size.normal
        =>          size.small

//---------------------------------------------------------------------------------------------------------------------}
// History & Swings
//---------------------------------------------------------------------------------------------------------------------{

array.push(highArray, high)
array.push(lowArray, low)
array.push(closeArray, close)
array.push(volArray, nz(volume))

float volSma   = ta.sma(nz(volume), volLengthInput)
bool  hasVol   = volSma > 0
float swingHigh = ta.pivothigh(high, swingLengthInput, swingLengthInput)

bool detectedEvent    = false
bool handleEvent      = false
bool breakoutEvent    = false
bool weakVolumeEvent  = false
bool invalidatedEvent = false
bool stopHitEvent     = false
bool profitEvent      = false

// Removes the active base drawings, or dims them in place when invalidated history is kept
clearBase(bool keepDimmed) =>
    if keepDimmed
        if not na(cupLineId)
            polyline.delete(cupLineId)
            if showCupInput
                polyline.new(cupPoints(lhBar, lhPrice, cupLowBar, cupLowPrice, rimBar, rimPrice), line_color = DIM_COLOR, line_style = line.style_dotted)
        if not na(titleLabelId)
            label.set_textcolor(titleLabelId, DIM_COLOR)
        if not na(depthLabelId)
            label.set_textcolor(depthLabelId, DIM_COLOR)
        if not na(handleBoxId)
            box.set_border_color(handleBoxId, DIM_COLOR)
            box.set_bgcolor(handleBoxId, color.new(neutralColorInput, 96))
        if not na(handleLabelId)
            label.set_textcolor(handleLabelId, DIM_COLOR)
        if not na(buyLineId)
            line.set_color(buyLineId, DIM_COLOR)
        if not na(weakLabelId)
            label.set_textcolor(weakLabelId, DIM_COLOR)
        label.delete(buyLabelId)
    else
        polyline.delete(cupLineId)
        label.delete(titleLabelId)
        label.delete(depthLabelId)
        box.delete(handleBoxId)
        label.delete(handleLabelId)
        line.delete(buyLineId)
        label.delete(buyLabelId)
        label.delete(weakLabelId)

//---------------------------------------------------------------------------------------------------------------------}
// Base Management
//---------------------------------------------------------------------------------------------------------------------{

if barstate.isconfirmed
    int confirmBar = bar_index - swingLengthInput

    // -- register the new swing high, then either move the rim of the active base or look for a new cup ---------------
    if not na(swingHigh)
        array.push(swingBarArray, confirmBar)
        array.push(swingPriceArray, swingHigh)
        if array.size(swingBarArray) > MAX_SWINGS
            array.shift(swingBarArray)
            array.shift(swingPriceArray)

        if patternActive and swingHigh > rimPrice and swingHigh <= lhPrice * (1 + rimOvershootInput / 100)
            // A higher right-side high inside the overshoot band restarts the handle from the new rim
            rimBar       := confirmBar
            rimPrice     := swingHigh
            buyPoint     := rimPrice * (1 + pivotMarginInput / 100)
            handleLow    := array.get(lowArray, bar_index)
            handleLowBar := bar_index
            for b = confirmBar + 1 to bar_index
                if array.get(lowArray, b) <= handleLow
                    handleLow    := array.get(lowArray, b)
                    handleLowBar := b
            weakMarked   := false
            pivotTestBar := na
            handleSet    := false
            label.delete(weakLabelId)
            weakLabelId := na
            if not na(cupLineId)
                polyline.delete(cupLineId)
            cupLineId := drawCup(neutralColorInput)
            if not na(buyLineId)
                line.set_xy1(buyLineId, rimBar, buyPoint)
                line.set_xy2(buyLineId, bar_index, buyPoint)
                label.set_xy(buyLabelId, bar_index, buyPoint)
                label.set_text(buyLabelId, 'Buy ' + str.tostring(buyPoint, format.mintick))
            if not na(handleBoxId)
                box.set_lefttop(handleBoxId, rimBar, rimPrice)
                box.set_rightbottom(handleBoxId, bar_index, handleLow)
            if not na(handleLabelId)
                label.set_xy(handleLabelId, handleLowBar, handleLow)

        else if not patternActive
            // Left-side high: the most recent earlier swing high at or above the rim band
            int   swingCount = array.size(swingBarArray)
            int   leftBar    = na
            float leftPrice  = na
            int   leftIdx    = na
            if swingCount >= 2
                for i = swingCount - 2 to 0
                    int   b = array.get(swingBarArray, i)
                    float p = array.get(swingPriceArray, i)
                    if confirmBar - b > maxBaseBarsInput
                        break
                    if p * (1 + rimOvershootInput / 100) >= swingHigh
                        leftBar   := b
                        leftPrice := p
                        leftIdx   := i
                        break

            if not na(leftBar) and confirmBar - leftBar >= minCupBarsInput
                // Cup low and the dominant left side: no bar between the two highs may trade above the left-side high
                float lowPrice = array.get(lowArray, leftBar)
                int   lowBar   = leftBar
                float innerMax = 0.0
                for b = leftBar + 1 to confirmBar - 1
                    innerMax := math.max(innerMax, array.get(highArray, b))
                    if array.get(lowArray, b) < lowPrice
                        lowPrice := array.get(lowArray, b)
                        lowBar   := b

                // Walk the left lip back to the top of the advance when an older, higher swing sits in the same topping area
                if leftIdx > 0
                    float midLevel = lowPrice + (leftPrice - lowPrice) / 2
                    for i = leftIdx - 1 to 0
                        int   b = array.get(swingBarArray, i)
                        float p = array.get(swingPriceArray, i)
                        if confirmBar - b > maxBaseBarsInput or p <= leftPrice
                            break
                        float gapLow = p
                        if leftBar - b > 1
                            for k = b + 1 to leftBar - 1
                                gapLow := math.min(gapLow, array.get(lowArray, k))
                        if gapLow < midLevel
                            break
                        leftBar   := b
                        leftPrice := p

                float depthPct    = 100 * (leftPrice - lowPrice) / leftPrice
                float recoveryPct = leftPrice > lowPrice ? 100 * (swingHigh - lowPrice) / (leftPrice - lowPrice) : 0.0

                bool spanOk     = confirmBar - leftBar >= minCupBarsInput and confirmBar - leftBar <= maxBaseBarsInput
                bool dominantOk = innerMax < leftPrice
                bool depthOk    = depthPct >= minDepthInput and depthPct <= effMaxDepth
                bool rimOk      = recoveryPct >= rimRecoveryInput and swingHigh <= leftPrice * (1 + rimOvershootInput / 100)

                // U-shape: share of cup bars closing in the lower third of the cup
                float lowerThird = lowPrice + (leftPrice - lowPrice) / 3
                int   dwellCount = 0
                for b = leftBar to confirmBar
                    if array.get(closeArray, b) <= lowerThird
                        dwellCount += 1
                float dwell   = 100.0 * dwellCount / (confirmBar - leftBar + 1)
                bool  shapeOk = dwell >= dwellInput

                // Prior advance into the left-side high, which must sit at the top of that advance
                bool uptrendOk = not uptrendFilterInput
                if uptrendFilterInput and leftBar - uptrendLengthInput >= 0
                    float windowLow  = leftPrice
                    float windowHigh = 0.0
                    for b = leftBar - uptrendLengthInput to leftBar
                        windowLow  := math.min(windowLow, array.get(lowArray, b))
                        windowHigh := math.max(windowHigh, array.get(highArray, b))
                    uptrendOk := windowLow > 0 and 100 * (leftPrice / windowLow - 1) >= uptrendGainInput and leftPrice >= windowHigh * (1 - LEFT_HIGH_TOL_PCT / 100)

                if spanOk and dominantOk and depthOk and rimOk and shapeOk and uptrendOk
                    detectedEvent := true
                    patternActive := true
                    lhBar         := leftBar
                    lhPrice       := leftPrice
                    cupLowBar     := lowBar
                    cupLowPrice   := lowPrice
                    rimBar        := confirmBar
                    rimPrice      := swingHigh
                    dwellPct      := dwell
                    buyPoint      := rimPrice * (1 + pivotMarginInput / 100)
                    weakMarked    := false
                    pivotTestBar  := na
                    handleSet     := false
                    statusText    := 'Handle forming'

                    handleLow    := array.get(lowArray, bar_index)
                    handleLowBar := bar_index
                    for b = confirmBar + 1 to bar_index
                        if array.get(lowArray, b) <= handleLow
                            handleLow    := array.get(lowArray, b)
                            handleLowBar := b

                    gradeDepth     := depthPct
                    gradeDwell     := dwell
                    gradeBreakVol  := na
                    gradeBuy       := buyPoint

                    cupLineId    := drawCup(neutralColorInput)
                    titleLabelId := label.new(lhBar, lhPrice, 'Cup with Handle', style = label.style_label_down, color = TRANSPARENT_COLOR, textcolor = neutralColorInput, size = size.small)
                    depthLabelId := label.new(cupLowBar, cupLowPrice, 'Cup -' + str.tostring(depthPct, '#.#') + '%', style = label.style_label_up, color = TRANSPARENT_COLOR, textcolor = neutralColorInput, size = size.small, tooltip = 'Cup depth from the left-side high: ' + str.tostring(depthPct, '#.##') + '%\nBottom dwell (U-shape): ' + str.tostring(dwell, '#') + '% of the cup bars closed in its lower third\nCup length: ' + str.tostring(confirmBar - leftBar) + ' bars')
                    if showHandleInput
                        handleBoxId   := box.new(rimBar, rimPrice, bar_index, handleLow, border_color = color.new(neutralColorInput, HANDLE_BORDER_TRANSP), border_style = line.style_dashed, bgcolor = color.new(neutralColorInput, HANDLE_FILL_TRANSP))
                        handleLabelId := label.new(handleLowBar, handleLow, 'Handle', style = label.style_label_up, color = TRANSPARENT_COLOR, textcolor = neutralColorInput, size = size.tiny)
                    if showLevelsInput
                        buyLineId  := line.new(rimBar, buyPoint, bar_index, buyPoint, color = neutralColorInput, style = line.style_dashed)
                        buyLabelId := label.new(bar_index, buyPoint, 'Buy ' + str.tostring(buyPoint, format.mintick), style = label.style_label_left, color = TRANSPARENT_COLOR, textcolor = neutralColorInput, size = size.small)

    // -- handle tracking and breakout --------------------------------------------------------------------------------
    if patternActive and not detectedEvent
        if low < handleLow
            handleLow    := low
            handleLowBar := bar_index

        int   handleBars  = bar_index - rimBar
        float handleDepth = 100 * (rimPrice - handleLow) / rimPrice
        float cupMid      = cupLowPrice + (lhPrice - cupLowPrice) / 2
        bool  qualified   = handleBars >= minHandleBarsInput and handleDepth >= minHandleDepthInput

        if qualified and not handleSet
            handleSet   := true
            handleEvent := true
            statusText  := 'Buy point set'

        if not na(handleBoxId)
            box.set_right(handleBoxId, bar_index)
            box.set_bottom(handleBoxId, handleLow)
        if not na(handleLabelId)
            label.set_xy(handleLabelId, handleLowBar, handleLow)
            label.set_text(handleLabelId, 'Handle -' + str.tostring(handleDepth, '#.#') + '%')
        if not na(buyLineId)
            line.set_x2(buyLineId, bar_index)
            label.set_x(buyLabelId, bar_index)

        bool tooDeep = handleDepth > effMaxHandle
        bool lowerHalf = upperHalfInput and handleLow < cupMid
        bool stale = handleBars > effMaxHandleBars
        bool crossUp = close > buyPoint and close[1] <= buyPoint
        // After a low-volume test of the pivot, a later close inside the buy zone on qualifying volume still confirms
        bool retest  = weakMarked and close > buyPoint and close <= buyPoint * (1 + buyZoneInput / 100)
        // With a handle in place, running past the buy zone without a qualifying breakout ends the base; before the
        // handle exists, only a run beyond the rim band does (a higher right-side high there just moves the rim)
        bool extended = qualified ? close > buyPoint * (1 + buyZoneInput / 100) : close > lhPrice * (1 + rimOvershootInput / 100)

        bool   breakoutNow = false
        bool   failNow     = tooDeep or lowerHalf or stale
        string failReason  = tooDeep ? 'handle deeper than ' + str.tostring(effMaxHandle, '#.#') + '%' : lowerHalf ? 'handle fell into the lower half of the cup' : stale ? 'handle ran longer than ' + str.tostring(effMaxHandleBars) + ' bars' : ''

        if not failNow and (crossUp or retest) and qualified
            if na(pivotTestBar)
                pivotTestBar := bar_index
            float handleVol = spanVolumeRatio(rimBar + 1, pivotTestBar - 1, volSma)
            // Up-wedging: the handle printed its low in its first third and the lows rose from there into the pivot
            bool  wedgeOk   = not rejectWedgeInput or (handleLowBar - rimBar) * 3 >= pivotTestBar - rimBar
            bool  dryOk     = not handleDryInput or not hasVol or (not na(handleVol) and handleVol < 1)
            bool  lengthOk  = bar_index - lhBar >= minBaseBarsInput
            bool  volumeOk  = not volConfirmInput or not hasVol or nz(volume) > volMultInput * volSma

            if not wedgeOk or not dryOk or not lengthOk
                failNow    := true
                failReason := not wedgeOk ? 'handle wedged upward into the pivot' : not dryOk ? 'handle volume did not dry up' : 'base shorter than ' + str.tostring(minBaseBarsInput) + ' bars at the breakout'
            else if volumeOk
                breakoutNow := true
                gradeHandle    := handleDepth
                gradeHandlePos := 100 * (handleLow - cupLowPrice) / (lhPrice - cupLowPrice)
                gradeHandleVol := handleVol
                gradeBreakVol  := hasVol ? nz(volume) / volSma : na
                gradeLength    := bar_index - lhBar
            else if not weakMarked
                weakMarked      := true
                weakVolumeEvent := true
                weakLabelId := label.new(bar_index, high, 'Low-volume pivot', style = label.style_label_down, color = TRANSPARENT_COLOR, textcolor = neutralColorInput, size = size.tiny, tooltip = 'Close through the buy point on ' + (hasVol ? str.tostring(nz(volume) / volSma, '#.##') + 'x' : 'unknown') + ' average volume, below the ' + str.tostring(volMultInput, '#.##') + 'x requirement. The base stays pending.')
        else if not failNow and extended
            failNow    := true
            failReason := qualified ? 'price extended past the buy zone without a qualifying breakout' : 'the right side cleared the left-side high without forming a handle'

        if breakoutNow
            breakoutEvent := true
            patternActive := false
            statusText    := 'Breakout'

            // Recolor the confirmed base and release its drawings so they persist as history
            if not na(cupLineId)
                polyline.delete(cupLineId)
            drawCup(bullColorInput)
            if not na(titleLabelId)
                label.set_textcolor(titleLabelId, bullColorInput)
            if not na(depthLabelId)
                label.set_textcolor(depthLabelId, bullColorInput)
            if not na(handleBoxId)
                box.set_right(handleBoxId, bar_index - 1)
                box.set_border_color(handleBoxId, color.new(bullColorInput, HANDLE_BORDER_TRANSP))
                box.set_bgcolor(handleBoxId, color.new(bullColorInput, HANDLE_FILL_TRANSP))
            if not na(handleLabelId)
                label.set_textcolor(handleLabelId, bullColorInput)
            if not na(buyLineId)
                line.set_x2(buyLineId, bar_index)
                line.set_color(buyLineId, bullColorInput)
                line.set_style(buyLineId, line.style_solid)
            label.delete(buyLabelId)
            label.delete(weakLabelId)

            string breakTip = 'Close through the buy point ' + str.tostring(buyPoint, format.mintick) + (hasVol ? ' on ' + str.tostring(nz(volume) / volSma, '#.##') + 'x average volume' : '') + (weakMarked ? ' after an earlier low-volume test of the pivot' : '') + '\nBase length: ' + str.tostring(bar_index - lhBar) + ' bars, cup depth ' + str.tostring(gradeDepth, '#.#') + '%, handle depth ' + str.tostring(handleDepth, '#.#') + '%'
            label.new(bar_index, low, 'Breakout', style = label.style_label_up, color = bullColorInput, textcolor = chart.bg_color, size = size.small, tooltip = breakTip)

            // Close any watch still running from an earlier base
            riskActive    := true
            riskBuy       := buyPoint
            riskStop      := buyPoint * (1 - stopPercentInput / 100)
            riskProfitLow := buyPoint * (1 + profitLowInput / 100)
            riskStartBar  := bar_index

            if showLevelsInput
                zoneBoxId := box.new(bar_index, riskBuy * (1 + buyZoneInput / 100), bar_index, riskBuy, border_color = color.new(bullColorInput, ZONE_BORDER_TRANSP), bgcolor = color.new(bullColorInput, ZONE_FILL_TRANSP))
                if stopEnableInput
                    stopLineId  := line.new(bar_index, riskStop, bar_index, riskStop, color = bearColorInput, style = line.style_dotted)
                    stopLabelId := label.new(bar_index, riskStop, 'Stop ' + str.tostring(riskStop, format.mintick), style = label.style_label_left, color = TRANSPARENT_COLOR, textcolor = bearColorInput, size = size.small)
                if profitEnableInput
                    profitBoxId   := box.new(bar_index, riskBuy * (1 + effProfitHigh / 100), bar_index, riskProfitLow, border_color = color.new(bullColorInput, ZONE_BORDER_TRANSP), border_style = line.style_dashed, bgcolor = color.new(bullColorInput, PROFIT_FILL_TRANSP))
                    profitLabelId := label.new(bar_index, riskBuy * (1 + effProfitHigh / 100), '+' + str.tostring(profitLowInput, '#.#') + '% to +' + str.tostring(effProfitHigh, '#.#') + '%', style = label.style_label_left, color = TRANSPARENT_COLOR, textcolor = bullColorInput, size = size.small)

            cupLineId     := na
            titleLabelId  := na
            depthLabelId  := na
            handleBoxId   := na
            handleLabelId := na
            buyLineId     := na
            buyLabelId    := na
            weakLabelId   := na
        else if failNow
            invalidatedEvent := true
            patternActive    := false
            statusText       := 'Invalidated'
            clearBase(showInvalidatedInput)
            if showInvalidatedInput
                label.new(bar_index, high, 'Invalidated', style = label.style_label_down, color = TRANSPARENT_COLOR, textcolor = DIM_COLOR, size = size.tiny, tooltip = 'Base invalidated: ' + failReason)
            cupLineId     := na
            titleLabelId  := na
            depthLabelId  := na
            handleBoxId   := na
            handleLabelId := na
            buyLineId     := na
            buyLabelId    := na
            weakLabelId   := na

    // -- post-breakout watch: buy zone, fixed stop and profit zone ----------------------------------------------------
    if riskActive and bar_index > riskStartBar
        if not na(zoneBoxId)
            box.set_right(zoneBoxId, bar_index)
        if not na(stopLineId)
            line.set_x2(stopLineId, bar_index)
            label.set_x(stopLabelId, bar_index)
        if not na(profitBoxId)
            box.set_right(profitBoxId, bar_index)
            label.set_x(profitLabelId, bar_index)

        bool stopHit   = stopEnableInput and close < riskStop
        bool profitHit = profitEnableInput and high >= riskProfitLow
        bool watchOver = bar_index - riskStartBar >= monitorLengthInput

        if stopHit
            stopHitEvent := true
            riskActive   := false
            statusText   := 'Stop hit'
            label.new(bar_index, high, 'Stop hit', style = label.style_label_down, color = bearColorInput, textcolor = chart.bg_color, size = size.small, tooltip = 'Close below the fixed stop ' + str.tostring(riskStop, format.mintick) + ', ' + str.tostring(stopPercentInput, '#.#') + '% under the buy point')
        else if profitHit
            profitEvent := true
            riskActive  := false
            statusText  := 'Profit zone'
            label.new(bar_index, high, '+' + str.tostring(profitLowInput, '#.#') + '%', style = label.style_label_down, color = bullColorInput, textcolor = chart.bg_color, size = size.small, tooltip = 'Price reached the profit zone, ' + str.tostring(profitLowInput, '#.#') + '% above the buy point ' + str.tostring(riskBuy, format.mintick))
        else if watchOver
            riskActive := false
            statusText := 'Watch ended'

        if not riskActive
            zoneBoxId     := na
            stopLineId    := na
            stopLabelId   := na
            profitBoxId   := na
            profitLabelId := na

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{

var table dashTable = table.new(getTablePosition(dashLocationInput), 2, 9, bgcolor = color.new(chart.bg_color, 25), frame_color = color.new(chart.fg_color, 85), frame_width = 1)

// One label/value row of the dashboard
dashRow(int row, string labelText, string valueText, color valueColor, string textSize) =>
    table.cell(dashTable, 0, row, labelText, text_color = color.new(chart.fg_color, 40), text_size = textSize, text_halign = text.align_left)
    table.cell(dashTable, 1, row, valueText, text_color = valueColor, text_size = textSize, text_halign = text.align_right)

if showDashInput and barstate.islast
    string dashSize  = getTableSize(dashSizeInput)
    color  fadedText = color.new(chart.fg_color, 40)

    // Live readings for a pending base, the graded values of the last confirmed one otherwise
    float liveHandle    = patternActive ? 100 * (rimPrice - handleLow) / rimPrice : gradeHandle
    float liveHandlePos = patternActive ? 100 * (handleLow - cupLowPrice) / (lhPrice - cupLowPrice) : gradeHandlePos
    float liveHandleVol = patternActive ? spanVolumeRatio(rimBar + 1, bar_index, volSma) : gradeHandleVol
    int   liveLength    = patternActive ? bar_index - lhBar : gradeLength
    float liveBuy       = patternActive ? buyPoint : riskActive ? riskBuy : gradeBuy

    color statusColor = patternActive ? neutralColorInput : statusText == 'Breakout' or statusText == 'Profit zone' ? bullColorInput : statusText == 'Stop hit' or statusText == 'Invalidated' ? bearColorInput : fadedText
    color hVolColor   = hasVol and not na(liveHandleVol) ? (liveHandleVol < 1 ? bullColorInput : bearColorInput) : fadedText

    table.cell(dashTable, 0, 0, 'Cup with Handle', text_color = chart.fg_color, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 0, statusText, text_color = statusColor, text_size = dashSize, text_halign = text.align_right)
    dashRow(1, 'Buy point', not na(liveBuy) ? str.tostring(liveBuy, format.mintick) : '-', chart.fg_color, dashSize)
    dashRow(2, 'Cup depth', not na(gradeDepth) ? '-' + str.tostring(gradeDepth, '#.#') + '%' : '-', chart.fg_color, dashSize)
    dashRow(3, 'Bottom dwell', not na(gradeDwell) ? str.tostring(gradeDwell, '#') + '%' : '-', chart.fg_color, dashSize)
    dashRow(4, 'Handle depth', not na(liveHandle) ? '-' + str.tostring(liveHandle, '#.#') + '%' : '-', chart.fg_color, dashSize)
    dashRow(5, 'Handle position', not na(liveHandlePos) ? str.tostring(liveHandlePos, '#') + '% of base' : '-', chart.fg_color, dashSize)
    dashRow(6, 'Handle volume', hasVol and not na(liveHandleVol) ? str.tostring(liveHandleVol, '#.##') + 'x' + (liveHandleVol < 1 ? ' dry' : ' heavy') : '-', hVolColor, dashSize)
    dashRow(7, 'Base length', not na(liveLength) ? str.tostring(liveLength) + ' bars' : '-', chart.fg_color, dashSize)
    dashRow(8, 'Breakout volume', not na(gradeBreakVol) ? str.tostring(gradeBreakVol, '#.##') + 'x avg' : '-', chart.fg_color, dashSize)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(detectedEvent, 'Cup Detected', 'A cup completed: U-shaped correction of qualifying depth and length after a prior advance, with the right side recovered near the left-side high. The handle is now forming.')
alertcondition(handleEvent, 'Buy Point Set', 'The handle has run its minimum length and depth: the buy point is set just above the handle high.')
alertcondition(breakoutEvent, 'Breakout Confirmed', 'Price closed through the cup-with-handle buy point on qualifying volume.')
alertcondition(weakVolumeEvent, 'Pivot Cleared Without Volume', 'Price closed through the cup-with-handle buy point without the required volume expansion; the base stays pending.')
alertcondition(invalidatedEvent, 'Base Invalidated', 'The cup-with-handle base was invalidated: handle too deep, in the lower half, wedging up or stale, or price extended past the buy zone without a qualifying breakout.')
alertcondition(stopHitEvent, 'Stop Hit', 'Price closed below the fixed stop under the cup-with-handle buy point.')
alertcondition(profitEvent, 'Profit Zone Reached', 'Price reached the profit zone above the cup-with-handle buy point.')

//---------------------------------------------------------------------------------------------------------------------}
