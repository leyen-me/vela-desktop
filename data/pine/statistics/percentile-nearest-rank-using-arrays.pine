//@version=6
indicator("Percentile Nearest Rank Using Arrays",overlay=true)
length = input.int(15)
p      = input.int(50, "Percentage", minval=0, maxval=100)
src    = input.source(close)
//----
win = array.new_float(0)
for i = 0 to length-1
    array.push(win,src[i])
array.sort(win)
//----
index = math.round(p/100*length) - 1
pnr = array.remove(win,index)
//----
plot(pnr,"Plot",#ff1100,2)