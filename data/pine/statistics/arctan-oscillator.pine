//@version=6
indicator("ArcTan Oscillator","ATO")
length = input.int(21)
pg     = input.int(0, "Pre-Gain [-10,10]", minval=-10, maxval=10)
src    = input.source(close, "Source")
//----
grad(os) => os < 10 ? #ff1100 : math.max(os,10) < 20 ? #d12033 :
  math.max(os,20) < 30 ? #bd2649 : math.max(os,30) < 40 ? #a72d61 :
  math.max(os,40) < 50 ? #913479 : math.max(os,50) < 60 ? #743d99 :
  math.max(os,60) < 70 ? #5945b6 : math.max(os,70) < 80 ? #494ac7 :
  math.max(os,80) < 90 ? #3750db : #2157f3 
//----
ma = ta.sma(src,length)
z = (ma - ta.sma(ma,length))/ta.stdev(ma,length)
os = math.atan(z*(pg <= 0 ? math.exp(pg) : pg*2))
cor = ta.correlation(src,os,length) 
//----
plot(os,"Reversal Potential",color = color.new(grad((.5*cor+.5)*100), 30)
  ,style=plot.style_area)
plot(os,"Osc",#0a0032,2)