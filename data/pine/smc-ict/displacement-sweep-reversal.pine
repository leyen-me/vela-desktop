// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/ MPL-2.0
//@version=6
indicator("Displacement Sweep Reversal with FVG", shorttitle="Sweep + FVG Shift", overlay=true, max_boxes_count=100, max_lines_count=200)

// --- Inputs ---
int pivotLengthInput = input.int(3, "Swing pivot length", minval=1, maxval=20, tooltip="Bars on each side used to confirm swing points for the sweep structure.")
int maxReversalBarsInput = input.int(10, "Maximum bars to structure break", minval=5, maxval=20, tooltip="The reversal must break the opposing swing within this many bars after the sweep. Choose from 5 to 20.")
int entryWindowBarsInput = input.int(20, "Entry window bars", minval=1, maxval=500, tooltip="How many bars after the structure shift price has to retrace into the entry window.")
int entryWindowOpacityInput = input.int(75, "Entry window opacity", minval=0, maxval=100, tooltip="Transparency of the blue entry window fill: 0 is opaque and 100 is fully transparent.")
int atrLengthInput = input.int(14, "ATR length", minval=1, tooltip="ATR period used to evaluate candle bodies and FVG size.")
float bodyAtrMultipleInput = input.float(0.8, "Significant body (ATR multiple)", minval=0.1, step=0.1, tooltip="Minimum candle body size, in ATR, for the sweep and structure-breaking candles.")
float minFvgAtrMultipleInput = input.float(0.15, "Minimum FVG size (ATR multiple)", minval=0.0, step=0.05, tooltip="Ignore FVGs whose gap height is smaller than this fraction of ATR. Set to zero to disable the size filter.")
color structureBreakColorInput = input.color(#2962FF, "Post-sweep dotted line", group="Style", tooltip="Color of the dotted line from the broken swing level to the confirming structure-break candle.")
color bullishColorInput = input.color(#089981, "Bullish color", group="Style", tooltip="Color for bullish sweep lines and bullish FVG boxes.")
color bearishColorInput = input.color(#f23645, "Bearish color", group="Style", tooltip="Color for bearish sweep lines and bearish FVG boxes.")
color entryWindowColorInput = input.color(#2962FF, "Entry window color", group="Style", tooltip="Fill and border color for the entry-window box.")

// --- Candle displacement and FVG qualification ---
float atrValue = ta.atr(atrLengthInput)
float candleBody = math.abs(close - open)
bool significantBullBody = close > open and candleBody >= atrValue * bodyAtrMultipleInput
bool significantBearBody = close < open and candleBody >= atrValue * bodyAtrMultipleInput
float bearishGapSize = low[2] - high
float bullishGapSize = low - high[2]
bool bearishFvg = bar_index >= 2 and high < low[2] and bearishGapSize >= atrValue * minFvgAtrMultipleInput
bool bullishFvg = bar_index >= 2 and low > high[2] and bullishGapSize >= atrValue * minFvgAtrMultipleInput

// --- Confirmed swing points used by sweep detection ---
float confirmedPivotHigh = ta.pivothigh(high, pivotLengthInput, pivotLengthInput)
float confirmedPivotLow = ta.pivotlow(low, pivotLengthInput, pivotLengthInput)
var float lastPivotHigh = na
var float priorPivotHigh = na
var int lastPivotHighBar = na
var float lastPivotLow = na
var float priorPivotLow = na
var int lastPivotLowBar = na

if not na(confirmedPivotHigh)
    priorPivotHigh := lastPivotHigh
    lastPivotHigh := confirmedPivotHigh
    lastPivotHighBar := bar_index - pivotLengthInput

if not na(confirmedPivotLow)
    priorPivotLow := lastPivotLow
    lastPivotLow := confirmedPivotLow
    lastPivotLowBar := bar_index - pivotLengthInput

// --- Candidate setup state ---
var bool bearishActive = false
var int bearishSweepBar = na
var float bearishBreakLevel = na
var int bearishBreakLevelBar = na
var bool bearishFvgFound = false
var float bearishFvgTop = na
var float bearishFvgBottom = na
var int bearishFvgBar = na

var bool bullishActive = false
var int bullishSweepBar = na
var float bullishBreakLevel = na
var int bullishBreakLevelBar = na
var bool bullishFvgFound = false
var float bullishFvgTop = na
var float bullishFvgBottom = na
var int bullishFvgBar = na

var bool entryWindowActive = false
var int entryWindowStartBar = na
var float entryWindowHigh = na
var float entryWindowLow = na
var box entryWindowBox = na
var box activeFvgBox = na
var float entryWindowBoundary = na
var int entryWindowDirection = 0

// --- Sweep detection ---
bool bearishSweep = not na(lastPivotHigh) and not na(lastPivotLow) and not na(priorPivotLow) and lastPivotLow > priorPivotLow and not na(lastPivotLowBar) and lastPivotLowBar < bar_index and ta.crossover(close, lastPivotHigh) and significantBullBody
bool bullishSweep = not na(lastPivotLow) and not na(lastPivotHigh) and not na(priorPivotHigh) and lastPivotHigh < priorPivotHigh and not na(lastPivotHighBar) and lastPivotHighBar < bar_index and ta.crossunder(close, lastPivotLow) and significantBearBody

if bearishSweep
    bearishActive := true
    bearishSweepBar := bar_index
    bearishBreakLevel := lastPivotLow
    bearishBreakLevelBar := lastPivotLowBar
    bearishFvgFound := bearishFvg
    bearishFvgTop := bearishFvg ? low[2] : na
    bearishFvgBottom := bearishFvg ? high : na
    bearishFvgBar := bearishFvg ? bar_index : na
    bullishActive := false
    line.new(lastPivotHighBar, lastPivotHigh, bar_index, lastPivotHigh, xloc=xloc.bar_index, color=bullishColorInput, width=2)

if bullishSweep
    bullishActive := true
    bullishSweepBar := bar_index
    bullishBreakLevel := lastPivotHigh
    bullishBreakLevelBar := lastPivotHighBar
    bullishFvgFound := bullishFvg
    bullishFvgTop := bullishFvg ? low : na
    bullishFvgBottom := bullishFvg ? high[2] : na
    bullishFvgBar := bullishFvg ? bar_index : na
    bearishActive := false
    line.new(lastPivotLowBar, lastPivotLow, bar_index, lastPivotLow, xloc=xloc.bar_index, color=bearishColorInput, width=2)

bool crossedUnderBearishLevel = ta.crossunder(close, bearishBreakLevel)
bool crossedOverBullishLevel = ta.crossover(close, bullishBreakLevel)
bool bearishSignal = false
bool bullishSignal = false

if bearishActive and not bearishSweep
    int barsFromSweep = bar_index - bearishSweepBar
    if bearishFvg and barsFromSweep <= maxReversalBarsInput
        bearishFvgFound := true
        bearishFvgTop := low[2]
        bearishFvgBottom := high
        bearishFvgBar := bar_index
    if barsFromSweep > maxReversalBarsInput
        bearishActive := false
    else if barsFromSweep > 0 and crossedUnderBearishLevel and significantBearBody and bearishFvgFound
        bearishSignal := true
        bearishActive := false
        line.new(bearishBreakLevelBar, bearishBreakLevel, bar_index, bearishBreakLevel, xloc=xloc.bar_index, color=structureBreakColorInput, style=line.style_dotted, width=2)
        entryWindowActive := true
        entryWindowStartBar := bar_index
        entryWindowDirection := -1
        entryWindowBoundary := bearishFvgBottom
        entryWindowHigh := math.min(high, entryWindowBoundary)
        entryWindowLow := math.min(low, entryWindowBoundary)
        activeFvgBox := box.new(left=bar_index, top=bearishFvgTop, right=bar_index + math.min(5, entryWindowBarsInput), bottom=bearishFvgBottom, xloc=xloc.bar_index, extend=extend.none, border_color=bearishColorInput, border_width=1, bgcolor=color.new(bearishColorInput, 80), text="FVG", text_color=color.white, text_size=size.normal, text_halign=text.align_center, text_valign=text.align_center)
        entryWindowBox := box.new(left=bar_index, top=entryWindowHigh, right=bar_index + math.min(5, entryWindowBarsInput), bottom=entryWindowLow, xloc=xloc.bar_index, extend=extend.none, border_color=entryWindowColorInput, border_width=1, bgcolor=color.new(entryWindowColorInput, entryWindowOpacityInput), text="ENTRY WINDOW\nWait for\nretracement", text_color=color.white, text_size=size.tiny, text_halign=text.align_center, text_valign=text.align_center)

if bullishActive and not bullishSweep
    int barsFromSweep = bar_index - bullishSweepBar
    if bullishFvg and barsFromSweep <= maxReversalBarsInput
        bullishFvgFound := true
        bullishFvgTop := low
        bullishFvgBottom := high[2]
        bullishFvgBar := bar_index
    if barsFromSweep > maxReversalBarsInput
        bullishActive := false
    else if barsFromSweep > 0 and crossedOverBullishLevel and significantBullBody and bullishFvgFound
        bullishSignal := true
        bullishActive := false
        line.new(bullishBreakLevelBar, bullishBreakLevel, bar_index, bullishBreakLevel, xloc=xloc.bar_index, color=structureBreakColorInput, style=line.style_dotted, width=2)
        entryWindowActive := true
        entryWindowStartBar := bar_index
        entryWindowDirection := 1
        entryWindowBoundary := bullishFvgTop
        entryWindowHigh := math.max(high, entryWindowBoundary)
        entryWindowLow := math.max(low, entryWindowBoundary)
        activeFvgBox := box.new(left=bar_index, top=bullishFvgTop, right=bar_index + math.min(5, entryWindowBarsInput), bottom=bullishFvgBottom, xloc=xloc.bar_index, extend=extend.none, border_color=bullishColorInput, border_width=1, bgcolor=color.new(bullishColorInput, 80), text="FVG", text_color=color.white, text_size=size.normal, text_halign=text.align_center, text_valign=text.align_center)
        entryWindowBox := box.new(left=bar_index, top=entryWindowHigh, right=bar_index + math.min(5, entryWindowBarsInput), bottom=entryWindowLow, xloc=xloc.bar_index, extend=extend.none, border_color=entryWindowColorInput, border_width=1, bgcolor=color.new(entryWindowColorInput, entryWindowOpacityInput), text="ENTRY WINDOW\nWait for\nretracement", text_color=color.white, text_size=size.tiny, text_halign=text.align_center, text_valign=text.align_center)

// --- Dynamic entry window ---
if entryWindowActive
    int barsIntoWindow = bar_index - entryWindowStartBar
    if barsIntoWindow < entryWindowBarsInput
        if entryWindowDirection == -1
            entryWindowHigh := math.min(math.max(entryWindowHigh, high), entryWindowBoundary)
            entryWindowLow := math.min(entryWindowLow, low)
        else
            entryWindowHigh := math.max(entryWindowHigh, high)
            entryWindowLow := math.max(math.min(entryWindowLow, low), entryWindowBoundary)
        box.set_top(entryWindowBox, entryWindowHigh)
        box.set_bottom(entryWindowBox, entryWindowLow)
        int entryWindowRight = math.min(bar_index + 5, entryWindowStartBar + entryWindowBarsInput)
        box.set_right(entryWindowBox, entryWindowRight)
        box.set_right(activeFvgBox, entryWindowRight)
    else
        entryWindowActive := false

// --- Sweep labels ---
if bearishSweep
    label.new(x=bar_index, y=high, text="SWEEP", xloc=xloc.bar_index, style=label.style_label_right, color=bearishColorInput, textcolor=color.white, size=size.tiny)
if bullishSweep
    label.new(x=bar_index, y=low, text="SWEEP", xloc=xloc.bar_index, style=label.style_label_right, color=bullishColorInput, textcolor=color.white, size=size.tiny)

// --- Alerts ---
alertcondition(bearishSignal, "Bearish sweep reversal", "Bearish high sweep reversed through the latest higher low with displacement and a significant bearish FVG.")
alertcondition(bullishSignal, "Bullish sweep reversal", "Bullish low sweep reversed through the latest lower high with displacement and a significant bullish FVG.")