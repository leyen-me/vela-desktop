//@version=6
indicator("Malaysian SnR"
  , shorttitle       = "Malaysian SnR"
  , overlay          = true
  , format           = format.price
  , max_lines_count  = 500
  , max_labels_count = 500
  , max_boxes_count  = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
color BULL_COLOR    = #089981
color BEAR_COLOR    = #f23645
color NEUTRAL_COLOR = #787b86
color LABEL_BG      = #00000000

color DASH_BG     = #161616
color DASH_FRAME  = #2E2E2E
color DASH_HEADER = #808080
color DASH_TEXT   = #DBDBDB

// Level kinds
int KIND_A      = 1
int KIND_V      = 2
int KIND_GAP_UP = 3
int KIND_GAP_DN = 4

// Level roles: support sits below price, resistance above
int ROLE_SUPPORT    = 1
int ROLE_RESISTANCE = -1

int MAX_LEVELS         = 150
int MAX_SEGMENTS       = 1500
int UNFRESH_TRANSP     = 55
int POSITION_BG_TRANSP = 88
int LABEL_OFFSET       = 2

string GROUP_LEVELS = "Levels"
string GROUP_STORY  = "Storyline"
string GROUP_TRADE  = "Trade Plan"
string GROUP_DASH   = "Dashboard"
string GROUP_STYLE  = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
turnLengthInput = input.int(5, "Line Chart Turn Length", minval = 1, maxval = 20, group = GROUP_LEVELS
  , tooltip = "Bars on each side a close must exceed to mark a turn of the line chart. A peak of closes is an A-level (resistance), a valley a V-level (support). The level sits at the close of the turning candle, never at its wick.")

showGapsInput = input.bool(true, "Gap Levels", inline = "gap", group = GROUP_LEVELS)
minGapInput   = input.float(0.3, "Minimum Gap (ATR)", minval = 0, maxval = 3, step = 0.05, inline = "gap", group = GROUP_LEVELS
  , tooltip = "A gap level forms where two consecutive candles of the same color leave a gap between the first candle's close and the second candle's open, in the candles' direction. The level sits at the first candle's close. The gap must be at least this many 14-bar ATRs; markets that open where they closed print none.")

maxCrossInput = input.int(2, "Maximum Body Crosses", minval = 0, maxval = 10, group = GROUP_LEVELS
  , tooltip = "A close through a level makes it fresh again with the opposite role: resistance becomes support (RBS) and support becomes resistance (SBR). A level crossed more often than this is regarded as spent and retired from the map.")

maxAgeInput = input.int(400, "Level Lifetime (Bars)", minval = 20, maxval = 5000, group = GROUP_LEVELS
  , tooltip = "Levels older than this are retired, so the map follows the current market.")

storyLengthInput = input.int(10, "Storyline Turn Length", minval = 2, maxval = 50, group = GROUP_STORY
  , tooltip = "Turn length of the larger-degree line chart that sets the storyline, the stand-in for the higher timeframe. A close above its last peak turns the storyline bullish, a close below its last valley turns it bearish. Running the indicator on the storyline timeframe itself (daily or 4-hour) reads that timeframe's story directly.")

storyFilterInput = input.bool(true, "Trade With the Storyline Only", group = GROUP_STORY
  , tooltip = "Only take reactions at fresh levels in the storyline direction: fresh supports in a bullish storyline, fresh resistances in a bearish one. Off, every first touch of a fresh level that holds is traded.")

showTradesInput = input.bool(true, "Show Trades", group = GROUP_TRADE
  , tooltip = "Plan a trade on the first wick touch of a fresh level that closes back on its side: entry at that close, stop beyond the touch, target at the next fresh level in the trade direction.")

tradeGapsInput = input.bool(false, "Trade Gap Levels", group = GROUP_TRADE
  , tooltip = "Also trade reactions at fresh gap levels. Off, gap levels still count as levels, targets and storyline objectives, but entries come from A, V, RBS and SBR levels only, the reaction levels the method trades first.")

rejectionInput = input.bool(true, "Require Rejection Candle", group = GROUP_TRADE
  , tooltip = "The touching candle must also close in the trade direction (a bullish close off a support, a bearish close off a resistance), the reaction MSNR traders wait for before entering.")

stopBufferInput = input.float(0.2, "Stop Buffer (ATR)", minval = 0, maxval = 3, step = 0.05, group = GROUP_TRADE
  , tooltip = "Distance beyond the level or the touching wick, whichever is further, for the protective stop.")

minRewardInput = input.float(1, "Minimum Reward (R)", minval = 0.25, maxval = 10, step = 0.25, group = GROUP_TRADE
  , tooltip = "The target is the nearest fresh level in the trade direction at least this many multiples of the risk away. Price travels from one fresh level to the next, so the map supplies entry, invalidation and target.")

fallbackRInput = input.float(2, "Fallback Target (R)", minval = 0.5, maxval = 10, step = 0.25, group = GROUP_TRADE
  , tooltip = "Target used when no fresh level qualifies in the trade direction.")

maxHoldInput = input.int(40, "Maximum Hold (Bars)", minval = 5, maxval = 500, group = GROUP_TRADE
  , tooltip = "A trade that reaches neither its target nor its stop within this many bars is closed and recorded as Timed Out.")

showDashInput = input.bool(true, "Show Dashboard", group = GROUP_DASH
  , tooltip = "The storyline, the fresh level price last reacted from, the fresh level it is heading to, the fresh level count on each side and the last trade.")

dashPosInput  = input.string("Top Right", "Position", options = ["Top Right", "Bottom Right", "Bottom Left", "Top Left"], group = GROUP_DASH)
dashSizeInput = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], group = GROUP_DASH)

historyBarsInput = input.int(150, "Map History (Bars)", minval = 20, maxval = 2000, group = GROUP_STYLE
  , tooltip = "Levels are drawn with their history over this many recent bars, within the price range those bars traded: solid while fresh, dashed and faded once wicked, recolored when a body closes through them. Older and far-off levels stay tracked but are not drawn.")

labelsPerSideInput = input.int(4, "Labels per Side", minval = 0, maxval = 20, group = GROUP_STYLE
  , tooltip = "Active levels tagged with their name and freshness at the right edge, nearest to the last close first, on each side.")

freshOnlyInput = input.bool(false, "Fresh Levels Only", group = GROUP_STYLE
  , tooltip = "Hide unfresh stretches. A level is drawn solid while fresh, dashed and faded once a wick has touched it, and changes color when a body closes through it.")

showLineChartInput = input.bool(false, "Show Line Chart", group = GROUP_STYLE
  , tooltip = "Overlay the line of closes the levels are read from.")

supportColorInput    = input.color(BULL_COLOR, "Support", inline = "colors", group = GROUP_STYLE)
resistanceColorInput = input.color(BEAR_COLOR, "Resistance", inline = "colors", group = GROUP_STYLE)
neutralColorInput    = input.color(NEUTRAL_COLOR, "Line Chart", inline = "colors", group = GROUP_STYLE)

//---------------------------------------------------------------------------------------------------------------------}
// Variables
//---------------------------------------------------------------------------------------------------------------------{
// The level map, one entry per index across the parallel arrays
var lvId    = array.new_int()
var lvPrice = array.new_float()
var lvKind  = array.new_int()
var lvBirth = array.new_int()
var lvFresh = array.new_bool()
var lvRole  = array.new_int()
var lvCross = array.new_int()
var lvLine  = array.new_line()
var idSeq   = array.from(0)

// Every drawn segment with the id of its level
var segLines   = array.new_line()
var segIds     = array.new_int()
var sideLabels = array.new_label()

// Storyline
var float  majorPeak   = na
var float  majorValley = na
var int    storyDir    = 0
var float  reactPrice  = na
var string reactName   = ""
var int    reactDir    = 0

// Trade
var int    tradeDir    = 0
var int    tradeBar    = na
var float  tradeStop   = na
var float  tradeTarget = na
var string tradeName   = ""
var string targetName  = ""
var string lastSignal  = "-"
var string lastResult  = "-"
var color  resultColor = DASH_TEXT
var box    rewardBox   = na
var box    riskBox     = na

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
getTablePosition(string positionText) =>
    switch positionText
        "Top Right"   => position.top_right
        "Top Left"    => position.top_left
        "Bottom Left" => position.bottom_left
        =>               position.bottom_right

getTableSize(string sizeText) =>
    switch sizeText
        "Tiny"   => size.tiny
        "Normal" => size.normal
        =>          size.small

// MSNR name of a level in its current role: A and V, RBS and SBR once a body has closed through them, Gap for gap levels
levelName(int kind, int role) =>
    string result = "Gap"
    if kind == KIND_A
        result := role == ROLE_RESISTANCE ? "A" : "RBS"
    else if kind == KIND_V
        result := role == ROLE_SUPPORT ? "V" : "SBR"
    result

roleColor(int role) =>
    role == ROLE_SUPPORT ? supportColorInput : resistanceColorInput

levelColor(int role, bool fresh) =>
    color c = roleColor(role)
    fresh ? c : freshOnlyInput ? LABEL_BG : color.new(c, UNFRESH_TRANSP)

// A new line segment for a level: solid while fresh, dashed and faded once a wick has touched it
newSegment(int id, int fromBar, float price, int role, bool fresh) =>
    line ln = line.new(fromBar, price, bar_index, price, color = levelColor(role, fresh), style = fresh ? line.style_solid : line.style_dashed, width = 1)
    array.push(segLines, ln)
    array.push(segIds, id)
    if array.size(segLines) > MAX_SEGMENTS
        array.shift(segLines)
        array.shift(segIds)
    ln

// Closes the level's current segment on this bar and continues it in its new state, so each line keeps its history
restyleLevel(int i, int role, bool fresh) =>
    line.set_x2(array.get(lvLine, i), bar_index)
    array.set(lvLine, i, newSegment(array.get(lvId, i), bar_index, array.get(lvPrice, i), role, fresh))

// Retires a level from the map; its drawn history ends on this bar
removeLevel(int i) =>
    line.set_x2(array.get(lvLine, i), bar_index)
    array.remove(lvId, i)
    array.remove(lvPrice, i)
    array.remove(lvKind, i)
    array.remove(lvBirth, i)
    array.remove(lvFresh, i)
    array.remove(lvRole, i)
    array.remove(lvCross, i)
    array.remove(lvLine, i)

// Adds a level unless an active level of the same role already sits on that price
addLevel(float price, int kind, int role, int birthBar, bool fresh, float tolerance) =>
    bool duplicate = false
    int  n = array.size(lvPrice)
    if n > 0
        for i = 0 to n - 1
            if array.get(lvRole, i) == role and math.abs(array.get(lvPrice, i) - price) <= tolerance
                duplicate := true
    if not duplicate
        int id = array.get(idSeq, 0) + 1
        array.set(idSeq, 0, id)
        array.push(lvId, id)
        array.push(lvPrice, price)
        array.push(lvKind, kind)
        array.push(lvBirth, birthBar)
        array.push(lvFresh, fresh)
        array.push(lvRole, role)
        array.push(lvCross, 0)
        array.push(lvLine, newSegment(id, birthBar, price, role, fresh))
        if array.size(lvPrice) > MAX_LEVELS
            removeLevel(0)

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
float atrValue  = ta.atr(14)
float tolerance = 0.02 * nz(atrValue)

// Line chart turns of the level degree and of the storyline degree
float turnPeak    = ta.pivothigh(close, turnLengthInput, turnLengthInput)
float turnValley  = ta.pivotlow(close, turnLengthInput, turnLengthInput)
float storyPeak   = ta.pivothigh(close, storyLengthInput, storyLengthInput)
float storyValley = ta.pivotlow(close, storyLengthInput, storyLengthInput)

bool longSignal  = false
bool shortSignal = false
bool storyBull   = false
bool storyBear   = false
bool targetHit   = false
bool stopHit     = false

if barstate.isconfirmed and not na(atrValue)
    // -- storyline: larger-degree line chart breaks -------------------------------------------------------------
    if not na(storyPeak)
        majorPeak := storyPeak
    if not na(storyValley)
        majorValley := storyValley
    if not na(majorPeak) and close > majorPeak and storyDir != 1
        storyDir  := 1
        storyBull := true
        label.new(bar_index, low, "Bull storyline", style = label.style_label_up, color = LABEL_BG, textcolor = color.new(supportColorInput, 20), size = size.tiny
          , tooltip = "Close above the last larger-degree line chart peak " + str.tostring(majorPeak, format.mintick) + ": the storyline turns bullish, fresh supports become the trade side")
    else if not na(majorValley) and close < majorValley and storyDir != -1
        storyDir  := -1
        storyBear := true
        label.new(bar_index, high, "Bear storyline", style = label.style_label_down, color = LABEL_BG, textcolor = color.new(resistanceColorInput, 20), size = size.tiny
          , tooltip = "Close below the last larger-degree line chart valley " + str.tostring(majorValley, format.mintick) + ": the storyline turns bearish, fresh resistances become the trade side")

    // -- open trade -------------------------------------------------------------------------------------------------
    if tradeDir != 0 and bar_index > tradeBar
        box.set_right(rewardBox, bar_index)
        box.set_right(riskBox, bar_index)
        bool stopped = tradeDir == 1 ? low <= tradeStop : high >= tradeStop
        bool reached = tradeDir == 1 ? high >= tradeTarget : low <= tradeTarget
        if stopped
            stopHit     := true
            lastResult  := "Stopped"
            resultColor := roleColor(-tradeDir)
            label.new(bar_index, tradeDir == 1 ? low : high, "Stopped", style = tradeDir == 1 ? label.style_label_up : label.style_label_down, color = LABEL_BG, textcolor = resultColor, size = size.small
              , tooltip = "Stop " + str.tostring(tradeStop, format.mintick) + " hit: the " + tradeName + " level failed to hold")
            tradeDir := 0
        else if reached
            targetHit   := true
            lastResult  := "Target"
            resultColor := roleColor(tradeDir)
            label.new(bar_index, tradeDir == 1 ? high : low, "Target", style = tradeDir == 1 ? label.style_label_down : label.style_label_up, color = LABEL_BG, textcolor = resultColor, size = size.small
              , tooltip = "Target " + str.tostring(tradeTarget, format.mintick) + " (" + targetName + ") reached " + str.tostring(bar_index - tradeBar) + " bars after the reaction")
            tradeDir := 0
        else if bar_index - tradeBar >= maxHoldInput
            lastResult  := "Timed out"
            resultColor := DASH_HEADER
            tradeDir    := 0

    // -- level lifecycle: a wick touch spends a level, a body close through it renews it with the opposite role --------
    float  longLevel  = na
    string longName   = ""
    int    longBirth  = na
    float  shortLevel = na
    string shortName  = ""
    int    shortBirth = na
    int n = array.size(lvPrice)
    if n > 0
        for j = 0 to n - 1
            int   i        = n - 1 - j
            float price    = array.get(lvPrice, i)
            int   role     = array.get(lvRole, i)
            bool  fresh    = array.get(lvFresh, i)
            int   kind     = array.get(lvKind, i)
            bool  crossed  = role == ROLE_RESISTANCE ? close > price : close < price
            bool  touched  = role == ROLE_RESISTANCE ? high >= price : low <= price
            bool  retire   = bar_index - array.get(lvBirth, i) > maxAgeInput
            bool  tradable = tradeGapsInput or kind == KIND_A or kind == KIND_V
            if crossed
                int crosses = array.get(lvCross, i) + 1
                array.set(lvCross, i, crosses)
                array.set(lvRole, i, -role)
                array.set(lvFresh, i, true)
                retire := retire or crosses > maxCrossInput
                if not retire
                    restyleLevel(i, -role, true)
            else if touched
                if fresh and tradable
                    // First wick touch of a fresh level that closes back on its side: the reaction MSNR trades
                    if role == ROLE_SUPPORT
                        if na(longLevel) or price > longLevel
                            longLevel := price
                            longName  := levelName(kind, role)
                            longBirth := array.get(lvBirth, i)
                    else
                        if na(shortLevel) or price < shortLevel
                            shortLevel := price
                            shortName  := levelName(kind, role)
                            shortBirth := array.get(lvBirth, i)
                if fresh
                    array.set(lvFresh, i, false)
                    restyleLevel(i, role, false)
            if retire
                removeLevel(i)
            else
                line.set_x2(array.get(lvLine, i), bar_index)

    // -- storyline memory: the last fresh level price reacted from, in the storyline direction ----------------------------
    if not na(longLevel) and storyDir != -1
        reactPrice := longLevel
        reactName  := longName
        reactDir   := ROLE_SUPPORT
    else if not na(shortLevel) and storyDir != 1
        reactPrice := shortLevel
        reactName  := shortName
        reactDir   := ROLE_RESISTANCE

    // -- trade on the reaction ------------------------------------------------------------------------------------------
    int    signalDir   = 0
    float  signalLevel = na
    string name        = ""
    int    signalBirth = na
    bool bullReaction = not rejectionInput or close > open
    bool bearReaction = not rejectionInput or close < open
    if not na(longLevel) and (not storyFilterInput or storyDir == 1) and bullReaction
        signalDir   := 1
        signalLevel := longLevel
        name        := longName
        signalBirth := longBirth
    else if not na(shortLevel) and (not storyFilterInput or storyDir == -1) and bearReaction
        signalDir   := -1
        signalLevel := shortLevel
        name        := shortName
        signalBirth := shortBirth

    if signalDir != 0
        longSignal  := signalDir == 1
        shortSignal := signalDir == -1
        if not showTradesInput or tradeDir == 0
            lastSignal := "Fresh " + name + (signalDir == 1 ? " long" : " short")
            // The traded stretch of the level, from its turn (or the last 30 bars) to the touch
            line.new(math.max(signalBirth, bar_index - 30), signalLevel, bar_index, signalLevel, color = roleColor(signalDir), width = 2)
            label.new(bar_index, signalDir == 1 ? low : high, "Fresh " + name, style = signalDir == 1 ? label.style_label_up : label.style_label_down
              , color = roleColor(signalDir), textcolor = color.white, size = size.small
              , tooltip = "First wick touch of the fresh " + name + " level " + str.tostring(signalLevel, format.mintick) + ", close held " + (signalDir == 1 ? "above" : "below") + " it" + (storyDir != 0 ? "\nStoryline " + (storyDir == 1 ? "bullish" : "bearish") : ""))

        if showTradesInput and tradeDir == 0
            float  entry   = close
            float  stop    = signalDir == 1 ? math.min(low, signalLevel) - stopBufferInput * atrValue : math.max(high, signalLevel) + stopBufferInput * atrValue
            float  risk    = math.abs(entry - stop)
            float  target  = na
            string tgtName = ""
            int k = array.size(lvPrice)
            if k > 0 and risk > 0
                for i = 0 to k - 1
                    float p = array.get(lvPrice, i)
                    if array.get(lvFresh, i) and array.get(lvRole, i) == -signalDir
                        bool farEnough = signalDir == 1 ? p >= entry + minRewardInput * risk : p <= entry - minRewardInput * risk
                        if farEnough
                            bool better = na(target)
                            if not better
                                better := signalDir == 1 ? p < target : p > target
                            if better
                                target  := p
                                tgtName := "fresh " + levelName(array.get(lvKind, i), -signalDir) + " level"
            if na(target)
                target  := entry + signalDir * fallbackRInput * risk
                tgtName := str.tostring(fallbackRInput, "#.##") + "R fallback, no fresh level qualified"
            tradeDir    := signalDir
            tradeBar    := bar_index
            tradeStop   := stop
            tradeTarget := target
            tradeName   := name
            targetName  := tgtName
            lastResult  := "Open"
            resultColor := DASH_TEXT
            color dirColor = roleColor(signalDir)
            color oppColor = roleColor(-signalDir)
            rewardBox := box.new(bar_index, math.max(entry, target), bar_index, math.min(entry, target), border_color = color.new(supportColorInput, 70), bgcolor = color.new(supportColorInput, POSITION_BG_TRANSP))
            riskBox   := box.new(bar_index, math.max(entry, stop), bar_index, math.min(entry, stop), border_color = color.new(resistanceColorInput, 70), bgcolor = color.new(resistanceColorInput, POSITION_BG_TRANSP))

    // -- new levels: line chart turns and same-color gaps -----------------------------------------------------------------
    if not na(turnPeak)
        // Freshness counts from the second bar after the turn: the candle right after it forms the A shape itself
        bool fresh = true
        if turnLengthInput >= 2
            for k = 0 to turnLengthInput - 2
                if high[k] >= turnPeak
                    fresh := false
        addLevel(turnPeak, KIND_A, ROLE_RESISTANCE, bar_index - turnLengthInput, fresh, tolerance)
    if not na(turnValley)
        bool fresh = true
        if turnLengthInput >= 2
            for k = 0 to turnLengthInput - 2
                if low[k] <= turnValley
                    fresh := false
        addLevel(turnValley, KIND_V, ROLE_SUPPORT, bar_index - turnLengthInput, fresh, tolerance)
    if showGapsInput
        float minGap = math.max(minGapInput * atrValue, syminfo.mintick)
        if close[1] > open[1] and close > open and open - close[1] >= minGap
            addLevel(close[1], KIND_GAP_UP, ROLE_SUPPORT, bar_index - 1, true, tolerance)
        if close[1] < open[1] and close < open and close[1] - open >= minGap
            addLevel(close[1], KIND_GAP_DN, ROLE_RESISTANCE, bar_index - 1, true, tolerance)

plot(showLineChartInput ? close : na, "Line Chart", color = color.new(neutralColorInput, 30), linewidth = 1)

float mapHigh = ta.highest(high, historyBarsInput)
float mapLow  = ta.lowest(low, historyBarsInput)

//---------------------------------------------------------------------------------------------------------------------}
// Level map display & Dashboard
//---------------------------------------------------------------------------------------------------------------------{
var table dashTable = table.new(getTablePosition(dashPosInput), 2, 6, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

dashRow(int row, string labelText, string valueText, color valueColor, string textSize) =>
    table.cell(dashTable, 0, row, labelText, text_color = DASH_HEADER, text_halign = text.align_left, text_size = textSize)
    table.cell(dashTable, 1, row, valueText, text_color = valueColor, text_halign = text.align_right, text_size = textSize)

if barstate.islast
    for lb in sideLabels
        label.delete(lb)
    array.clear(sideLabels)

    // The map shown: every level segment of the recent history inside the price range it traded, and tags on the
    // active levels nearest to the last close
    float pad = nz(atrValue)
    int   n          = array.size(lvPrice)
    int   freshAbove = 0
    int   freshBelow = 0
    float nextTarget = na
    string nextName  = ""
    if n > 0
        for i = 0 to n - 1
            float price = array.get(lvPrice, i)
            int   role  = array.get(lvRole, i)
            bool  fresh = array.get(lvFresh, i)
            if fresh
                if price > close
                    freshAbove += 1
                else
                    freshBelow += 1
                if storyDir != 0 and role == -storyDir
                    bool ahead = storyDir == 1 ? price > close : price < close
                    if ahead
                        if na(nextTarget) or math.abs(price - close) < math.abs(nextTarget - close)
                            nextTarget := price
                            nextName   := levelName(array.get(lvKind, i), role)

    // Tags: nearest active levels first, per side, skipping any that would print on top of a tag already placed
    var placedY = array.new_float()
    var used    = array.new_bool()
    array.clear(placedY)
    array.clear(used)
    float spacing     = 0.03 * (mapHigh - mapLow)
    int   placedAbove = 0
    int   placedBelow = 0
    if n > 0
        for i = 0 to n - 1
            array.push(used, false)
        for step = 0 to n - 1
            int   best     = -1
            float bestDist = 0.0
            for i = 0 to n - 1
                float price = array.get(lvPrice, i)
                bool  ok    = not array.get(used, i) and price <= mapHigh + pad and price >= mapLow - pad and (array.get(lvFresh, i) or not freshOnlyInput)
                if ok
                    float d = math.abs(price - close)
                    if best == -1 or d < bestDist
                        best     := i
                        bestDist := d
            if best >= 0
                array.set(used, best, true)
                float price = array.get(lvPrice, best)
                bool  above = price > close
                bool  room  = above ? placedAbove < labelsPerSideInput : placedBelow < labelsPerSideInput
                for y in placedY
                    if math.abs(y - price) < spacing
                        room := false
                if room
                    int    role  = array.get(lvRole, best)
                    bool   fresh = array.get(lvFresh, best)
                    string tag   = levelName(array.get(lvKind, best), role) + (fresh ? " · fresh" : " · unfresh")
                    array.push(placedY, price)
                    if above
                        placedAbove += 1
                    else
                        placedBelow += 1
                    array.push(sideLabels, label.new(bar_index + LABEL_OFFSET, price, tag, style = label.style_label_left, color = LABEL_BG
                      , textcolor = fresh ? roleColor(role) : color.new(roleColor(role), 35), size = size.tiny
                      , tooltip = tag + " " + str.tostring(price, format.mintick) + "\nCrossed by a body " + str.tostring(array.get(lvCross, best)) + " times since it formed"))

    int s = array.size(segLines)
    if s > 0
        for i = 0 to s - 1
            line  ln = array.get(segLines, i)
            float y  = line.get_y1(ln)
            if line.get_x2(ln) < bar_index - historyBarsInput or y > mapHigh + pad or y < mapLow - pad
                line.delete(ln)

    if showDashInput
        string dashSize   = getTableSize(dashSizeInput)
        color  storyColor = storyDir == 1 ? supportColorInput : storyDir == -1 ? resistanceColorInput : DASH_HEADER
        table.cell(dashTable, 0, 0, "Malaysian SnR", text_color = DASH_TEXT, text_halign = text.align_left, text_size = dashSize)
        table.cell(dashTable, 1, 0, storyDir == 1 ? "Bullish storyline" : storyDir == -1 ? "Bearish storyline" : "No storyline", text_color = storyColor, text_halign = text.align_right, text_size = dashSize)
        dashRow(1, "Reacted from", not na(reactPrice) ? reactName + " " + str.tostring(reactPrice, format.mintick) : "-", not na(reactPrice) ? roleColor(reactDir) : DASH_TEXT, dashSize)
        dashRow(2, "Heading to", not na(nextTarget) ? "Fresh " + nextName + " " + str.tostring(nextTarget, format.mintick) : "-", not na(nextTarget) ? roleColor(-storyDir) : DASH_TEXT, dashSize)
        dashRow(3, "Fresh above / below", str.tostring(freshAbove) + " / " + str.tostring(freshBelow), DASH_TEXT, dashSize)
        dashRow(4, "Last signal", lastSignal, DASH_TEXT, dashSize)
        dashRow(5, "Result", lastResult, resultColor, dashSize)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(longSignal, "Fresh Support Reaction", "Malaysian SnR on {{ticker}} ({{interval}}): first wick touch of a fresh support level held. Long planned to the next fresh level.")
alertcondition(shortSignal, "Fresh Resistance Reaction", "Malaysian SnR on {{ticker}} ({{interval}}): first wick touch of a fresh resistance level held. Short planned to the next fresh level.")
alertcondition(storyBull, "Bullish Storyline", "Malaysian SnR on {{ticker}} ({{interval}}): close above the last larger-degree line chart peak, the storyline turned bullish.")
alertcondition(storyBear, "Bearish Storyline", "Malaysian SnR on {{ticker}} ({{interval}}): close below the last larger-degree line chart valley, the storyline turned bearish.")
alertcondition(targetHit, "Target Reached", "Malaysian SnR on {{ticker}} ({{interval}}): trade reached the next fresh level.")
alertcondition(stopHit, "Stopped", "Malaysian SnR on {{ticker}} ({{interval}}): trade stopped beyond the level.")

//---------------------------------------------------------------------------------------------------------------------}
