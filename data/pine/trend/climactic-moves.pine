//@version=6
indicator("Climactic Moves", "Climactic Moves", overlay = true, max_labels_count = 500, max_lines_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR = #089981 // capitulation: climactic selling, bullish implication
BEAR_COLOR = #f23645 // blow-off: climactic buying, bearish implication
BASE_COLOR = #787b86
TRAIL_COLOR = #5b9cf6

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_HEADER = #808080
DASH_TEXT   = #DBDBDB

PHASE_IDLE  = 0
PHASE_MOVE  = 1
PHASE_WATCH = 2

TREND_GROUP  = "Mature Trend"
LADDER_GROUP = "Acceleration Ladder"
EFFORT_GROUP = "Effort"
TELL_GROUP   = "Exhaustion & Retest"
STYLE_GROUP  = "Style"
DASH_GROUP   = "Dashboard"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
baseLenInput = input.int(50, "Baseline SMA", minval = 5, group = TREND_GROUP
  , tooltip = "Moving-average baseline the trend matures against and the climactic run stretches away from.")

maturityInput = input.int(20, "Trend Maturity (bars)", minval = 0, maxval = 500, group = TREND_GROUP
  , tooltip = "Consecutive closes on the trend side of the baseline required before a run can read as climactic. Climaxes are endings: without an extended advance or decline behind it, the same vertical signature is initiative, not terminal.")

extensionInput = input.float(3, "Extension from Baseline (ATR)", minval = 0, step = 0.25, group = TREND_GROUP
  , tooltip = "Minimum distance between the close and the baseline, in ATR multiples, when the climax is flagged. Climactic legs stretch far from any mean.")

atrLenInput = input.int(14, "ATR Length", minval = 1, group = TREND_GROUP
  , tooltip = "Average true range used to normalize extension, slopes, the reversal-bar test and retest proximity.")

swingLenInput = input.int(2, "Swing Length", minval = 1, maxval = 20, group = LADDER_GROUP
  , tooltip = "Bars on each side that confirm the swing lows (swing highs in a decline) the trendline ladder is built from. Parabolic runs leave only shallow pauses, so short swings read them best. Each rung is confirmed this many bars after its swing, so the ladder never repaints.")

minRungsInput = input.int(2, "Minimum Steepening Rungs", minval = 1, maxval = 6, group = LADDER_GROUP
  , tooltip = "Consecutive trendlines, each connecting the latest two rising swing lows and each steeper than the one before, required before the run counts as accelerating. 2 means at least one steepening step: successive legs covering more ground in less time.")

lookbackInput = input.int(20, "Fresh Extreme Lookback", minval = 2, group = LADDER_GROUP
  , tooltip = "The climax is flagged on a bar printing the highest high (lowest low) of this many bars, so the move is read at its peak, never on a pullback.")

useVolumeInput = input.bool(true, "Volume Surge", inline = "volume", group = EFFORT_GROUP
  , tooltip = "Require the heaviest bar of the effort window to trade a multiple of average volume. Skipped automatically on symbols without volume data.")

volumeMultInput = input.float(2, "", minval = 1, step = 0.25, inline = "volume", group = EFFORT_GROUP)

effortLenInput = input.int(10, "Effort Window", minval = 2, group = EFFORT_GROUP
  , tooltip = "Recent bars checked for the volume surge and for range expansion: the window's average range must exceed that of the window before it.")

volumeLenInput = input.int(20, "Volume Average Length", minval = 2, group = EFFORT_GROUP)

stallInput = input.int(5, "Failure to Extend (bars)", minval = 1, maxval = 100, group = TELL_GROUP
  , tooltip = "Ends the vertical phase when this many bars pass without a fresh extreme. Alongside it, a close through the steepest rung and an abrupt wide-range reversal also end the phase, whichever prints first.")

reversalInput = input.float(1.5, "Reversal Bar Range (ATR)", minval = 0.5, step = 0.25, group = TELL_GROUP
  , tooltip = "A bar spanning at least this many ATRs that closes against the move, below the prior close, is the abrupt wide-range reversal tell.")

pullbackInput = input.float(2, "Minimum Reaction (ATR)", minval = 0.25, step = 0.25, group = TELL_GROUP
  , tooltip = "How far price must first react away from the climactic extreme, in ATR multiples, before a return toward it can count as a retest: the automatic reaction that follows a genuine climax.")

proximityInput = input.float(1, "Retest Proximity (ATR)", minval = 0.1, step = 0.25, group = TELL_GROUP
  , tooltip = "How close the return must come to the climactic extreme, in ATR multiples, to count as a retest.")

retestVolInput = input.float(60, "Retest Volume, % of Peak", minval = 1, maxval = 100, group = TELL_GROUP
  , tooltip = "The retest confirms the exhaustion only on markedly lighter effort: relative volume at or below this share of the run's peak relative volume, on a bar that closes back away from the extreme.")

continuationInput = input.float(1.25, "Continuation Effort (x avg volume)", minval = 0, step = 0.05, group = TELL_GROUP
  , tooltip = "A close beyond the climactic extreme reclassifies the surge as continuation and ends the watch only when it trades at least this multiple of average volume: a push through on sustained effort. A marginal new extreme on lighter volume is treated as the last push of the climax and the watched extreme moves to it.")

watchInput = input.int(60, "Exhaustion Watch (bars)", minval = 2, maxval = 500, group = TELL_GROUP
  , tooltip = "Bars after the exhaustion tell during which the extreme is watched for its retest. A close beyond the extreme ends the watch early: the surge reclassifies as continuation.")

showLadderInput = input.bool(true, "Trendline Ladder", group = STYLE_GROUP
  , tooltip = "Draw the steepening trendlines of each climactic run: earlier rungs dotted, the steepest solid and projected until the vertical phase ends.")

showLevelInput = input.bool(true, "Climax Extreme Level", group = STYLE_GROUP
  , tooltip = "Level at the climactic extreme while the exhaustion watch runs: dashed while watching, solid once a weak retest confirms, faded if price closes beyond it.")

showLabelsInput = input.bool(true, "Event Labels", group = STYLE_GROUP
  , tooltip = "Tag climaxes, exhaustion tells and weak retests. Hover a tag for the measured signature behind it.")

labelSizeInput = input.string("Small", "Label Size", options = ["Tiny", "Small", "Normal"], group = STYLE_GROUP)

showBaselineInput = input.bool(true, "Baseline", inline = "base", group = STYLE_GROUP)
baseColorInput    = input.color(BASE_COLOR, "", inline = "base", group = STYLE_GROUP)

blowColorInput = input.color(BEAR_COLOR, "Blow-off", inline = "colors", group = STYLE_GROUP
  , tooltip = "Climactic buying that ends an uptrend in a final vertical surge (bearish implication).")
capColorInput  = input.color(BULL_COLOR, "Capitulation", inline = "colors", group = STYLE_GROUP
  , tooltip = "Climactic selling that ends a decline in a final cascade (bullish implication).")

showDashInput = input.bool(true, "Show Dashboard", group = DASH_GROUP
  , tooltip = "Live readout: phase of the latest episode, ladder rungs and slope, extension from the baseline and peak effort.")
dashPosInput  = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], inline = "dash", group = DASH_GROUP)
dashSizeInput = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], inline = "dash", group = DASH_GROUP)

//---------------------------------------------------------------------------------------------------------------------}
// Types & Functions
//---------------------------------------------------------------------------------------------------------------------{
//One side of the market: the trendline ladder under (over) the trend and the latest climactic episode
type Side
    array<int>   pivBars
    array<float> pivPrices
    float slope      = na
    int   phase      = 0
    float extreme    = na
    int   extremeBar = 0
    float peakVol    = na
    bool  leftZone   = false
    int   endBar     = 0
    int   anchorBar  = 0
    float anchorPrice = na
    float anchorSlope = na
    line  steepLine  = na
    line  levelLine  = na
    int   episodes   = 0
    label climaxLabel = na
    int   climaxBar  = 0

getSize(string s) =>
    switch s
        "Tiny"  => size.tiny
        "Small" => size.small
        => size.normal

getPosition(string p) =>
    switch p
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

//Restart the ladder from a single swing point
resetLadder(Side s, int b, float p) =>
    array.clear(s.pivBars)
    array.clear(s.pivPrices)
    array.push(s.pivBars, b)
    array.push(s.pivPrices, p)
    s.slope := na

//Projected value of the episode's steepest rung at bar t
rungAt(Side s, int t) =>
    s.anchorPrice + s.anchorSlope * (t - s.anchorBar)

//---------------------------------------------------------------------------------------------------------------------}
// Measurements
//---------------------------------------------------------------------------------------------------------------------{
labelSize = getSize(labelSizeInput)

atrValue  = ta.atr(atrLenInput)
baseline  = ta.sma(close, baseLenInput)
trueRange = ta.tr(true)

//Effort: volume multiples and range expansion window over window
volAvg     = ta.sma(volume, volumeLenInput)
volumeOk   = not na(volAvg) and volAvg > 0
relVol     = volumeOk ? volume / volAvg : na
peakRelVol = ta.highest(nz(relVol), effortLenInput)
rangeNow   = ta.sma(trueRange, effortLenInput)
rangeExpanding = not na(rangeNow[effortLenInput]) and rangeNow > rangeNow[effortLenInput]
surgeOk    = not useVolumeInput or not volumeOk or peakRelVol >= volumeMultInput
effortOk   = rangeExpanding and surgeOk

//Maturity: closes held on the trend side of a seasoned baseline
barsAbove = ta.barssince(close < baseline)
barsBelow = ta.barssince(close > baseline)
seasoned  = not na(baseline[maturityInput])
matureUp  = seasoned and nz(barsAbove, bar_index) >= maturityInput
matureDn  = seasoned and nz(barsBelow, bar_index) >= maturityInput

extAtr = atrValue > 0 and not na(baseline) ? (close - baseline) / atrValue : na

freshHigh = high >= ta.highest(high, lookbackInput)
freshLow  = low <= ta.lowest(low, lookbackInput)

pivLow  = ta.pivotlow(low, swingLenInput, swingLenInput)
pivHigh = ta.pivothigh(high, swingLenInput, swingLenInput)

wideDown = atrValue > 0 and trueRange >= reversalInput * atrValue and close < open and close < close[1]
wideUp   = atrValue > 0 and trueRange >= reversalInput * atrValue and close > open and close > close[1]

//---------------------------------------------------------------------------------------------------------------------}
// Episode Engine
//---------------------------------------------------------------------------------------------------------------------{
//Runs one side bar by bar. dir = 1 reads blow-offs over a ladder of rising swing lows, dir = -1 capitulation under a
//ladder of falling swing highs. Returns the events printed on this bar.
processSide(Side s, int dir, float pivot, bool mature, bool fresh, bool reversal, color c) =>
    bool startEv   = false
    bool tellEv    = false
    bool confirmEv = false
    bool failEv    = false
    float edge     = dir == 1 ? high : low

    //1. A confirmed swing feeds the ladder: a steeper rung extends it, a shallower one or a structure break restarts it
    if barstate.isconfirmed and not na(pivot)
        int pb = bar_index - swingLenInput
        int n  = array.size(s.pivBars)
        if n == 0
            resetLadder(s, pb, pivot)
        else
            int   lb = array.last(s.pivBars)
            float lp = array.last(s.pivPrices)
            if dir * (pivot - lp) <= 0 or pb <= lb
                resetLadder(s, pb, pivot)
            else
                float sl = (pivot - lp) / (pb - lb)
                if na(s.slope) or dir * sl > dir * s.slope
                    array.push(s.pivBars, pb)
                    array.push(s.pivPrices, pivot)
                    s.slope := sl
                    //Inside a vertical phase every new steeper rung is drawn and becomes the line to break
                    if s.phase == PHASE_MOVE
                        if showLadderInput and not na(s.steepLine)
                            line.set_x2(s.steepLine, pb)
                            line.set_y2(s.steepLine, rungAt(s, pb))
                            line.set_style(s.steepLine, line.style_dotted)
                            line.set_color(s.steepLine, c)
                        s.anchorBar   := lb
                        s.anchorPrice := lp
                        s.anchorSlope := sl
                        if showLadderInput
                            s.steepLine := line.new(lb, lp, bar_index, rungAt(s, bar_index), color = c, width = 2)
                else
                    resetLadder(s, lb, lp)
                    array.push(s.pivBars, pb)
                    array.push(s.pivPrices, pivot)
                    s.slope := sl

    int rungs = array.size(s.pivBars) - 1

    if barstate.isconfirmed
        //2. Outside a vertical phase, a close through the latest rung means the acceleration failed: restart the ladder
        if s.phase != PHASE_MOVE and rungs >= 1
            float proj = array.last(s.pivPrices) + s.slope * (bar_index - array.last(s.pivBars))
            if dir * (close - proj) < 0
                resetLadder(s, array.last(s.pivBars), array.last(s.pivPrices))
                rungs := 0

        //3. Detection: mature trend, accelerating ladder, stretched from the baseline, effort, at a fresh extreme
        if s.phase != PHASE_MOVE and rungs >= minRungsInput and mature and not na(extAtr) and dir * extAtr >= extensionInput and fresh and effortOk
            if s.phase == PHASE_WATCH and not na(s.levelLine)
                line.set_x2(s.levelLine, bar_index)
                line.set_color(s.levelLine, color.new(c, 75))
                s.levelLine := line(na)
            s.phase      := PHASE_MOVE
            s.extreme    := edge
            s.extremeBar := bar_index
            s.peakVol    := peakRelVol
            s.episodes   += 1
            startEv      := true
            int   sz      = array.size(s.pivBars)
            s.anchorBar   := array.get(s.pivBars, sz - 2)
            s.anchorPrice := array.get(s.pivPrices, sz - 2)
            s.anchorSlope := s.slope
            if showLadderInput
                //Earlier rungs dotted, each ending where the next swing confirmed it was outpaced
                for i = 0 to math.max(sz - 3, 0)
                    if sz < 3
                        break
                    line.new(array.get(s.pivBars, i), array.get(s.pivPrices, i), array.get(s.pivBars, i + 1), array.get(s.pivPrices, i + 1)
                      , color = c, style = line.style_dotted, width = 2)
                s.steepLine := line.new(s.anchorBar, s.anchorPrice, bar_index, rungAt(s, bar_index), color = c, width = 2)
            if showLabelsInput
                float slopeAtr = math.abs(s.slope) / atrValue
                string tip = (dir == 1 ? "Blow-off: a mature uptrend gone near-vertical" : "Capitulation: a mature decline gone near-vertical")
                  + "\nLadder: " + str.tostring(rungs) + " steepening rungs, steepest " + str.tostring(slopeAtr, "#.##") + " ATR per bar"
                  + "\nExtension: " + str.tostring(math.abs(extAtr), "#.#") + " ATR from the baseline"
                  + (volumeOk ? "\nPeak volume: " + str.tostring(peakRelVol, "#.#") + "x average" : "")
                  + "\nRisk read: late-stage exhaustion, not a fresh with-trend entry"
                s.climaxLabel := label.new(bar_index, edge, dir == 1 ? "Blow-off" : "Capitulation"
                  , style     = dir == 1 ? label.style_label_lower_right : label.style_label_upper_right
                  , color     = c
                  , textcolor = color.white
                  , size      = labelSize
                  , tooltip   = tip)
                s.climaxBar := bar_index

        //4. Vertical phase: ratchet the extreme, project the steepest rung, wait for the first tell
        else if s.phase == PHASE_MOVE
            if dir * (edge - s.extreme) > 0
                s.extreme    := edge
                s.extremeBar := bar_index
            s.peakVol := math.max(s.peakVol, nz(relVol))
            float proj = rungAt(s, bar_index)
            if not na(s.steepLine)
                line.set_x2(s.steepLine, bar_index)
                line.set_y2(s.steepLine, proj)
            bool breakTell = dir * (close - proj) < 0
            bool stallTell = bar_index - s.extremeBar >= stallInput
            if breakTell or stallTell or reversal
                s.phase    := PHASE_WATCH
                s.endBar   := bar_index
                s.leftZone := false
                tellEv     := true
                s.steepLine := line(na)
                resetLadder(s, array.last(s.pivBars), array.last(s.pivPrices))
                if showLevelInput
                    s.levelLine := line.new(s.extremeBar, s.extreme, bar_index, s.extreme, color = c, style = line.style_dashed)
                if showLabelsInput
                    string tip = (dir == 1 ? "Blow-off exhaustion tell" : "Capitulation exhaustion tell")
                      + (breakTell ? "\nClose through the steepest rung of the ladder" : "")
                      + (stallTell ? "\nFailure to extend: no fresh extreme for " + str.tostring(bar_index - s.extremeBar) + " bars" : "")
                      + (reversal ? "\nAbrupt wide-range reversal against the move" : "")
                      + "\nTrend followers exit or tighten here; the extreme is now watched for a weak retest"
                    string tellName = breakTell ? "Line Break" : "Exhaustion"
                    //A tell printing right after the climax joins its tag instead of stacking a second one on the same bars
                    if not na(s.climaxLabel) and bar_index - s.climaxBar <= 3
                        label.set_text(s.climaxLabel, label.get_text(s.climaxLabel) + "\n" + tellName)
                        label.set_tooltip(s.climaxLabel, tip + "\n(printed " + str.tostring(bar_index - s.climaxBar) + " bars after the climax tag)")
                    else
                        label.new(bar_index, edge, tellName
                          , style     = dir == 1 ? label.style_label_lower_right : label.style_label_upper_right
                          , color     = color.new(c, 80)
                          , textcolor = c
                          , size      = labelSize
                          , tooltip   = tip)

        //5. Exhaustion watch: a push through the extreme resets, a light-volume failure short of it confirms
        else if s.phase == PHASE_WATCH
            if not na(s.levelLine)
                line.set_x2(s.levelLine, bar_index)
            bool sustained = not useVolumeInput or na(relVol) or relVol >= continuationInput
            if dir * (close - s.extreme) > 0 and sustained
                s.phase := PHASE_IDLE
                failEv  := true
                if not na(s.levelLine)
                    line.set_color(s.levelLine, color.new(c, 75))
                    s.levelLine := line(na)
            else if dir * (edge - s.extreme) > 0
                //A marginal new extreme on light effort is the last push of the climax: the watch moves to it
                s.extreme    := edge
                s.extremeBar := bar_index
                s.leftZone   := false
                if not na(s.levelLine)
                    line.set_xy1(s.levelLine, bar_index, edge)
                    line.set_xy2(s.levelLine, bar_index, edge)
            else
                float zone = proximityInput * atrValue
                if dir * (s.extreme - edge) >= pullbackInput * atrValue
                    s.leftZone := true
                else if s.leftZone and dir * (s.extreme - edge) <= zone
                    bool lighter  = not useVolumeInput or na(relVol) or (s.peakVol > 0 and relVol <= s.peakVol * retestVolInput / 100)
                    bool rejected = dir * (close - open) < 0
                    if lighter and rejected
                        s.phase   := PHASE_IDLE
                        confirmEv := true
                        if not na(s.levelLine)
                            line.set_style(s.levelLine, line.style_solid)
                            s.levelLine := line(na)
                        if showLabelsInput
                            string tip = "Weak retest: a return toward the " + (dir == 1 ? "blow-off high" : "capitulation low") + " on much lighter effort, failing short of it. The exhaustion is confirmed; the stop for a position against the old trend sits beyond the extreme"
                              + (na(relVol) or na(s.peakVol) or s.peakVol <= 0 ? "" : "\nVolume: " + str.tostring(100 * relVol / s.peakVol, "#") + "% of the run's peak")
                            label.new(bar_index, edge, "Weak Retest"
                              , style     = dir == 1 ? label.style_label_lower_right : label.style_label_upper_right
                              , color     = c
                              , textcolor = color.white
                              , size      = labelSize
                              , tooltip   = tip)
                if s.phase == PHASE_WATCH and bar_index - s.endBar >= watchInput
                    s.phase     := PHASE_IDLE
                    s.levelLine := line(na)
    [startEv, tellEv, confirmEv, failEv, rungs]

//---------------------------------------------------------------------------------------------------------------------}
// Run Both Sides
//---------------------------------------------------------------------------------------------------------------------{
var Side up = Side.new(array.new<int>(), array.new<float>())
var Side dn = Side.new(array.new<int>(), array.new<float>())

[blowStart, blowTell, blowConfirm, blowFail, upRungs] = processSide(up, 1, pivLow, matureUp, freshHigh, wideDown, blowColorInput)
[capStart, capTell, capConfirm, capFail, dnRungs]     = processSide(dn, -1, pivHigh, matureDn, freshLow, wideUp, capColorInput)

//---------------------------------------------------------------------------------------------------------------------}
// Visuals & Dashboard
//---------------------------------------------------------------------------------------------------------------------{
plot(baseline, "Baseline", showBaselineInput ? color.new(baseColorInput, 30) : na, 1)

var table dash = na

phaseText(Side s) =>
    switch s.phase
        PHASE_MOVE  => "Vertical phase"
        PHASE_WATCH => "Watching extreme"
        => "Idle"

if barstate.islast and showDashInput
    if na(dash)
        dash := table.new(getPosition(dashPosInput), 2, 5, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)
    ts = getSize(dashSizeInput)
    //Report the side the trend currently leans to
    bool  upSide   = nz(extAtr) >= 0
    Side  s        = upSide ? up : dn
    color sc       = upSide ? blowColorInput : capColorInput
    int   rungsNow = upSide ? upRungs : dnRungs
    string ladderText = rungsNow <= 0 ? "No rising rungs" : str.tostring(rungsNow) + (rungsNow == 1 ? " rung, " : " rungs, ") + str.tostring(math.abs(nz(s.slope)) / atrValue, "#.##") + " ATR/bar"
    table.cell(dash, 0, 0, upSide ? "Blow-off Watch" : "Capitulation Watch", text_color = DASH_HEADER, text_size = ts, text_halign = text.align_left)
    table.cell(dash, 1, 0, phaseText(s), text_color = s.phase == PHASE_IDLE ? DASH_TEXT : sc, text_size = ts, text_halign = text.align_right)
    table.cell(dash, 0, 1, "Ladder", text_color = DASH_HEADER, text_size = ts, text_halign = text.align_left)
    table.cell(dash, 1, 1, ladderText, text_color = rungsNow >= minRungsInput ? sc : DASH_TEXT, text_size = ts, text_halign = text.align_right)
    table.cell(dash, 0, 2, "Extension", text_color = DASH_HEADER, text_size = ts, text_halign = text.align_left)
    table.cell(dash, 1, 2, na(extAtr) ? "-" : str.tostring(extAtr, "#.#") + " ATR", text_color = math.abs(nz(extAtr)) >= extensionInput ? sc : DASH_TEXT, text_size = ts, text_halign = text.align_right)
    table.cell(dash, 0, 3, "Trend Age", text_color = DASH_HEADER, text_size = ts, text_halign = text.align_left)
    table.cell(dash, 1, 3, str.tostring(upSide ? nz(barsAbove) : nz(barsBelow)) + " bars", text_color = DASH_TEXT, text_size = ts, text_halign = text.align_right)
    table.cell(dash, 0, 4, "Peak Volume", text_color = DASH_HEADER, text_size = ts, text_halign = text.align_left)
    table.cell(dash, 1, 4, volumeOk ? str.tostring(peakRelVol, "#.#") + "x avg" : "n/a", text_color = DASH_TEXT, text_size = ts, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(blowStart, "Blow-off", "Climactic Moves: blow-off on {{ticker}}, a mature uptrend gone near-vertical on a steepening trendline ladder and heavy effort ({{interval}})")
alertcondition(capStart, "Capitulation", "Climactic Moves: capitulation on {{ticker}}, a mature decline gone near-vertical on a steepening trendline ladder and heavy effort ({{interval}})")
alertcondition(blowTell, "Blow-off Exhaustion Tell", "Climactic Moves: the blow-off's vertical phase ended on {{ticker}} (steepest rung broken, failure to extend or wide-range reversal) ({{interval}})")
alertcondition(capTell, "Capitulation Exhaustion Tell", "Climactic Moves: the capitulation's vertical phase ended on {{ticker}} (steepest rung broken, failure to extend or wide-range reversal) ({{interval}})")
alertcondition(blowConfirm, "Blow-off Weak Retest", "Climactic Moves: weak retest of the blow-off high on {{ticker}}, lighter volume failing short of the extreme ({{interval}})")
alertcondition(capConfirm, "Capitulation Weak Retest", "Climactic Moves: weak retest of the capitulation low on {{ticker}}, lighter volume failing short of the extreme ({{interval}})")
alertcondition(blowFail, "Blow-off Continuation", "Climactic Moves: close above the blow-off extreme on {{ticker}}, the surge reclassifies as continuation ({{interval}})")
alertcondition(capFail, "Capitulation Continuation", "Climactic Moves: close below the capitulation extreme on {{ticker}}, the cascade reclassifies as continuation ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
