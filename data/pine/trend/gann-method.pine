//@version=6
indicator("Gann Method", shorttitle = "Gann Method", overlay = true, format = format.price
  , max_bars_back    = 2000
  , max_lines_count  = 500
  , max_labels_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // rising angles and up trends
BEAR_COLOR    = #f23645 // falling angles and down trends
SWING_COLOR   = #787b86 // the swing chart and the range divisions
MID_COLOR     = #ff9800 // the 50% division, the one Gann weighted most
SQUARE_COLOR  = #ffd700 // price-time square: the anchor swing's duration projected from the anchor

color COLOR_HIDDEN = #00000000

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_HEADER = #808080
DASH_TEXT   = #DBDBDB

string GRP_SWING  = "Swing Chart"
string GRP_ANGLES = "Angles"
string GRP_DIV    = "Range Divisions"
string GRP_TIME   = "Time"
string GRP_DASH   = "Dashboard"
string GRP_STYLE  = "Style"

string SCALE_SWING  = "Anchor Swing (Range / Time)"
string SCALE_ATR    = "ATR at Anchor"
string SCALE_MANUAL = "Manual"

string DIV_KEY     = "Key (1/4, 1/3, 1/2, 2/3, 3/4)"
string DIV_EIGHTHS = "Eighths"
string DIV_BOTH    = "Eighths & Thirds"

string TXT_NA = "-"

int MAX_PIVOTS = 60

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
swingBarsInput = input.int(2, "Swing Chart Bars", minval = 1, maxval = 10, group = GRP_SWING
  , tooltip = "Gann's mechanical swing chart: the swing line turns down after this many consecutive bars with lower lows and turns up after as many bars with higher highs; inside bars are ignored. Gann kept 1, 2 and 3 day charts; higher counts keep only larger swings.")

showSwingsInput = input.bool(true, "Show Swing Line", group = GRP_SWING
  , tooltip = "Draw the swing chart: the line joining each confirmed swing top and bottom, with the leg still in progress dashed. A swing point is drawn at its extreme once the turn confirms it, so the line reaches back to bars already closed; nothing already confirmed changes afterwards.")

showTrendInput = input.bool(true, "Show Trend Changes", group = GRP_SWING
  , tooltip = "Gann's swing trend rule: the trend turns up when price closes above the last swing top and down when it closes below the last swing bottom. Each change is labeled, and a step line tracks the last swing on the other side, the close-through level that would turn the trend again and the stop the rule implies. The anchor of the new trend (its lowest low or highest high) is where its angles start.")

scaleInput = input.string(SCALE_SWING, "1×1 Scale", options = [SCALE_SWING, SCALE_ATR, SCALE_MANUAL], group = GRP_ANGLES
  , tooltip = "Gann angles mean nothing until the price per bar of the 1×1 is fixed. Anchor Swing sets it to the anchor swing's own rate, its range divided by its duration, so the 1×1 reaches the far end of that range exactly when as much time has passed as the swing took: Gann's squaring of price with time. ATR at Anchor uses the average true range at the anchor bar times the multiplier. Manual uses a fixed price per bar. The slope on screen still depends on chart zoom; the levels do not.")

atrLenInput  = input.int(14, "ATR Length", minval = 1, inline = "atr", group = GRP_ANGLES)
atrMultInput = input.float(0.5, "Mult", minval = 0.05, step = 0.05, inline = "atr", group = GRP_ANGLES
  , tooltip = "Average true range length and multiplier for the ATR at Anchor scale.")

manualUnitInput = input.float(1.0, "Manual Price per Bar", minval = 0.0000001, group = GRP_ANGLES
  , tooltip = "Price units the 1×1 moves per bar with the Manual scale.")

show21Input = input.bool(true, "2×1 & 1×2", group = GRP_ANGLES
  , tooltip = "The angles either side of the 1×1: two price units per bar and one unit per two bars.")
show41Input = input.bool(false, "4×1 & 1×4", group = GRP_ANGLES
  , tooltip = "The next pair out: four price units per bar and one unit per four bars.")

divInput = input.string(DIV_KEY, "Divisions", options = [DIV_KEY, DIV_EIGHTHS, DIV_BOTH], group = GRP_DIV
  , tooltip = "Fractions of the anchor swing's range drawn as horizontal levels. Gann divided ranges into eighths and thirds and gave the 50% point the most weight; Key keeps the quarters, thirds and half.")

showDivInput = input.bool(true, "Show Divisions", group = GRP_DIV
  , tooltip = "Draw the range divisions across from the anchor.")

showSquareInput = input.bool(true, "Show Price-Time Square", group = GRP_TIME
  , tooltip = "Mark the bar where the time elapsed since the anchor equals the anchor swing's duration, where its 1×1 under the Anchor Swing scale meets the far end of the range. Gann watched such squares for turns; there is no rigorous evidence that they predict one, so read the mark as a time reference that still needs price to confirm.")

countsInput = input.string("90, 180, 360", "Calendar Day Counts", group = GRP_TIME
  , tooltip = "Calendar-day counts from the anchor, comma separated, marked on the first bar that reaches each one. Gann counted 90, 180 and 360 days (and anniversaries) from major highs and lows as times to watch; like the square, they are references for price to confirm, not forecasts. Leave empty to hide.")

showDashInput = input.bool(true, "Show Dashboard", group = GRP_DASH
  , tooltip = "Swing trend, the anchor, the 1×1 scale, where price sits against the 1×1 and the divisions, and the bars left to the price-time square.")

dashPosInput = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], inline = "dash", group = GRP_DASH)
dashSizeInput = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], inline = "dash", group = GRP_DASH
  , tooltip = "Dashboard position and text size.")

bullColorInput   = input.color(BULL_COLOR, "Up", inline = "dir", group = GRP_STYLE)
bearColorInput   = input.color(BEAR_COLOR, "Down", inline = "dir", group = GRP_STYLE
  , tooltip = "Colors of rising angles and up trends, falling angles and down trends.")
swingColorInput  = input.color(SWING_COLOR, "Swing & Divisions", inline = "ref", group = GRP_STYLE)
midColorInput    = input.color(MID_COLOR, "50%", inline = "ref", group = GRP_STYLE)
squareColorInput = input.color(SQUARE_COLOR, "Square", inline = "ref", group = GRP_STYLE
  , tooltip = "Colors of the swing line and divisions, of the 50% division and of the price-time square.")

//---------------------------------------------------------------------------------------------------------------------}
// Variables
//---------------------------------------------------------------------------------------------------------------------{
//Confirmed swing pivots, newest last
var array<float> pivPrice = array.new_float()
var array<int>   pivBar   = array.new_int()
var array<int>   pivType  = array.new_int()
var array<line>  swingLines = array.new<line>()

//Swing chart state
var int   swingDir = 0
var int   upCount  = 0
var int   dnCount  = 0
var float legHigh  = na
var int   legHighBar = na
var float legLow   = na
var int   legLowBar  = na
var float lowAfterHigh    = na
var int   lowAfterHighBar = na
var float highAfterLow    = na
var int   highAfterLowBar = na

//Trend and anchors
var int   trend       = 0
var float extHigh     = na
var int   extHighBar  = na
var float extLow      = na
var int   extLowBar   = na
var float anchorPrice = na
var int   anchorBar   = na
var float refPrice    = na
var int   refBar      = na
var float unit        = na
var int   anchorTime  = na

//calendar-day counts from the anchor: days and the bar that reached each, na until reached
var array<int> countDays = array.new_int()
var array<int> countBars = array.new_int()
if barstate.isfirst
    for part in str.split(countsInput, ",")
        float d = str.tonumber(str.trim(part))
        if not na(d) and d > 0
            countDays.push(int(d))
            countBars.push(na)

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
//Last confirmed pivot of a type: [price, bar]
lastPivot(int typ) =>
    float p = na
    int   b = na
    int   n = pivType.size()
    if n > 0
        for i = n - 1 to 0
            if pivType.get(i) == typ
                p := pivPrice.get(i)
                b := pivBar.get(i)
                break
    [p, b]

//Records a confirmed swing pivot and draws the swing leg into it
addPivot(float p, int b, int typ) =>
    if pivPrice.size() > 0 and showSwingsInput
        swingLines.push(line.new(pivBar.last(), pivPrice.last(), b, p, color = color.new(swingColorInput, 15), width = 1))
        if swingLines.size() > MAX_PIVOTS
            line.delete(swingLines.shift())
    pivPrice.push(p)
    pivBar.push(b)
    pivType.push(typ)
    if pivPrice.size() > MAX_PIVOTS
        pivPrice.shift()
        pivBar.shift()
        pivType.shift()

fracName(float f) =>
    switch f
        0.125 => "1/8"
        0.25  => "1/4"
        0.375 => "3/8"
        0.5   => "1/2"
        0.625 => "5/8"
        0.75  => "3/4"
        0.875 => "7/8"
        => math.abs(f - 1.0 / 3) < 0.001 ? "1/3" : math.abs(f - 2.0 / 3) < 0.001 ? "2/3" : str.tostring(f, "0.###")

//---------------------------------------------------------------------------------------------------------------------}
// Swing Chart
//---------------------------------------------------------------------------------------------------------------------{
float atrValue = ta.atr(atrLenInput)

bool insideBar = bar_index > 0 and high <= high[1] and low >= low[1]
if bar_index > 0 and not insideBar
    upCount := high > high[1] ? upCount + 1 : 0
    dnCount := low < low[1] ? dnCount + 1 : 0

//running extremes of the current leg and of the counter move after them
if na(legHigh) or high > legHigh
    legHigh         := high
    legHighBar      := bar_index
    lowAfterHigh    := low
    lowAfterHighBar := bar_index
else if low < lowAfterHigh
    lowAfterHigh    := low
    lowAfterHighBar := bar_index
if na(legLow) or low < legLow
    legLow          := low
    legLowBar       := bar_index
    highAfterLow    := high
    highAfterLowBar := bar_index
else if high > highAfterLow
    highAfterLow    := high
    highAfterLowBar := bar_index

bool swingTop    = false
bool swingBottom = false

if swingDir >= 0 and dnCount >= swingBarsInput and legHighBar < bar_index
    //the up swing ends at its highest high; the down swing starts from the lows printed since
    if swingDir == 1
        addPivot(legHigh, legHighBar, 1)
        swingTop := true
    swingDir        := -1
    legLow          := lowAfterHigh
    legLowBar       := lowAfterHighBar
    highAfterLow    := high
    highAfterLowBar := bar_index
    upCount         := 0
else if swingDir <= 0 and upCount >= swingBarsInput and legLowBar < bar_index
    if swingDir == -1
        addPivot(legLow, legLowBar, -1)
        swingBottom := true
    swingDir        := 1
    legHigh         := highAfterLow
    legHighBar      := highAfterLowBar
    lowAfterHigh    := low
    lowAfterHighBar := bar_index
    dnCount         := 0

//---------------------------------------------------------------------------------------------------------------------}
// Trend Rule & Anchors
//---------------------------------------------------------------------------------------------------------------------{
[lastTop, lastTopBar] = lastPivot(1)
[lastBot, lastBotBar] = lastPivot(-1)

//extremes since the last trend change, the candidates for the next anchor
if na(extHigh) or high > extHigh
    extHigh    := high
    extHighBar := bar_index
if na(extLow) or low < extLow
    extLow    := low
    extLowBar := bar_index

bool trendUp   = false
bool trendDown = false

if trend <= 0 and not na(lastTop) and close > lastTop
    trendUp := true
else if trend >= 0 and not na(lastBot) and close < lastBot
    trendDown := true

if trendUp or trendDown
    //the new trend starts from the lowest low (or highest high) printed since the last change
    refPrice    := anchorPrice
    refBar      := anchorBar
    anchorPrice := trendUp ? extLow : extHigh
    anchorBar   := trendUp ? extLowBar : extHighBar
    anchorTime  := time[bar_index - anchorBar]
    //counts restart from the new anchor; any already reached since it are found here
    if countDays.size() > 0
        for i = 0 to countDays.size() - 1
            countBars.set(i, na)
            int target = anchorTime + countDays.get(i) * 86400000
            for j = bar_index - anchorBar to 0
                if time[j] >= target
                    countBars.set(i, bar_index - j)
                    break
    trend       := trendUp ? 1 : -1
    //restart the opposite extreme from the new anchor
    if trendUp
        float hh = high
        int   hb = bar_index
        for i = 0 to bar_index - anchorBar
            if high[i] > hh
                hh := high[i]
                hb := bar_index - i
        extHigh    := hh
        extHighBar := hb
        extLow     := low
        extLowBar  := bar_index
    else
        float ll = low
        int   lb = bar_index
        for i = 0 to bar_index - anchorBar
            if low[i] < ll
                ll := low[i]
                lb := bar_index - i
        extLow     := ll
        extLowBar  := lb
        extHigh    := high
        extHighBar := bar_index
    //1×1 scale, fixed at the anchor
    float rangeSize = na(refPrice) ? na : math.abs(anchorPrice - refPrice)
    int   rangeBars = na(refBar) ? na : math.abs(anchorBar - refBar)
    unit := switch scaleInput
        SCALE_SWING  => not na(rangeSize) and rangeBars > 0 ? rangeSize / rangeBars : atrValue[bar_index - anchorBar] * atrMultInput
        SCALE_ATR    => atrValue[bar_index - anchorBar] * atrMultInput
        => manualUnitInput

bool  ready     = not na(anchorPrice) and not na(refPrice) and not na(unit) and unit > 0
int   dirSign   = trend
float rangeSz   = ready ? math.abs(anchorPrice - refPrice) : na
int   rangeBars = ready ? math.abs(anchorBar - refBar) : na
int   squareBar = ready ? anchorBar + rangeBars : na
float level11   = ready ? anchorPrice + dirSign * unit * (bar_index - anchorBar) : na

//crossings of the 1×1 and the 50% division while the anchor holds
bool stable  = ready and anchorBar == anchorBar[1] and not na(level11[1])
bool cross11 = stable and ((close > level11 and close[1] <= level11[1]) or (close < level11 and close[1] >= level11[1]))
float mid    = ready ? math.avg(anchorPrice, refPrice) : na
bool crossMid = stable and ((close > mid and close[1] <= mid) or (close < mid and close[1] >= mid))
bool squareHit = ready and bar_index == squareBar

//a calendar count reached on this bar
bool countHit = false
if ready and countDays.size() > 0
    for i = 0 to countDays.size() - 1
        if na(countBars.get(i)) and time >= anchorTime + countDays.get(i) * 86400000
            countBars.set(i, bar_index)
            countHit := true

//trend change labels and the stop each implies
if showTrendInput and (trendUp or trendDown)
    label.new(bar_index, trendUp ? low - 0.5 * atrValue : high + 0.5 * atrValue, trendUp ? "Trend ▲" : "Trend ▼", color = trendUp ? bullColorInput : bearColorInput
      , style = trendUp ? label.style_label_up : label.style_label_down, textcolor = color.white, size = size.small
      , tooltip = trendUp ? "Close above the last swing top " + str.tostring(lastTop, format.mintick) + ". The swing rule's stop sits below the last swing bottom " + str.tostring(lastBot, format.mintick) + "." : "Close below the last swing bottom " + str.tostring(lastBot, format.mintick) + ". The swing rule's stop sits above the last swing top " + str.tostring(lastTop, format.mintick) + ".")

//the level whose close-through would turn the swing trend: the last swing bottom in an up trend, the last swing top in a down trend
float flipLevel = trendUp or trendDown ? na : trend == 1 ? lastBot : trend == -1 ? lastTop : na
plot(showTrendInput ? flipLevel : na, "Swing Trend Stop", trend == 1 ? color.new(bullColorInput, 45) : color.new(bearColorInput, 45), 1, plot.style_steplinebr)

//---------------------------------------------------------------------------------------------------------------------}
// Drawing
//---------------------------------------------------------------------------------------------------------------------{
var array<line>  geoLines  = array.new<line>()
var array<label> geoLabels = array.new<label>()
var line  legLine     = na
var label anchorMark  = na

buildFractions() =>
    switch divInput
        DIV_EIGHTHS => array.from(0.125, 0.25, 0.375, 0.5, 0.625, 0.75, 0.875)
        DIV_BOTH    => array.from(0.125, 0.25, 1.0 / 3, 0.375, 0.5, 0.625, 2.0 / 3, 0.75, 0.875)
        => array.from(0.25, 1.0 / 3, 0.5, 2.0 / 3, 0.75)

if barstate.islast
    for l in geoLines
        line.delete(l)
    geoLines.clear()
    for l in geoLabels
        label.delete(l)
    geoLabels.clear()
    if not na(legLine)
        line.delete(legLine)
    if not na(anchorMark)
        label.delete(anchorMark)

    //the swing leg still developing
    if showSwingsInput and pivPrice.size() > 0
        float legEnd    = swingDir == 1 ? legHigh : legLow
        int   legEndBar = swingDir == 1 ? legHighBar : legLowBar
        legLine := line.new(pivBar.last(), pivPrice.last(), legEndBar, legEnd, color = color.new(swingColorInput, 15), style = line.style_dashed)

    if ready
        color fanColor = dirSign == 1 ? bullColorInput : bearColorInput
        int   xEnd     = bar_index + 8
        float lo       = math.min(anchorPrice, refPrice)

        //range divisions from the anchor swing, 50% emphasized
        if showDivInput
            for f in buildFractions()
                float lvl   = lo + f * rangeSz
                bool  isMid = f == 0.5
                color c     = isMid ? midColorInput : color.new(swingColorInput, 25)
                geoLines.push(line.new(math.min(anchorBar, refBar), lvl, xEnd, lvl, color = c, style = isMid ? line.style_dashed : line.style_dotted, width = 1))
                geoLabels.push(label.new(xEnd, lvl, fracName(f) + "  " + str.tostring(lvl, format.mintick), color = COLOR_HIDDEN, style = label.style_label_left, textcolor = c, size = size.small))
            //the range edges
            geoLines.push(line.new(refBar, refPrice, xEnd, refPrice, color = color.new(swingColorInput, 40), style = line.style_dotted))

        //angles from the anchor
        array<float>  ratios = array.from(1.0)
        array<string> names  = array.from("1×1")
        if show21Input
            ratios.push(2.0)
            names.push("2×1")
            ratios.push(0.5)
            names.push("1×2")
        if show41Input
            ratios.push(4.0)
            names.push("4×1")
            ratios.push(0.25)
            names.push("1×4")
        //angles stop a quarter of the range beyond it, so a steep angle never stretches the price scale
        float edge = dirSign == 1 ? math.max(anchorPrice, refPrice) + 0.25 * rangeSz : math.min(anchorPrice, refPrice) - 0.25 * rangeSz
        for [i, r] in ratios
            bool  main = r == 1.0
            int   x2   = xEnd
            float y2   = anchorPrice + dirSign * unit * r * (xEnd - anchorBar)
            if (dirSign == 1 and y2 > edge) or (dirSign == -1 and y2 < edge)
                x2 := anchorBar + int(math.round((edge - anchorPrice) / (dirSign * unit * r)))
                y2 := anchorPrice + dirSign * unit * r * (x2 - anchorBar)
            geoLines.push(line.new(anchorBar, anchorPrice, x2, y2, color = color.new(fanColor, main ? 0 : 35), style = main ? line.style_solid : line.style_dashed, width = main ? 2 : 1))
            geoLabels.push(label.new(x2, y2, names.get(i), color = COLOR_HIDDEN, style = dirSign == 1 ? label.style_label_lower_left : label.style_label_upper_left, textcolor = color.new(fanColor, main ? 0 : 20), size = size.small))

        //price-time square: as many bars after the anchor as the anchor swing took
        if showSquareInput and squareBar <= bar_index + 20
            geoLines.push(line.new(squareBar, math.min(anchorPrice, refPrice), squareBar, math.max(anchorPrice, refPrice), color = squareColorInput, style = line.style_dotted, width = 2))
            geoLabels.push(label.new(squareBar, dirSign == 1 ? math.max(anchorPrice, refPrice) : math.min(anchorPrice, refPrice), "Time = Range", color = COLOR_HIDDEN
              , style = dirSign == 1 ? label.style_label_down : label.style_label_up, textcolor = squareColorInput, size = size.small
              , tooltip = str.tostring(rangeBars) + " bars after the anchor, the duration of the anchor swing. A time reference, not a forecast."))

        //calendar-day counts reached so far
        if countDays.size() > 0
            for i = 0 to countDays.size() - 1
                int cb = countBars.get(i)
                if not na(cb)
                    geoLines.push(line.new(cb, math.min(anchorPrice, refPrice), cb, math.max(anchorPrice, refPrice), color = color.new(squareColorInput, 45), style = line.style_dotted, width = 1))
                    geoLabels.push(label.new(cb, dirSign == 1 ? math.min(anchorPrice, refPrice) : math.max(anchorPrice, refPrice), str.tostring(countDays.get(i)) + "d", color = COLOR_HIDDEN
                      , style = dirSign == 1 ? label.style_label_up : label.style_label_down, textcolor = color.new(squareColorInput, 20), size = size.small
                      , tooltip = str.tostring(countDays.get(i)) + " calendar days after the anchor"))

        anchorMark := label.new(anchorBar, anchorPrice, "", color = fanColor, style = label.style_circle, size = size.tiny, tooltip = "Anchor: the " + (dirSign == 1 ? "lowest low" : "highest high") + " before the trend change")

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
dashPosition = switch dashPosInput
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    => position.top_right

dashTextSize = switch dashSizeInput
    "Tiny"   => size.tiny
    "Normal" => size.normal
    => size.small

var table dashTable = na

dashRow(int row, string name, string value, color valueColor, string tip) =>
    table.cell(dashTable, 0, row, name, text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_left, tooltip = tip)
    table.cell(dashTable, 1, row, value, text_color = valueColor, text_size = dashTextSize, text_halign = text.align_right)

if barstate.islast and showDashInput
    if na(dashTable)
        dashTable := table.new(dashPosition, 2, 7, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)
    string trendText = trend == 1 ? "Up" : trend == -1 ? "Down" : TXT_NA
    color  trendColor = trend == 1 ? bullColorInput : trend == -1 ? bearColorInput : DASH_TEXT
    bool   strong    = ready and (dirSign == 1 ? close >= level11 : close <= level11)
    string vs11Text  = not ready ? TXT_NA : (close >= level11 ? "Above 1×1" : "Below 1×1") + (strong ? ", strong" : ", weak")
    string divText   = TXT_NA
    if ready
        float frac = (close - math.min(anchorPrice, refPrice)) / rangeSz
        float below = na
        float above = na
        for f in array.concat(array.from(0.0, 1.0), buildFractions())
            if f <= frac and (na(below) or f > below)
                below := f
            if f >= frac and (na(above) or f < above)
                above := f
        divText := frac > 1 ? "Above range" : frac < 0 ? "Below range" : (below == 0 ? "0" : below == 1 ? "1" : fracName(below)) + " to " + (above == 1 ? "1" : above == 0 ? "0" : fracName(above))
    string sqText = not ready ? TXT_NA : squareBar > bar_index ? "In " + str.tostring(squareBar - bar_index) + " bars" : squareBar == bar_index ? "This bar" : str.tostring(bar_index - squareBar) + " bars ago"
    string unitSrc = scaleInput == SCALE_SWING ? "swing" : scaleInput == SCALE_ATR ? "ATR" : "manual"
    table.cell(dashTable, 0, 0, "Gann Method", text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 0, str.tostring(swingBarsInput) + "-bar swings", text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_right)
    dashRow(1, "Swing Trend", trendText, trendColor, "Gann's swing rule: up after a close above the last swing top, down after a close below the last swing bottom.")
    dashRow(2, "1×1 per Bar", ready ? str.tostring(unit, format.mintick) + " (" + unitSrc + ")" : TXT_NA, DASH_TEXT, "Price the 1×1 moves per bar from the anchor, and where the scale comes from.")
    dashRow(3, "Price vs 1×1", vs11Text, strong ? trendColor : MID_COLOR, "A trend holding beyond its 1×1 reads as strong in Gann's terms, one that has slipped back through it as weak.")
    dashRow(4, "Division", divText, DASH_TEXT, "The divisions of the anchor swing's range that bracket the close.")
    dashRow(5, "Time = Range", sqText, squareColorInput, "Bars until (or since) the time elapsed from the anchor equals the anchor swing's duration.")
    string nextText = TXT_NA
    if ready and countDays.size() > 0
        for i = 0 to countDays.size() - 1
            if na(countBars.get(i))
                int daysLeft = int(math.ceil((anchorTime + countDays.get(i) * 86400000 - time) / 86400000.0))
                nextText := str.tostring(countDays.get(i)) + "d in " + str.tostring(daysLeft) + " days"
                break
    dashRow(6, "Next Count", nextText, color.new(squareColorInput, 20), "The next calendar-day count from the anchor not yet reached, in calendar days.")

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(swingTop, "Swing Top Confirmed", "Gann Method on {{ticker}}: the swing chart turned down, confirming a swing top")
alertcondition(swingBottom, "Swing Bottom Confirmed", "Gann Method on {{ticker}}: the swing chart turned up, confirming a swing bottom")
alertcondition(trendUp, "Swing Trend Up", "Gann Method on {{ticker}}: close above the last swing top, the swing trend turned up")
alertcondition(trendDown, "Swing Trend Down", "Gann Method on {{ticker}}: close below the last swing bottom, the swing trend turned down")
alertcondition(cross11, "1×1 Crossed", "Gann Method on {{ticker}}: price closed through the 1×1 angle from the anchor")
alertcondition(crossMid, "50% Division Crossed", "Gann Method on {{ticker}}: price closed through the 50% division of the anchor swing")
alertcondition(countHit, "Calendar Count Reached", "Gann Method on {{ticker}}: a calendar-day count from the anchor was reached")
alertcondition(squareHit, "Time = Range", "Gann Method on {{ticker}}: the time since the anchor now equals the anchor swing's duration")

//---------------------------------------------------------------------------------------------------------------------}
