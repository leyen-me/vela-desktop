{
  "name": "vela-desktop",
  "version": "1.0.0",
  "description": "Local-first trading workstation: Electron shell, Vela charting client, Longbridge data service and AI backtest core",
  "main": "apps/desktop/dist/main.js",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "pnpm run build:desktop && electron .",
    "dev": "pnpm run build:desktop && electron . --remote-debugging-port=9222",
    "build:vela": "pnpm --filter @luxalgo/vela build",
    "build:web": "vite build apps/web --outDir dist",
    "build": "pnpm run build:core && pnpm run build:vela && pnpm run build:web && pnpm run build:desktop",
    "capture": "pnpm run build:desktop && CAPTURE=1 electron .",
    "api": "node --experimental-strip-types apps/web/api-server.ts",
    "web": "vite apps/web",
    "demo": "node --experimental-strip-types apps/web/api-server.ts & vite apps/web",
    "scrape:indicators": "node tools/scrape-indicators.js",
    "build:core": "pnpm --filter @vela/trading-core build",
    "test:core": "pnpm --filter @vela/trading-core test",
    "test:vela": "pnpm --filter @luxalgo/vela test",
    "test:web": "node --experimental-strip-types --test apps/web/test/*.test.ts",
    "test": "pnpm run test:core && pnpm run test:vela && pnpm run test:web",
    "lint:vela": "pnpm --filter @luxalgo/vela lint",
    "typecheck:core": "pnpm --filter @vela/trading-core typecheck",
    "typecheck:vela": "pnpm --filter @luxalgo/vela typecheck",
    "typecheck:web": "tsc -p apps/web/tsconfig.json",
    "typecheck": "pnpm run typecheck:core && pnpm run typecheck:vela && pnpm run typecheck:web && pnpm run typecheck:server",
    "lint": "eslint apps",
    "format": "prettier --write \"apps/**/*.{js,mjs,ts,json,html}\"",
    "format:check": "prettier --check \"apps/**/*.{js,mjs,ts,json,html}\"",
    "build:desktop": "tsup apps/desktop/main.ts --format cjs --platform node --target node20 --out-dir apps/desktop/dist --clean --external electron",
    "typecheck:server": "tsc -p apps/web/tsconfig.server.json"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^33.0.0",
    "eslint": "^9.39.5",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.2",
    "@lezer/highlight": "^1.2.5",
    "@luxalgo/vela": "workspace:*",
    "@luxalgo/vela-pinets": "^0.2.16",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vela/trading-core": "workspace:*",
    "codemirror": "^6.0.2",
    "longport": "^4.3.7",
    "pinets": "^0.11.1",
    "sql.js": "^1.15.0",
    "zod": "4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@luxalgo/vela"
    ]
  }
}
