{
  "name": "vela-desktop",
  "version": "1.0.0",
  "description": "Electron wrapper for https://vela.luxalgo.com + LuxAlgo indicator scraper",
  "main": "app/main.js",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --remote-debugging-port=9222",
    "build:vela": "pnpm --filter @luxalgo/vela build",
    "build:web": "vite build demo --outDir dist",
    "build": "pnpm run build:vela && pnpm run build:web",
    "capture": "CAPTURE=1 electron .",
    "api": "node demo/api-server.mjs",
    "web": "vite demo",
    "demo": "node demo/api-server.mjs & vite demo",
    "scrape:indicators": "node tools/scrape-indicators.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@luxalgo/vela": "workspace:*",
    "@luxalgo/vela-pinets": "^0.2.16",
    "longport": "^4.3.7",
    "pinets": "^0.11.1",
    "sql.js": "^1.15.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@luxalgo/vela"
    ]
  }
}
