{
  "name": "vela-desktop",
  "version": "1.0.0",
  "description": "Electron wrapper for https://vela.luxalgo.com + LuxAlgo indicator scraper",
  "main": "app/main.js",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --remote-debugging-port=9222",
    "build:vela": "pnpm --filter @luxalgo/vela build",
    "build:web": "vite build demo --outDir dist",
    "build": "pnpm run build:core && pnpm run build:vela && pnpm run build:web",
    "capture": "CAPTURE=1 electron .",
    "api": "node demo/api-server.mjs",
    "web": "vite demo",
    "demo": "node demo/api-server.mjs & vite demo",
    "scrape:indicators": "node tools/scrape-indicators.js",
    "build:core": "pnpm --filter @vela/trading-core build",
    "test:core": "pnpm --filter @vela/trading-core test",
    "typecheck:core": "pnpm --filter @vela/trading-core typecheck",
    "typecheck:demo": "tsc -p demo/tsconfig.json",
    "typecheck": "pnpm run typecheck:core && pnpm run typecheck:demo"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^33.0.0",
    "playwright-core": "^1.64.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@luxalgo/vela": "workspace:*",
    "@luxalgo/vela-pinets": "^0.2.16",
    "@vela/trading-core": "workspace:*",
    "codemirror": "^6.0.2",
    "longport": "^4.3.7",
    "pinets": "^0.11.1",
    "sql.js": "^1.15.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@luxalgo/vela"
    ]
  }
}
