# Copy to .env and fill in your own values. Never commit .env.

# --- Local services ---
# Port used by the API service and the Electron window (default: 5174)
API_PORT=5174
# Bind address for the API service (use 0.0.0.0 inside Docker)
# HOST=127.0.0.1
# Node binary Electron should use to spawn the API service (optional)
# VELA_NODE=/opt/homebrew/bin/node

# --- Longbridge OpenAPI ---
LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
LONGPORT_ACCESS_TOKEN=
LONGPORT_HTTP_URL=https://openapi.longportapp.com
LONGPORT_QUOTE_WS_URL=wss://openapi-quote.longportapp.com/v2
LONGPORT_TRADE_WS_URL=wss://openapi-trade.longportapp.com/v2
LONGPORT_PUSH_CANDLESTICK_MODE=realtime

# --- AI agent (DeepSeek Harness SDK) ---
DEEPSEEK_API_KEY=
# Legacy OpenAI-compatible endpoint knobs; dsh reads the key above.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# dsh provider route, model and reasoning effort
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
DSH_REASONING_EFFORT=low
# Backtests can run with thinking off (off|low|high|max) to make temperature=0 effective
DSH_BACKTEST_REASONING_EFFORT=low
# Per-turn bounds (ms)
DSH_INIT_TIMEOUT_MS=60000
DSH_TURN_TIMEOUT_MS=180000
DSH_BACKTEST_TIMEOUT_MS=240000
# Drop idle live sessions from memory (their transcript stays on disk)
DSH_SESSION_IDLE_MS=1800000
# Sampling temperature. Ignored by DeepSeek while thinking is enabled.
DSH_TEMPERATURE=0
# Set false to bypass dsh and reject AI requests
DSH_ENABLED=true
